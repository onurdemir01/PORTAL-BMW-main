{
  "//": "Yalniz ESLint'in tip bilgili kurallari icin (eslint.config.js KURUM_JS_TIPLI). Tip denetimi DEGIL: hata uretmez. strictNullChecks: SonarJS gibi `number | undefined` gorur (kurumsal is #52 S3782).",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*.cjs",
    "src/**/*.cjs",
    "shared/**/*.cjs",
    "scripts/**/*.cjs",
    "server/**/*.mjs",
    "src/**/*.mjs",
    "shared/**/*.mjs",
    "scripts/**/*.mjs"
  ]
}
