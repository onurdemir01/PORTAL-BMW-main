#!/usr/bin/env sh
# Commit mesaji kapisi (docs/KALITE-KAPILARI.md). Ekip Turkce serbest bicim yaziyor; kural bicimi
# degil ICERIGI denetler: anlamli bir konu satiri ve mesajda sir olmamasi (repo public).
set -eu

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  echo "[commit-msg] HATA: commit mesaj dosyasi okunamadi." >&2
  exit 1
fi

subject=$(grep -v '^#' "$msg_file" | head -n 1 | tr -d '\r')
uzunluk=$(printf '%s' "$subject" | wc -m | tr -d ' ')

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) ;;
  *)
    if [ "$uzunluk" -lt 8 ] || [ "$uzunluk" -gt 120 ]; then
      echo "[commit-msg] HATA: konu satiri 8-120 karakter olmali (simdi $uzunluk): '$subject'" >&2
      exit 1
    fi
    ;;
esac

node scripts/sir-tarama.cjs --mesaj "$msg_file"
