# ============================================================================
# BMW Portal - ORNEK env sablonu (.env.example)
# ----------------------------------------------------------------------------
# Yukleme sirasi (server/index.cjs): .env.<APP_ENV> -> .env.local -> .env
# (dotenv ilk yukleneni korur; APP_ENV=<dev|test|qa|prod> disaridan verildiginde
# ilgili .env.<APP_ENV> dosyasi OTORITERDIR — bu ornek dosya APP_ENV'siz fallback'tir.)
# Baslatma: node server/index.cjs <dev|test|qa|prod>   veya   deploy/run.sh <env> start
#
# NOT: Sifre/anahtar alanlari bos birakilmistir — sunucuda elle doldurulur ve
# admin Sistem sekmesi degisiklikleri artik DB'de (portal_env_overrides) saklanir.
# ============================================================================

# --- Server ---
# APP_ENV bu dosyanin ICERIGINDEN DEGIL, DISARIDAN (argv/parametre) gelir — server/index.cjs
# hangi .env.<APP_ENV> dosyasini acacagini bilmek icin APP_ENV'e dosyayi acmadan ONCE ihtiyac
# duyar; bu yuzden buraya statik bir APP_ENV=... yazmak dongusel/olu olurdu (kasitli YOK).
# Dogru kullanim: deploy/run.sh <dev|test|qa|prod> start  veya
#                 NODE_ENV=production node server/index.cjs <dev|test|qa|prod>
# Kurumsal nginx 443 -> 127.0.0.1:3000 proxy'ler (BMW_Portal-D.conf). Node prod
# modda dist/ statik + /api ayni porttan servis eder. Ortamlar ayni hostta
# karsilikli munhasirdir (deploy/run.sh tek seferde tek ortam calistirir).
PORT=3000
NODE_ENV=production
API_RATE_LIMIT_PER_MIN=300

# --- Session ---
# MSSQL session store VARSAYILANDIR (portal_sessions) — restart'ta logout olmaz.
# Yalniz test icin SESSION_STORE=memory verilebilir.
SESSION_STORE=mssql
SESSION_SECRET=

# --- Admin panel env override sifreleme (portal_env_overrides) ---
# ANTHROPIC_API_KEY/OPENAI_API_KEY gibi ..._KEY/..._SECRET/..._TOKEN/..._PASSWORD
# desenine uyan anahtarlar, admin Sistem sekmesinden kaydedildiginde DB'de bu anahtarla
# AES-256-GCM sifrelenir (bkz. server/db/env-overrides.cjs). 32 byte, hex (64 karakter)
# veya base64 olarak verilir, orn: openssl rand -hex 32. BOS birakilirsa (yalniz
# dev/test icin kabul edilebilir) bu anahtarlar DB'de DUZ METIN saklanir.
ENV_OVERRIDES_ENCRYPTION_KEY=

# --- Guvenilir ic-servis header auth (OPSIYONEL — varsayilan KAPALI, bos birakin) ---
# Yalniz servis-servis entegrasyonlari icin. PORTAL_TRUSTED_HEADER_SECRET bossa bu
# mekanizma tumden devre disidir. Set edilirse, x-portal-auth-secret header'i bu degerle
# eslesen istekler x-portal-user/x-portal-role ile oturumsuz kimliklenebilir — bu yuzden
# PORTAL_TRUSTED_HEADER_ALLOWED_USERS ile (virgullu) hangi kullanici adlarina izin
# verildigini de MUTLAKA sinirlayin.
PORTAL_TRUSTED_HEADER_SECRET=
PORTAL_TRUSTED_HEADER_ALLOWED_USERS=

# --- Local fallback kullanicilar (LDAP erisilemezse) ---
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASS=
LOCAL_USER=user
LOCAL_USER_PASS=

# --- Portal DB (tum portal tablolari BURADA yasar) ---
# ONEMLI: PORTAL_DB_DATABASE acikca TBMWANS — bos birakilirsa MSSQL_DATABASE'e
# duser ve tablolar yanlis DB'de olusur.
PORTAL_DB_SERVER=DB_HOST
PORTAL_DB_PORT=1453
PORTAL_DB_DATABASE=TBMWANS  # portal tablolarinin yasadigi DB — ACIKCA yazin
PORTAL_DB_USER=DB_USER
PORTAL_DB_PASSWORD=
PORTAL_DB_POOL_MIN=2
PORTAL_DB_POOL_MAX=25

# --- MSSQL (Envanter) ---
MSSQL_SERVER=DB_HOST
MSSQL_PORT=1453
MSSQL_DATABASE=TBMWANS
MSSQL_USER=DB_USER
MSSQL_PASSWORD=

# Kurumsal uygulama envanteri tablosu (sutunlar: app, host, env).
# LogX Legacy uygulama aramasi ve AI Analist host araclari bu tabloyu okur.
# Kurumsal tarafta ad degisirse Admin > Sistem ekranindan da guncellenebilir
# (yeniden deploy gerekmez). Bos birakilirsa varsayilan: MWAppsInventory
LOGX_APPS_TABLE=MWAppsInventory

# --- OpsX (Guvenli Uygulama Operasyonlari) ---
# HANGI AWX TEMPLATE'I: Admin > Playbook Kayitlari ekranindan yonetilir
# (opsx_legacy_operation / opsx_openshift_operation / opsx_legacy_dump / opsx_openshift_dump
# satirlari) — LogX ile ayni desen. Asagidaki env degiskenleri yalnizca o satirlarda
# Template ID bos ise YEDEK olarak okunur.
OPSX_LEGACY_TEMPLATE_ID=
OPSX_OPENSHIFT_TEMPLATE_ID=
# Playbook Kayitlari satirinda AWX sunucusu belirtilmemisse kullanilan yedek deger
# (ansible_awx_servers.server_no). Bos = 0 (ilk/varsayilan sunucu).
OPSX_AWX_SERVER_ID=
#
# JOB'A GIDEN PARAMETRE ADLARI: server/opsx/config.cjs'te tanimli — bunu duzenleyen
# ayri bir admin ekrani ARTIK YOK (kaldirildi), degisiklik gerekirse dogrudan kod
# uzerinden yapilir.
#
# Thread/Heap Dump — restart/stop/start'tan AYRI template'ler (dosya uretip indirtir,
# bkz. server/opsx/downloads.cjs). Legacy playbook bu repo'da (server/ansible/playbooks/
# opsx_legacy_dump.yml); Openshift playbook'lari (bmw_portal/opsx_openshift_dump/
# opsx_openshift_dump.yaml + opsx_openshift_pods.yaml, get_dump.yaml referans alinarak
# yazildi) HARICI bir AWX SCM projesinde.
OPSX_LEGACY_DUMP_TEMPLATE_ID=
OPSX_OPENSHIFT_DUMP_TEMPLATE_ID=
# Pod kesfi: dump sihirbazi kullaniciya pod sectirmek icin ANLIK tetikler (pod adlari
# efemeraldir, envanterde tutulamaz).
OPSX_OPENSHIFT_PODS_TEMPLATE_ID=
# JVM kesfi (Legacy): ayni uygulamaya ait bir host'ta birden fazla JVM olabilir - dump
# sihirbazi kullaniciya hangi JVM'den (PID) dump alinacagini sectirmek icin ANLIK tetikler
# (server/ansible/playbooks/opsx_legacy_jvm_discover.yml).
OPSX_LEGACY_JVM_DISCOVER_TEMPLATE_ID=
# Dump dosyalarinin biraktigi, portalin okuyabildigi paylasilan dizin — HEM Legacy HEM
# Openshift kullanir (ikisi de dosyayi buraya kopyalar: Legacy dogrudan hedef host'tan,
# Openshift `oc rsync` ile pod'dan cektikten sonra). Hedef JBoss host'larinda VE
# opsx_get_dump.yaml'in calistigi host'ta da mount'lu olmasi beklenir (LogX'in staging
# dizinlerinden BAGIMSIZ, karisikligi onlemek icin).
OPSX_DUMP_STAGING_DIR=/sw/BMW_PORTAL/opsx/dumps

# --- LDAP / LDAPS ---
LDAP_ENABLED=true
LDAP_URL=ldaps://ldap.example.corp:636
LDAP_BASE_DN=DC=example,DC=corp
LDAP_BIND_DN=CN=svc_bind,OU=Service Users,DC=example,DC=corp
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=sAMAccountName
AUTH_LDAP_SEARCH_ATTR=sAMAccountName
LDAP_GROUP_ADMIN_DN=
LDAP_CA_CERT_PATH=server/certs/ldap/ca-chain.pem
LDAP_REJECT_UNAUTHORIZED=true

# --- Ansible AWX (AWX_1..AWX_9) ---
# Ilk boot'ta bu kayitlar ansible_awx_servers tablosuna tasinir; sonrasi DB
# oncelikli okunur (bos sifre alanlari icin env fallback surer).
AWX_1_NAME=AWX 1
AWX_1_URL=https://awx1.example.corp/
AWX_1_USER=
AWX_1_PASSWORD=

AWX_2_NAME=AWX 2
AWX_2_URL=https://awx2.example.corp/
AWX_2_USER=
AWX_2_PASSWORD=

# Legacy tek-AWX fallback
AWX_URL=https://awx2.example.corp/
AWX_USER=
AWX_PASSWORD=

# --- LogX v2 ---
AWX_LOGX_SERVER_ID=1
AWX_LOGX_LEGACY_DISCOVERY_TEMPLATE_ID=
AWX_LOGX_LEGACY_TRANSFER_TEMPLATE_ID=
AWX_LOGX_OCP_NAMESPACE_DISCOVERY_TEMPLATE_ID=
AWX_LOGX_OCP_DISCOVER_FETCH_TEMPLATE_ID=
LOGX_V2_STAGING_LEGACY_DIR=/sw/BMW_PORTAL/logs/legacy
LOGX_V2_STAGING_OCP_DIR=/sw/BMW_PORTAL/logs/ocp
LOGX_STAGING_FALLBACK_DIR=/tmp/logx-v2-fallback

# --- Nobetci API ---
NOBETCI_TEAM_ID=
NOBETCI_TEAM_TYPE=CUSTOM
NOBETCI_TEAM_NAME=
NOBETCI_API_URL=https://nobetci.example.corp/api/nobetkayit/list/TEAM_ID/CUSTOM

# --- Dynatrace Managed MCP ---
DT_MANAGED_MCP_URL=https://dynatrace-mcp.example.corp/mcp
DT_DEFAULT_ENV_ALIAS=

# --- Instana MCP ---
INSTANA_MCP_URL=https://instana-mcp.example.corp/mcp
INSTANA_API_TOKEN_NONPROD=
INSTANA_BASE_URL_NONPROD=https://instana-nonprod.example.corp
INSTANA_API_TOKEN_PROD=
INSTANA_BASE_URL_PROD=https://instana-prod.example.corp

# --- TLS ---
CORP_CA_CERT_PATH=server/certs/openai/combined-ca-chain.pem

# --- AI Log Analizi ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Smart / RFF (kurum ici talep yonetim sistemi entegrasyonu) ---
# Bkz. server/smart/config.cjs. Bos birakilirsa Smart onayi gerektiren Self Service
# item'lari (FieldOverridesModal.tsx > "Smart Onayi Gerekli") "yapilandirilmamis"
# hatasi doner, sessizce yanlis calismaz.
# Path'ler SOS02-KL-001-EN resmi dokumanina gore DOGRULANDI (ortam host'lari: Test
# gbcalt01.fw.garanti.com.tr | QA gbcadq01.fw.garanti.com.tr | Prod gbca.fw.garanti.com.tr,
# hepsi :8443).
SMART_API_URL=https://gbca.fw.garanti.com.tr:8443
SMART_API_USERNAME=
SMART_API_PASSWORD=
SMART_RFF_TOKEN=
SMART_DOMAIN=GARANTI
SMART_CREATE_TICKET_PATH=/smart/internal/requestfulfilment/createoperationalrequest/v1
SMART_GET_METADATA_PATH=/smart/internal/getmetadataoperationalrequestbyflowname/v1
# SOS02-KL-001-EN'de yok ama 2026-08-14'te kullanici resmi ucu buldu: SMART_API_URL
# uzerinde, talep acma ile AYNI Basic Auth + RFF-Request-Token. Kod-ici varsayilani
# zaten dogru path'i iceriyor, elle doldurmaniza normalde gerek yok.
SMART_CHECK_TICKET_PATH=
SMART_POLL_INTERVAL_SECONDS=30
# Bu sure icinde onaylanmayan talep TIMEOUT olarak isaretlenip iptal edilir;
# otomasyon asla tetiklenmez. Bos/gecersiz ise 15 dakika kullanilir.
SMART_TICKET_TIMEOUT_MINUTES=15
# Opsiyonel, sadece Smart trafigi icin proxy (global HTTPS_PROXY'den bagimsiz).
SMART_PROXY_URL=

# ── Uzun-Suredir-Calisan Ansible Job Bildirimi (opsiyonel) ─────────────────────────────
# Bos birakilirsa ozellik tamamen kapali. Belirli sureden uzun calisan (status=running)
# AWX job'lari icin Teams/Power Automate webhook'una bildirim gonderir.
TEAMS_LONGJOB_WEBHOOK_URL=
TEAMS_LONGJOB_THRESHOLD_MINUTES=30
TEAMS_LONGJOB_POLL_INTERVAL_SECONDS=300

# ── Veritabani Tam Yedekleme (gunluk, TUM tablolar) ────────────────────────────────────
# TBMWANS'taki her tabloyu ayri bir CSV'ye yedekler (INFORMATION_SCHEMA.TABLES ile OTOMATIK
# kesif) - Portal sunucusunun /sw/WAS_IMAGES/... yoluna DOGRUDAN yazma erisimi oldugu icin
# Ansible/AWX GEREKMEZ, bkz. server/db/full-backup.cjs.
DB_FULL_BACKUP_DIR=/sw/WAS_IMAGES/Ansible/Middleware_Inventory/backup/daily_full
DB_FULL_BACKUP_RETENTION_DAYS=14
DB_FULL_BACKUP_HOUR=2
DB_FULL_BACKUP_CHECK_INTERVAL_MINUTES=15

# ── ScaleX — OCP replica durdurma / geri alma / olcekleme ────────────────────
# HANGI AWX TEMPLATE'I: Admin > Playbook Kayitlari ekranindan yonetilir
# (scalex_run / scalex_discovery satirlari) — LogX/OpsX ile ayni desen. Asagidaki
# degiskenler yalnizca o satirlarda Template ID bos ise YEDEK olarak okunur.
SCALEX_TEMPLATE_ID=
SCALEX_DISCOVERY_TEMPLATE_ID=
# Playbook Kayitlari satirinda AWX sunucusu belirtilmemisse kullanilan yedek deger
# (ansible_awx_servers.server_no). Bos = 1.
SCALEX_AWX_SERVER_ID=
#
# SMART ONAYI / OCO KONTROLU ICIN ENV DEGISKENI YOKTUR — bilerek.
# Ayarlar `ansible_ss_customizations` tablosunda ScaleX'in kendi (awx_server_id,
# template_id) satirinda durur ve Admin > Ansible ekranindaki FieldOverridesModal ile
# yonetilir (Self Service'teki nginx isleriyle AYNI yer). Ikinci bir ayar yuzeyi
# olusturmamak icin env degiskeni EKLENMEMELIDIR.
#
# DIKKAT: SMART onayi yapilandirilmadan prod'da `apply` calistirilamaz — sunucu
# `smart_not_configured` ile reddeder (fail-closed). "Once kontrol et" (dry_run) modu
# yapilandirma olmadan da calisir.
