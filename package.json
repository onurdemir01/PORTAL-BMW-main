{
  "name": "bmw-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.cjs",
    "start": "NODE_ENV=production node server/index.cjs",
    "dev:all": "concurrently -n SERVER,WEB -c auto \"npm run server\" \"npm run dev\"",
    "dev:serve": "NODE_ENV=production node server/index.cjs dev",
    "test:all": "NODE_ENV=production node server/index.cjs test",
    "qa": "NODE_ENV=production node server/index.cjs qa",
    "prod": "NODE_ENV=production node server/index.cjs prod",
    "build": "vite build",
    "preview": "vite preview",
    "check:server": "tsc -p tsconfig.server-check.json --noEmit || true",
    "test": "node scripts/run-tests.cjs",
    "lint": "eslint src/ server/",
    "format": "prettier --write .",
    "test:ui": "vitest run",
    "lint:ascii": "node scripts/check-ascii.cjs",
    "prepare": "husky",
    "migrate": "node server/db/migrate.cjs",
    "db:seed": "node server/db/seed.cjs",
    "dev:log": "bash scripts/devlog.sh",
    "dev:log:win": "powershell -ExecutionPolicy Bypass -File scripts\\devlog.ps1",
    "dev:win:log": "powershell -ExecutionPolicy Bypass -File scripts\\devlog.ps1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,cjs,mjs,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-virtual": "^3.14.5",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ldapts": "^8.1.8",
    "mssql": "^12.7.0",
    "nunjucks": "^3.2.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.11.0",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.14.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.0"
  }
}
