{
  "name": "bmw-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "kur": "node scripts/kur.cjs",
    "manifest": "node scripts/manifest.cjs",
    "predev": "node scripts/arac-kontrol.cjs",
    "dev": "vite",
    "server": "node server/index.cjs",
    "start": "NODE_ENV=production node server/index.cjs",
    "dev:all": "concurrently -n SERVER,WEB -c auto \"npm run server\" \"npm run dev\"",
    "dev:serve": "NODE_ENV=production node server/index.cjs dev",
    "test:all": "NODE_ENV=production node server/index.cjs test",
    "qa": "NODE_ENV=production node server/index.cjs qa",
    "prod": "NODE_ENV=production node server/index.cjs prod",
    "prebuild": "node scripts/arac-kontrol.cjs",
    "build": "vite build",
    "paket": "node scripts/paket.cjs",
    "sbom": "node scripts/sbom-uretim.cjs",
    "guvenlik": "node scripts/guvenlik-denetim.cjs",
    "preview": "vite preview",
    "check:server": "node scripts/check-server.cjs",
    "test": "node scripts/run-tests.cjs",
    "prelint": "node scripts/arac-kontrol.cjs",
    "lint": "eslint src/ server/ shared/ scripts/ --max-warnings 0 && node scripts/bicim-kapisi.cjs --tum",
    "format": "prettier --write .",
    "pretest:ui": "node scripts/arac-kontrol.cjs",
    "test:ui": "vitest run",
    "test:coverage": "node scripts/run-tests.cjs --coverage && vitest run --coverage && node scripts/lcov-birlestir.cjs",
    "test:mutation": "node scripts/mutasyon-testi.cjs",
    "kapsam:yayinla": "node scripts/kapsam-yayinla.cjs",
    "kapsam:dogrula": "node scripts/kapsam-yayinla.cjs --dogrula",
    "kapsam:kurumsal": "node scripts/kapsam-yayinla.cjs --kurumsal",
    "kurumsal:derle": "node scripts/kurumsal-derle.cjs",
    "kurumsal:prova": "node scripts/kurumsal-prova.cjs",
    "teslim:yaz": "node scripts/teslim.cjs --yaz",
    "teslim:dogrula": "node scripts/teslim.cjs --dogrula",
    "lint:ascii": "node scripts/check-ascii.cjs",
    "kapi": "node scripts/kapi.cjs",
    "kapi:hizli": "node scripts/kapi.cjs --hizli",
    "kapi:sonar": "node scripts/sonar-kapi.cjs",
    "ui:tarama": "node scripts/ui-tarama/tarama.mjs",
    "fix:ascii": "node scripts/fix-ascii.cjs",
    "preflight": "node scripts/preflight.cjs",
    "prepare": "node scripts/kanca-kur.mjs",
    "migrate": "node server/db/migrate.cjs",
    "db:seed": "node server/db/seed.cjs",
    "dev:log": "bash scripts/devlog.sh",
    "dev:log:win": "powershell -ExecutionPolicy Bypass -File scripts\\devlog.ps1",
    "playbook:rev": "node scripts/playbook-rev.cjs",
    "tls:dene": "node scripts/test-tls.cjs"
  },
  "lint-staged": {
    "{src,server,shared,scripts}/**/*.{ts,tsx,cjs,mjs,js}": [
      "eslint --max-warnings 0 --no-warn-ignored"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/react-virtual": "^3.14.26",
    "compression": "^1.8.1",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "ldapts": "^9.2.0",
    "mssql": "^12.7.14",
    "nunjucks": "^3.2.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.5",
    "semver": "^7.8.6",
    "undici": "^7.30.2"
  },
  "overrides": {
    "compression": {
      "debug": "^4.4.3"
    },
    "express-session": {
      "debug": "^4.4.3"
    }
  }
}
