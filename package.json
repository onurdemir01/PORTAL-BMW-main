{
  "name": "bmw-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "kur": "node scripts/kur.cjs",
    "manifest": "node scripts/manifest.cjs",
    "predev": "node scripts/arac-kontrol.cjs",
    "dev": "vite",
    "server": "node server/index.cjs",
    "start": "NODE_ENV=production node server/index.cjs",
    "dev:all": "concurrently -n SERVER,WEB -c auto \"npm run server\" \"npm run dev\"",
    "dev:serve": "NODE_ENV=production node server/index.cjs dev",
    "test:all": "NODE_ENV=production node server/index.cjs test",
    "qa": "NODE_ENV=production node server/index.cjs qa",
    "prod": "NODE_ENV=production node server/index.cjs prod",
    "prebuild": "node scripts/arac-kontrol.cjs",
    "build": "vite build",
    "paket": "node scripts/paket.cjs",
    "guvenlik": "node scripts/guvenlik-denetim.cjs",
    "preview": "vite preview",
    "check:server": "node scripts/check-server.cjs",
    "test": "node scripts/run-tests.cjs",
    "prelint": "node scripts/arac-kontrol.cjs",
    "lint": "eslint src/ server/ --max-warnings 0",
    "format": "prettier --write .",
    "pretest:ui": "node scripts/arac-kontrol.cjs",
    "test:ui": "vitest run",
    "lint:ascii": "node scripts/check-ascii.cjs",
    "ui:tarama": "node scripts/ui-tarama/tarama.mjs",
    "fix:ascii": "node scripts/fix-ascii.cjs",
    "preflight": "node scripts/preflight.cjs",
    "prepare": "node scripts/kanca-kur.mjs",
    "migrate": "node server/db/migrate.cjs",
    "db:seed": "node server/db/seed.cjs",
    "dev:log": "bash scripts/devlog.sh",
    "dev:log:win": "powershell -ExecutionPolicy Bypass -File scripts\\devlog.ps1",
    "dev:win:log": "powershell -ExecutionPolicy Bypass -File scripts\\devlog.ps1",
    "playbook:rev": "node scripts/playbook-rev.cjs",
    "tls:dene": "node scripts/test-tls.cjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,cjs,mjs,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/react-virtual": "^3.14.26",
    "compression": "^1.8.1",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "ldapts": "^9.2.0",
    "mssql": "^12.7.14",
    "nunjucks": "^3.2.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.5",
    "semver": "^7.8.6",
    "undici": "^7.30.2"
  },
  "overrides": {
    "compression": {
      "debug": "^4.4.3"
    },
    "express-session": {
      "debug": "^4.4.3"
    }
  }
}
