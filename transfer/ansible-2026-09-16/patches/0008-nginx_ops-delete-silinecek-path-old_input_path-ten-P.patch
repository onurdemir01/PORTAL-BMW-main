diff --git a/bmw_nginx/nginx_ops/README.md b/bmw_nginx/nginx_ops/README.md
index 50dc011a3..34141c9f2 100644
--- a/bmw_nginx/nginx_ops/README.md
+++ b/bmw_nginx/nginx_ops/README.md
@@ -51,16 +51,33 @@ adı her zaman `/usr/nginx/conf.d/<SERVICE>-<ENV>.conf` biçimindedir.
 | `app_type` | Multiple Choice | Hayır | `spa` / `proxy` — boş bırakılabilir, aşağıya bakın |
 | `application` | Text | create (SPA) | Uygulama adı |
 | `namespace` | Text | create (SPA) | OpenShift namespace |
-| `input_path` | Text | create | Context path — örn. `/iban-inquiry/` |
+| `input_path` | Text | create | Context path — örn. `/iban-inquiry/` (**tek serbest metin alanı**; Portal'da diğerleri envanterden seçilir, bkz. §2b) |
 | `input_url` | Text | create (prod/proxy) | Endpoint / OCP route |
 | `update_target` | Multiple Choice | Hayır | `path` / `application` / `both` — bkz. §3 |
-| `old_input_path` | Text | update | **Mevcut** context path |
+| `old_input_path` | Text | update / delete | **Mevcut** context path (delete'te yoksa `input_path` okunur) |
 | `new_input_path` | Text | update | **Yeni** context path |
 | `new_application` | Text | update | Yeni uygulama adı (non-prod) |
 | `new_namespace` | Text | update | Yeni namespace (non-prod) |
 | `old_input_url` | Text | update | Mevcut endpoint (prod) |
 | `new_input_url` | Text | update | Yeni endpoint (prod) |
 
+### 2b. Portal'da alanlar envanterden seçilir (2026-09-15)
+
+Portal > Self Servis > *Nginx - RVP Operations* için yönetici, Alan Ayarları'nda alanlara
+**seçenek kaynağı** bağlar (Portal `server/ansible/choice-sources.cjs`):
+
+| Alan | Kaynak | Parametre |
+|---|---|---|
+| `service` | Nginx reverse proxy servisleri (`Nginx_Config_Audit`) | `env` |
+| `namespace`, `new_namespace` | OpenShift namespace'leri (`Openshift_Inventory`, ortam cluster kataloğu) | `env` |
+| `application`, `new_application` | yalnızca SPA uygulamaları (`*-app-v*`, `*-app-emb-v*`) | `env`, `namespace` |
+| `old_input_path` | mevcut location'lar (`Nginx_Config_Audit`) | `env`, `service` (+ns/app daraltma) |
+| `input_path`, `new_input_path` | **serbest metin** | — |
+
+Playbook tarafında değişen tek şey: `delete` silinecek path'i önce `old_input_path`ten,
+yoksa `input_path`ten okur (`spa_facts.yaml` → `spa_path_in`; `prod_delete.yaml` →
+`del_path_in`). Test: `tests/check_nginx_ops_delete_path.py`.
+
 **`app_type` boş bırakılırsa** gönderilen alanlara bakılarak tespit edilir:
 `application` + `namespace` doluysa `spa`; değilse `input_url` doluysa `proxy`; hiçbiri
 yoksa GLOMO → `spa`, diğerleri → `proxy`. Servis adına göre karar **verilmez**.
diff --git a/bmw_nginx/nginx_ops/operations/tasks/non_prod_delete_spa.yaml b/bmw_nginx/nginx_ops/operations/tasks/non_prod_delete_spa.yaml
index 9a70e728c..8a41bb141 100644
--- a/bmw_nginx/nginx_ops/operations/tasks/non_prod_delete_spa.yaml
+++ b/bmw_nginx/nginx_ops/operations/tasks/non_prod_delete_spa.yaml
@@ -11,16 +11,23 @@
 # hangisinin kaldirilacagi baska turlu belirlenemez.
 
 
-- name: --- [Task] Silme icin input_path zorunlu ---
+# SILINECEK PATH (2026-09-15): once `old_input_path` (update ile ayni ad; Portal'da mevcut
+# location listesinden secilir), yoksa eski ad `input_path`. extra_vars set_fact ile
+# ezilemedigi icin AYRI ad (spa_path_in) kullanilir; spa_facts onu okur.
+- name: --- [Task] Silinecek path'i sec (old_input_path > input_path) ---
+  ansible.builtin.set_fact:
+    spa_path_in: "{{ (old_input_path | default('', true) | string | trim) or (input_path | default('', true) | string | trim) }}"
+
+- name: --- [Task] Silme icin path zorunlu ---
   ansible.builtin.assert:
     that:
-      - (input_path | default('') | trim | length) > 0
+      - (spa_path_in | length) > 0
       - (application | default('') | trim | length) > 0
       - (namespace | default('') | trim | length) > 0
     fail_msg: >-
-      Silme icin `application`, `namespace` ve `input_path` ZORUNLUDUR
+      Silme icin `application`, `namespace` ve `old_input_path` (ya da `input_path`) ZORUNLUDUR
       (verilen: application='{{ application | default('') }}',
-      namespace='{{ namespace | default('') }}', input_path='{{ input_path | default('') }}').
+      namespace='{{ namespace | default('') }}', path='{{ spa_path_in }}').
       Bunlardan input_path ozellikle onemli: Bir uygulamanin birden fazla context path
       baglamasi olabilir; hangisinin kaldirilacagi acikca belirtilmelidir. Mevcut
       baglamalari gormek icin ayni servis/uygulama ile "read" talebi acin.
