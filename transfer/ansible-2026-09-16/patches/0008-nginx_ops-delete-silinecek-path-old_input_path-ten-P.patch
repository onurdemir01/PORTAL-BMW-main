diff --git a/bmw_nginx/tests/check_nginx_ops_delete_path.py b/bmw_nginx/tests/check_nginx_ops_delete_path.py
new file mode 100644
index 000000000..4fb1ad77b
--- /dev/null
+++ b/bmw_nginx/tests/check_nginx_ops_delete_path.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""nginx_ops delete: silinecek path `old_input_path`ten (Portal envanter listesi) okunur.
+
+Kullanici istegi (2026-09-15): Self Servis'te serbest metin yalnizca create'teki
+`input_path` olsun; update/delete'te mevcut location listeden secilsin. Delete akisi
+`input_path`i okudugu icin ayni alan create ile paylasiliyordu. Kilitlenen iddialar:
+  1. non-prod ve prod delete: old_input_path > input_path onceligi, AYRI ad (extra_vars
+     set_fact ile ezilemez), bos dizge eski ada duser (default('', true) / or)
+  2. spa_facts: path kaynagi spa_path_in > input_path
+  3. prod delete zamanlamaya cozulmus path'i gecirir (ham input_path degil)
+  4. update: bos old_input_path input_path'e duser (default(..., true))
+"""
+import io, os, re, sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+T = os.path.join(os.path.dirname(HERE), "nginx_ops", "operations", "tasks")
+rd = lambda n: io.open(os.path.join(T, n), encoding="utf-8").read()
+problems = []
+
+PRI = r"\(old_input_path \| default\('', true\) \| string \| trim\) or \(input_path \| default\('', true\) \| string \| trim\)"
+np_ = rd("non_prod_delete_spa.yaml")
+if not re.search(r"spa_path_in: \"\{\{ " + PRI, np_):
+    problems.append("1: non_prod_delete_spa spa_path_in onceligi yok/yanlis")
+if re.search(r"- \(input_path \| default\(''\) \| trim \| length\) > 0", np_):
+    problems.append("1: non-prod delete hala dogrudan input_path'i zorunlu sayiyor")
+pd = rd("prod_delete.yaml")
+if not re.search(r"del_path_in: \"\{\{ " + PRI, pd):
+    problems.append("1: prod_delete del_path_in onceligi yok/yanlis")
+if not re.search(r"\(del_path_in \| length\) > 0", pd):
+    problems.append("1: prod delete zorunluluk del_path_in uzerinden degil")
+sf = rd("spa_facts.yaml")
+if "spa_path_in | default('', true)" not in sf or "or (input_path | default('', true)" not in sf:
+    problems.append("2: spa_facts path kaynagi spa_path_in > input_path degil")
+if 'input_path: "{{ del_path_in }}"' not in pd:
+    problems.append("3: prod delete zamanlamaya cozulmus path yerine ham input_path geciriyor")
+up = rd("update.yaml")
+if not re.search(r"old_path_in: \"\{\{ " + PRI, up):
+    problems.append("4: update old_path_in bos dizgede input_path'e dusmuyor")
+
+if problems:
+    print("HATALAR:"); [print(" -", p) for p in problems]; sys.exit(1)
+print("OK: nginx_ops delete/update path kaynagi old_input_path > input_path")
