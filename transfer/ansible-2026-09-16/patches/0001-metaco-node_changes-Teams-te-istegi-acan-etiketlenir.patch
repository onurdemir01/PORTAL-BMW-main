+{#
+  teams_details.json.j2 — Metaco node degisikligi icin Teams kartinin "Degisiklik detayi"
+  bolumu. body.yml.j2 (mail) ile AYNI operation -> zincir / degisken eslemesi; burada
+  Adaptive Card TextBlock listesi (JSON) uretilir, gorev `| from_json` ile karta ekler.
+
+  MASKELEME: node adreslerindeki sorgu parametreleri (?auth=..., ?apikey=...) ve URL'deki
+  kullanici:parola@ kismi Teams KANALINA acik yazilmaz - ilk 4 karakter + "…". Mail
+  (yalniz istegi acan + ekip adresleri) tam degeri tasimaya devam eder.
+  Kapatmak icin asagidaki mask makrosunu `{{ v }}` dondurecek sekilde degistirin.
+#}
+{%- macro mask(v) -%}
+{{- (v | default('') | string) | regex_replace('(\\?|&)([A-Za-z0-9_\\-]*(auth|key|token|secret|pass|password|sig)[A-Za-z0-9_\\-]*)=([^&\\s]{4})[^&\\s]*', '\\1\\2=\\4…') | regex_replace('://([^:/@\\s]+):([^@/\\s]{2})[^@/\\s]*@', '://\\1:\\2…@') -}}
+{%- endmacro -%}
+{%- set chains = {
+  'metaco_solana_node_change':      ['Solana',                   [['SOLRPC', solrpc_url | default('')], ['SOLWSRPC', solwsrpc_url | default('')]]],
+  'metaco_btc_node_change':         ['Bitcoin-Mainnet',          [['NBXPLORER_BTCNODEENDPOINT', btc_nodeendpoint | default('')], ['NBXPLORER_BTCRPCURL', btcrpc_url | default('')]]],
+  'metaco_ltc_node_change':         ['Litecoin',                 [['NBXPLORER_LTCNODEENDPOINT', ltc_nodeendpoint | default('')], ['NBXPLORER_LTCRPCURL', ltcrpc_url | default('')]]],
+  'metaco_btc_testnet_node_change': ['Bitcoin-Testnet',          [['NBXPLORER_BTCNODEENDPOINT', btc_nodeendpoint_testnet | default('')], ['NBXPLORER_BTCRPCURL', btcrpc_url_testnet | default('')]]],
+  'metaco_eth_node_change':         ['Ethereum',                 [['ETH_INDEXER_NODE_URI', eth_nodeendpoint | default('')]]],
+  'metaco_eth_sepolia_node_change': ['Ethereum-Testnet-Sepolia', [['ETH_INDEXER_NODE_URI', eth_nodeendpoint_sepolia | default('')]]],
+  'metaco_avax_node_change':        ['Avalanche Mainnet',        [['ETH_INDEXER_NODE_URI', avax_nodeendpoint | default('')]]],
+  'metaco_ada_node_change':         ['Cardano Mainnet',          [['OGMIOS', ada_ogmios | default('')]]],
+  'metaco_xrp_node_change':         ['XRP Mainnet',              [['XRP_INDEXER_SERVER_URI', xrp_nodeendpoint | default('')]]],
+  'metaco_dot_node_change':         ['Polkadot Mainnet',         [['SIDECAR_URL', dot_nodeendpoint | default('')], ['SIDECAR_AUTH_VALUE', dot_authkey | default('')]]],
+  'metaco_polygon_node_change':     ['Polygon Mainnet',          [['ETH_INDEXER_NODE_URI', pol_nodeendpoint | default('')]]]
+} -%}
+{%- set op = operation | default('') -%}
+{%- set items = [] -%}
+{%- if op in chains -%}
+{%-   set chain = chains[op][0] -%}
+{%-   set old_lines = (output.stdout_lines | default([])) | select('match', '^[A-Z_]+=') | list -%}
+{%-   set _ = items.append({'type': 'TextBlock', 'text': '**Zincir:** ' ~ chain ~ ' indexer', 'wrap': true, 'spacing': 'Medium'}) -%}
+{%-   set _ = items.append({'type': 'TextBlock', 'text': '**Eski değerler**', 'wrap': true, 'spacing': 'Small'}) -%}
+{%-   if old_lines | length > 0 -%}
+{%-     for line in old_lines -%}
+{%-       set _ = items.append({'type': 'TextBlock', 'text': mask(line), 'wrap': true, 'spacing': 'None', 'fontType': 'Monospace', 'size': 'Small'}) -%}
+{%-     endfor -%}
+{%-   else -%}
+{%-     set _ = items.append({'type': 'TextBlock', 'text': '(okunamadı)', 'wrap': true, 'spacing': 'None', 'isSubtle': true, 'size': 'Small'}) -%}
+{%-   endif -%}
+{%-   set _ = items.append({'type': 'TextBlock', 'text': '**Yeni değerler**', 'wrap': true, 'spacing': 'Small'}) -%}
+{%-   for kv in chains[op][1] -%}
+{%-     set _ = items.append({'type': 'TextBlock', 'text': kv[0] ~ '=' ~ mask(kv[1]), 'wrap': true, 'spacing': 'None', 'fontType': 'Monospace', 'size': 'Small'}) -%}
+{%-   endfor -%}
+{%- else -%}
+{%-   set _ = items.append({'type': 'TextBlock', 'text': 'Bu işlem için ayrıntı şablonu yok: ' ~ op, 'wrap': true, 'isSubtle': true, 'spacing': 'Medium'}) -%}
+{%- endif -%}
+{{ items | to_json }}
