+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""metaco/templates/teams_details.json.j2: Teams karti "Degisiklik detayi" sablonu.
+
+Ansible'a ozgu filtre/testler (to_json, regex_replace, match) burada taklit edilir; sablon
+GERCEKTEN render edilir. Kilitlenen iddialar:
+  1. Solana: zincir adi, eski degerler (output'tan), yeni degerler (survey) - sirali.
+  2. Maskeleme: ?auth=... sorgu parametresi ve user:pass@ Teams'e acik gitmez; host korunur.
+  3. Eski cikti yoksa "(okunamadi)"; bilinmeyen operation acik mesaj (bos kart yok).
+  4. Uretilen JSON gecerli Adaptive Card TextBlock listesi.
+"""
+import io
+import json
+import os
+import re
+import sys
+
+import jinja2
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+TPL = os.path.join(os.path.dirname(HERE), "templates", "teams_details.json.j2")
+
+env = jinja2.Environment(undefined=jinja2.Undefined)
+env.filters["to_json"] = lambda v: json.dumps(v, ensure_ascii=False)
+
+
+def _regex_replace(value, pattern, replacement):
+    return re.sub(pattern, replacement, str(value))
+
+
+env.filters["regex_replace"] = _regex_replace
+env.tests["match"] = lambda v, p: re.match(p, str(v)) is not None
+tpl = env.from_string(io.open(TPL, encoding="utf-8").read())
+
+AUTH = "_lgthFcMDzjFJYgzKF2WHSuHkRuDlsZOKflow9uPSJ0"
+base = {
+    "operation": "metaco_solana_node_change",
+    "solrpc_url": "https://violet-tatooine-1a027.solana.bdnodes.net?auth=" + AUTH,
+    "solwsrpc_url": "wss://violet-tatooine-1a027.solana.bdnodes.net:8443/websocket?auth=" + AUTH,
+    "output": {"stdout_lines": [
+        "SOLRPC=https://old-node.solana.bdnodes.net?auth=OLDSECRETVALUE1234",
+        "SOLWSRPC=wss://old-node.solana.bdnodes.net:8443/websocket?auth=OLDSECRETVALUE1234",
+    ]},
+}
+problems = []
+
+items = json.loads(tpl.render(**base))
+texts = [i["text"] for i in items]
+if not all(i.get("type") == "TextBlock" for i in items):
+    problems.append("tum ogeler TextBlock olmali: %r" % items)
+if texts[0] != "**Zincir:** Solana indexer":
+    problems.append("zincir satiri: %r" % texts[0])
+if "**Eski değerler**" not in texts or "**Yeni değerler**" not in texts:
+    problems.append("eski/yeni basliklari yok: %r" % texts)
+if texts.index("**Eski değerler**") > texts.index("**Yeni değerler**"):
+    problems.append("eski, yeniden ONCE gelmeli")
+joined = "\n".join(texts)
+if AUTH in joined or "OLDSECRETVALUE1234" in joined:
+    problems.append("auth parametresi MASKELENMEDI: %s" % joined)
+if "auth=_lgt…" not in joined or "auth=OLDS…" not in joined:
+    problems.append("maske bicimi (ilk 4 + …) yok: %s" % joined)
+if "violet-tatooine-1a027.solana.bdnodes.net:8443/websocket" not in joined:
+    problems.append("host/yol korunmali: %s" % joined)
+new_lines = [t for t in texts if t.startswith("SOLRPC=") or t.startswith("SOLWSRPC=")]
+if len(new_lines) != 4:  # 2 eski + 2 yeni
+    problems.append("SOLRPC/SOLWSRPC satirlari: beklenen 4, bulunan %d" % len(new_lines))
+
+# user:pass@ maskesi
+u = tpl.render(operation="metaco_btc_node_change", btc_nodeendpoint="http://bitcoin:VerySecretPass@10.1.1.1:8332",
+               btcrpc_url="", output={"stdout_lines": []})
+uj = json.loads(u)
+ut = "\n".join(i["text"] for i in uj)
+if "VerySecretPass" in ut or "bitcoin:Ve…@10.1.1.1:8332" not in ut:
+    problems.append("user:pass@ maskesi: %s" % ut)
+if "(okunamadı)" not in ut:
+    problems.append("eski cikti bosken '(okunamadı)' yazmali: %s" % ut)
+
+# bilinmeyen operation
+x = json.loads(tpl.render(operation="metaco_bilinmeyen", output={"stdout_lines": []}))
+if not (len(x) == 1 and "ayrıntı şablonu yok" in x[0]["text"]):
+    problems.append("bilinmeyen operation icin acik mesaj yok: %r" % x)
+
+# stdout'ta anahtar=deger olmayan satirlar (oc login ciktisi vb.) eski degerlere GIRMEZ
+y = json.loads(tpl.render(operation="metaco_eth_node_change", eth_nodeendpoint="https://eth.example/x",
+                          output={"stdout_lines": ["Login successful.", "ETH_INDEXER_NODE_URI=https://old.eth/x"]}))
+yt = [i["text"] for i in y]
+if any("Login successful" in t for t in yt) or "ETH_INDEXER_NODE_URI=https://old.eth/x" not in yt:
+    problems.append("eski deger suzgeci: %r" % yt)
+
+if problems:
+    print("BULGU (%d):" % len(problems))
+    for p in problems:
+        print("  - " + p)
+    sys.exit(1)
+print("Temiz: zincir/eski/yeni sirasi, maskeleme (auth=, user:pass@), bos cikti ve bilinmeyen operation dogru.")
