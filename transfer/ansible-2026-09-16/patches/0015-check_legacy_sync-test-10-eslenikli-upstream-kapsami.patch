From: Onur Demir <demir-onur@hotmail.com>
Date: Tue, 15 Sep 2026 23:39:17 +0300
Subject: [PATCH 15/22] check_legacy_sync: test 10 eslenikli upstream kapsami
 icin --hosts verir (scope=upstreams artik tek basina)

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 bmw_nginx/tests/check_legacy_sync.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bmw_nginx/tests/check_legacy_sync.py b/bmw_nginx/tests/check_legacy_sync.py
index da6f4478c..92e4a4cc5 100644
--- a/bmw_nginx/tests/check_legacy_sync.py
+++ b/bmw_nginx/tests/check_legacy_sync.py
@@ -197,7 +197,7 @@ if "referans: GBRVPP02" not in rep4:
 
 # 10) --scope upstreams: location esitleme YOK, FQDN->upstream + upstream tanimi VAR; locations: tersi
 plan5 = os.path.join(tmp, "plan5")
-run_plan(raw, plan5, "--scope", "upstreams")
+run_plan(raw, plan5, "--scope", "upstreams", "--hosts", "GBRVPP01,GBRVPP02")  # eslenikli upstream kapsami
 u5 = load(plan5, "GBRVPP02"); u5f = {os.path.basename(f["path"]): f["content"] for f in u5["files"]}
 if any(a["action"] in ("ADD_LOCATION", "DIFF_LOCATION", "REPLACE_LOCATION") for a in u5["actions"]):
     problems.append("10: scope=upstreams location aksiyonu uretti")
