new file mode 100644
index 000000000..b41cb8a6a
--- /dev/null
+++ b/bmw_nginx/api_generator/location_limit_backfill.yml
@@ -0,0 +1,80 @@
+---
+# location_limit_backfill.yml — API gateway (mblcustomers) sunucularindaki API conf'larina
+# EKSIK olan location bazli rate limit'i geriye donuk ekler (2026-09-15).
+#
+# NEDEN: location limit'ler (zone=<base>_location_limit) bir betikle tum location'lara
+# tanimlanmisti; bir sure ESKI sablonla uretilen API'lerde bu satir ezildi. Yeni sablon
+# (operations/tasks/create.yaml) zaten iki limiti de yaziyor; bu playbook yalnizca ESKI
+# dosyalar icindir. Kural ve kenar durumlar: operations/files/location_limit_backfill.sh
+# (kabuk bloklari files/ altinda tutulur), README.md §7.
+#
+# MOD (extra var `mode`): report (VARSAYILAN, hicbir sey yazmaz) | apply (yaz + nginx -t
+# + reload; -t duserse o hosttaki tum degisen dosyalar yedekten geri alinir, host fail).
+# HEDEF (extra var `target_hosts`): varsayilan tum production API gateway sunuculari
+# (asagida). Once TEK hostta apply ile deneyin: -e "mode=apply target_hosts=GBNGWAP01".
+# YORUMLU location_limit'li bloklar (BAKARKGW gibi) varsayilan ATLANIR ve raporlanir;
+# -e include_commented=true ile onlar da eklenir.
+# DEGERLER: rate/mem/burst varsayilani mevcut tanimlarla ayni (300r/s, 10m, burst=10);
+# -e "ll_rate=300r/s ll_mem=10m ll_burst=10" ile degistirilebilir.
+
+- name: "--- location_limit geriye donuk ekleme (API gateway) ---"
+  # Production API gateway: Pendik GBNGWP01-16 + GBNGWP25-32, Ankara GBNGWAP01-08 + GBNGWAP22-25.
+  # README §1 ile ayni liste (36 sunucu).
+  hosts: >-
+    {{ target_hosts | default('GBNGWP01,GBNGWP02,GBNGWP03,GBNGWP04,GBNGWP05,GBNGWP06,GBNGWP07,GBNGWP08,GBNGWP09,GBNGWP10,GBNGWP11,GBNGWP12,GBNGWP13,GBNGWP14,GBNGWP15,GBNGWP16,GBNGWP25,GBNGWP26,GBNGWP27,GBNGWP28,GBNGWP29,GBNGWP30,GBNGWP31,GBNGWP32,GBNGWAP01,GBNGWAP02,GBNGWAP03,GBNGWAP04,GBNGWAP05,GBNGWAP06,GBNGWAP07,GBNGWAP08,GBNGWAP22,GBNGWAP23,GBNGWAP24,GBNGWAP25') }}
+  gather_facts: no
+  ignore_unreachable: true
+  vars:
+    mode: report
+    include_commented: false
+    ll_rate: "300r/s"
+    ll_mem: "10m"
+    ll_burst: "10"
+  tasks:
+    - name: --- [Task] Mod dogrula ---
+      ansible.builtin.assert:
+        that:
+          - (mode | lower) in ['report', 'apply']
+          - ll_rate is match('^[0-9]+r/[sm]$')
+          - ll_mem is match('^[0-9]+[mk]$')
+          - ll_burst is match('^[0-9]+$')
+        fail_msg: "mode report|apply olmali (verilen: '{{ mode }}'); ll_rate 300r/s, ll_mem 10m, ll_burst 10 biciminde olmali"
+
+    - name: --- [Task] Betigi kopyala ---
+      ansible.builtin.copy:
+        src: operations/files/location_limit_backfill.sh
+        dest: /tmp/location_limit_backfill.sh
+        mode: '0755'
+
+    - name: "--- [Task] {{ 'UYGULA' if (mode | lower) == 'apply' else 'RAPOR' }}: *-apis/*.conf tarama ---"
+      become: true
+      become_method: dzdo
+      become_user: www
+      ansible.builtin.command: /bin/bash /tmp/location_limit_backfill.sh {{ mode | lower }}
+      environment:
+        LL_RATE: "{{ ll_rate }}"
+        LL_MEM: "{{ ll_mem }}"
+        LL_BURST: "{{ ll_burst }}"
+        LL_INCLUDE_COMMENTED: "{{ '1' if (include_commented | bool) else '0' }}"
+      register: ll
+      changed_when: (mode | lower) == 'apply' and ('RESULT\tOK' in ll.stdout)
+      failed_when: ll.rc not in [0, 3]
+
+    - name: --- [Task] Betigi temizle ---
+      ansible.builtin.file:
+        path: /tmp/location_limit_backfill.sh
+        state: absent
+      changed_when: false
+
+    - name: --- [Task] Ozet ---
+      ansible.builtin.debug:
+        msg:
+          - "{{ inventory_hostname }} · mod={{ mode }} · rate={{ ll_rate }} burst={{ ll_burst }}"
+          - "{{ (ll.stdout_lines | select('match', '^SUMMARY') | list | first | default('SUMMARY 0 0 0 0 0 0 0')) | regex_replace('^SUMMARY\\t(\\d+)\\t(\\d+)\\t(\\d+)\\t(\\d+)\\t(\\d+)\\t(\\d+)\\t(\\d+)$', 'toplam \\1 dosya · degisen \\2 dosya / \\3 location satiri · zaten tam \\4 · limit_req yok \\5 · eklenen zone \\6 · yorumlu atlanan blok \\7') }}"
+          - "{{ (ll.stdout_lines | select('match', '^RESULT') | list | first | default('RESULT\t-\trapor modu, degisiklik yok')) | regex_replace('^RESULT\\t', '') | regex_replace('\\t', ' - ') }}"
+          - "{{ ll.stdout_lines | select('match', '^NOTE') | map('regex_replace', '\\t', ' ') | list }}"
+
+    - name: --- [Task] nginx -t dustu, geri alindi -> host FAIL ---
+      ansible.builtin.fail:
+        msg: "{{ inventory_hostname }}: {{ (ll.stdout_lines | select('match', '^RESULT') | list | first | default('')) }}"
+      when: ll.rc == 3
diff --git a/bmw_nginx/api_generator/operations/files/location_limit_backfill.sh b/bmw_nginx/api_generator/operations/files/location_limit_backfill.sh
new file mode 100644
index 000000000..d368f2178
--- /dev/null
+++ b/bmw_nginx/api_generator/operations/files/location_limit_backfill.sh
@@ -0,0 +1,194 @@
+#!/bin/bash
+# location_limit_backfill.sh - API conf'larindaki location bloklarina EKSIK olan location
+# bazli rate limit'i (zone=<base>_location_limit) geriye donuk ekler (2026-09-15).
+#
+# NEDEN: location limit'ler bir betikle tum location'lara tanimlanmisti; bir sure boyunca
+# ESKI sablonla uretilen API'lerde bu satir ezildi (yalniz _rate_limit kaldi). Dump
+# (GBNGWAP01): 252 API dosyasinin 83'unde hic yok; 32 API'nin limit-zones.conf'ta
+# location zone TANIMI da yok; 1 API'de (BAKARKGW) 94 blogun hepsinde satir YORUMLU.
+#
+# KURAL (her location blogu icin):
+#   - blokta  `limit_req zone=<base>_rate_limit ...;`  VAR ve
+#     `limit_req zone=<base>_location_limit ...;` YOK ise
+#     rate_limit satirinin HEMEN ALTINA, ayni girintiyle:
+#         limit_req zone=<base>_location_limit burst=<BURST> nodelay;
+#     (<base> o bloktaki rate_limit zone adindan alinir; Base Path basligina bakilmaz -
+#      blok neyi kullaniyorsa onun esi eklenir.)
+#   - hic limit_req olmayan bloklar (@named, servicePing) DOKUNULMAZ.
+#   - blokta YORUMLU (#) bir location_limit satiri varsa biri bilerek kapatmis olabilir:
+#     varsayilan ATLANIR ve NOTE COMMENTED ile raporlanir; LL_INCLUDE_COMMENTED=1 ekletir.
+#   - dosya basinda `# limit_req_location_zone_memory_size` / `_rate` satirlari yoksa
+#     `# limit_req_zone_rate:` satirinin hemen altina eklenir (yeni sablonla ayni gorunum).
+#   - kullanilan her <base> icin limit-zones.conf'ta
+#         limit_req_zone $server_name zone=<base>_location_limit:<MEM> rate=<RATE>;
+#     yoksa dosya SONUNA eklenir (create.yaml'in lineinfile davranisiyla ayni yer).
+#   - Idempotent: ikinci kosu hicbir sey degistirmez.
+#   - apply: degisen her dosyanin .ll-bak.<ts> yedegi alinir; nginx -t duserse TUM
+#     degisen dosyalar (limit-zones.conf dahil) geri alinir, reload yapilmaz, cikis 3.
+#
+# KULLANIM: location_limit_backfill.sh <report|apply> [conf_glob] [zones_file]
+#   varsayilan conf_glob : /usr/nginx/conf.d/*-apis/*.conf   (kanal bagimsiz)
+#   varsayilan zones_file: /usr/nginx/conf.d/limit-zones.conf
+# ORTAM: LL_RATE (300r/s) LL_MEM (10m) LL_BURST (10) LL_INCLUDE_COMMENTED (0)
+#        LL_NGINX (/usr/nginx/sbin/nginx)
+#
+# CIKTI (stdout, TAB ayrilmis):
+#   FILE     <ADD|HAS|COMMENTED|SKIP|ERR>  <dosya>  <eklenen satir sayisi>
+#   ZONE     <ADD|HAS>           <base>
+#   NOTE     COMMENTED <dosya> <aciklama>   (yorumlu location_limit'li bloklar)
+#   SUMMARY  <toplam dosya> <degisen dosya> <eklenen location satiri> <zaten tam> <limit_req'siz> <eklenen zone> <yorumlu atlanan blok>
+#   RESULT   <OK|ROLLBACK|-> <aciklama>
+set -u
+MODE="${1:-report}"
+CONF_GLOB="${2:-/usr/nginx/conf.d/*-apis/*.conf}"
+ZONES="${3:-/usr/nginx/conf.d/limit-zones.conf}"
+RATE="${LL_RATE:-300r/s}"
+MEM="${LL_MEM:-10m}"
+BURST="${LL_BURST:-10}"
+INCLUDE_COMMENTED="${LL_INCLUDE_COMMENTED:-0}"
+NGINX_BIN="${LL_NGINX:-/usr/nginx/sbin/nginx}"
+TS="$(date +%Y%m%d%H%M%S)"
+
+case "$MODE" in report|apply) ;; *) echo "kullanim: $0 <report|apply> [conf_glob] [zones_file]" >&2; exit 2 ;; esac
+[ -f "$ZONES" ] || { printf 'SUMMARY\t0\t0\t0\t0\t0\t0\t0\n'; printf 'NOTE\tzone dosyasi yok: %s\n' "$ZONES"; exit 0; }
+
+# Bir dosyanin yeni icerigini uretir (dosyayi DEGISTIRMEZ). stdout: yeni icerik.
+# stderr: "ADDED <n>", "SKIPPEDC <n>" ve kullanilan base'ler "BASE <base>".
+rewrite() {
+  local has_hdr=0
+  grep -qE '^# limit_req_location_zone_(memory_size|rate):' "$1" && has_hdr=1
+  awk -v BURST="$BURST" -v MEM="$MEM" -v RATE="$RATE" -v HAS_HDR="$has_hdr" -v INCL_COMMENTED="$INCLUDE_COMMENTED" '
+    # Cikti ONCE tamponlanir (out[]): baslik satirlari yalniz gercekten location satiri
+    # EKLENDIYSE yazilir - aksi halde 87 tam dosyaya salt yorum icin dokunulurdu.
+    function emit(line) { out[++m] = line }
+    function flush_block(   i, line, ind, added_before) {
+      added_before = added
+      for (i = 1; i <= n; i++) {
+        line = blk[i]
+        emit(line)
+        if (rate_base != "" && !has_loc && i == rate_idx && (!commented || INCL_COMMENTED == "1")) {
+          ind = line; sub(/[^ \t].*$/, "", ind)
+          emit(ind "limit_req zone=" rate_base "_location_limit burst=" BURST " nodelay;")
+          added++
+        }
+      }
+      # Zone yalniz AKTIF kullanilan base icin (eklenen ya da zaten olan satir); yorumlu
+      # atlanan blogun base degeri icin zone acilmaz.
+      if (rate_base != "" && (has_loc || added > added_before)) print "BASE " rate_base > "/dev/stderr"
+      # Yorumlanmis (#) location_limit satiri olan blok: biri BILEREK kapatmis olabilir.
+      # Varsayilan: atla ve raporla; LL_INCLUDE_COMMENTED=1 ile yine eklenir.
+      if (rate_base != "" && !has_loc && commented) { print "COMMENTED " hdr > "/dev/stderr"; skipped_c++ }
+      n = 0; rate_base = ""; rate_idx = 0; has_loc = 0; commented = 0; hdr = ""
+    }
+    BEGIN { inblk = 0; depth = 0; n = 0; m = 0; added = 0; skipped_c = 0; hdr_at = 0 }
+    {
+      # Baslik: `# limit_req_zone_rate:` satirinin HEMEN altina location basliklari
+      # (dosyada hic yoksa; on-tarama HAS_HDR ile bakildi). Yeni sablonla ayni gorunum.
+      # Yeri simdi isaretlenir, satirlar END asamasinda (added > 0 ise) araya konur.
+      if (!inblk && !HAS_HDR && !hdr_at && $0 ~ /^# limit_req_zone_rate:/) { emit($0); hdr_at = m; next }
+      if (!inblk) {
+        if ($0 ~ /^[[:space:]]*location[[:space:]]/) {
+          inblk = 1; depth = 0; n = 0; rate_base = ""; rate_idx = 0; has_loc = 0; commented = 0
+          hdr = $0; sub(/^[[:space:]]+/, "", hdr); sub(/[[:space:]]*\{.*$/, "", hdr)
+        } else { emit($0); next }
+      }
+      blk[++n] = $0
+      if ($0 ~ /^[[:space:]]*limit_req[[:space:]]+zone=[^[:space:];]+_rate_limit([[:space:];]|$)/) {
+        s = $0; sub(/^[[:space:]]*limit_req[[:space:]]+zone=/, "", s); sub(/_rate_limit([[:space:];].*)?$/, "", s)
+        if (rate_base == "") { rate_base = s; rate_idx = n }
+      }
+      if ($0 ~ /^[[:space:]]*limit_req[[:space:]]+zone=[^[:space:];]+_location_limit([[:space:];]|$)/) has_loc = 1
+      if ($0 ~ /^[[:space:]]*#[[:space:]]*limit_req[[:space:]]+zone=[^[:space:];]+_location_limit/) commented = 1
+      o = gsub(/\{/, "{"); c = gsub(/\}/, "}")
+      depth += o - c
+      if (depth <= 0 && (o > 0 || c > 0)) { inblk = 0; flush_block() }
+    }
+    END {
+      if (inblk) { for (i = 1; i <= n; i++) emit(blk[i]) }   # kapanmamis blok: dokunma
+      for (i = 1; i <= m; i++) {
+        print out[i]
+        if (added > 0 && hdr_at == i) {
+          print "# limit_req_location_zone_memory_size: " MEM
+          print "# limit_req_location_zone_rate: " RATE
+        }
+      }
+      print "ADDED " added > "/dev/stderr"
+      print "SKIPPEDC " skipped_c > "/dev/stderr"
+    }
+  ' "$1"
+}
+
+total=0; changed=0; lines_added=0; has=0; skip=0; err=0; zones_added=0; commented_blocks=0
+changed_files=""
+bases_all=""
+for f in $CONF_GLOB; do
+  [ -f "$f" ] || continue
+  total=$((total + 1))
+  tmp_err="$(mktemp)"
+  out="$(rewrite "$f" 2>"$tmp_err")"; rc=$?
+  if [ "$rc" -ne 0 ]; then err=$((err + 1)); printf 'FILE\tERR\t%s\t0\n' "$f"; rm -f "$tmp_err"; continue; fi
+  added="$(sed -n 's/^ADDED //p' "$tmp_err")"
+  skc="$(sed -n 's/^SKIPPEDC //p' "$tmp_err")"
+  bases="$(sed -n 's/^BASE //p' "$tmp_err" | sort -u)"
+  rm -f "$tmp_err"
+  if [ "${skc:-0}" -gt 0 ]; then
+    if [ "$INCLUDE_COMMENTED" = "1" ]; then
+      printf 'NOTE\tCOMMENTED\t%s\t%s blokta yorumlu location_limit vardi, LL_INCLUDE_COMMENTED=1 ile yine eklendi\n' "$f" "$skc"
+    else
+      printf 'NOTE\tCOMMENTED\t%s\t%s blokta location_limit YORUMLU (#) - bilerek kapatilmis olabilir, ATLANDI (LL_INCLUDE_COMMENTED=1 ile eklenir)\n' "$f" "$skc"
+    fi
+    commented_blocks=$((commented_blocks + skc))
+  fi
+  [ -n "$bases" ] && bases_all="$bases_all
+$bases"
+  # Yalniz yorumlu-atlanan bloklari olan dosya: "limit_req yok" DEGIL, "atlanan" sayilir.
+  if [ -z "$bases" ] && [ "${skc:-0}" -gt 0 ]; then has=$((has + 1)); printf 'FILE\tCOMMENTED\t%s\t0\n' "$f"; continue; fi
+  if [ -z "$bases" ]; then skip=$((skip + 1)); printf 'FILE\tSKIP\t%s\t0\n' "$f"; continue; fi
+  # Icerik degisti mi (baslik satirlari eklenmis olabilir; location eklenmemis olsa da)
+  if [ "$out" = "$(cat "$f")" ]; then has=$((has + 1)); printf 'FILE\tHAS\t%s\t0\n' "$f"; continue; fi
+  changed=$((changed + 1)); lines_added=$((lines_added + added)); printf 'FILE\tADD\t%s\t%s\n' "$f" "$added"
+  if [ "$MODE" = "apply" ]; then
+    cp -p "$f" "$f.ll-bak.$TS" || { err=$((err + 1)); continue; }
+    printf '%s\n' "$out" > "$f"
+    changed_files="$changed_files $f"
+  fi
+done
+
+# Zone tanimlari: kullanilan her base icin _location_limit zone'u var mi. (Yorumlu
+# atlanan bloklarin base'i listeye GIRMEZ - kullanilmayan zone acilmaz.)
+zone_lines=""
+for base in $(printf '%s\n' "$bases_all" | sed '/^$/d' | sort -u); do
+  if grep -qE "^[[:space:]]*limit_req_zone[[:space:]]+\S+[[:space:]]+zone=${base}_location_limit:" "$ZONES"; then
+    printf 'ZONE\tHAS\t%s\n' "$base"
+  else
+    zones_added=$((zones_added + 1)); printf 'ZONE\tADD\t%s\n' "$base"
+    zone_lines="$zone_lines
+limit_req_zone \$server_name zone=${base}_location_limit:${MEM} rate=${RATE};"
+  fi
+done
+if [ "$MODE" = "apply" ] && [ "$zones_added" -gt 0 ]; then
+  cp -p "$ZONES" "$ZONES.ll-bak.$TS"
+  # dosya sonu newline ile bitmiyorsa once tamamla
+  [ -n "$(tail -c1 "$ZONES")" ] && printf '\n' >> "$ZONES"
+  printf '%s\n' "$zone_lines" | sed '/^$/d' >> "$ZONES"
+  changed_files="$changed_files $ZONES"
+fi
+
+printf 'SUMMARY\t%d\t%d\t%d\t%d\t%d\t%d\t%d\n' "$total" "$changed" "$lines_added" "$has" "$skip" "$zones_added" "$commented_blocks"
+[ "$err" -gt 0 ] && printf 'NOTE\tERR\t%d dosyada hata\n' "$err"
+
+if [ "$MODE" = "apply" ] && [ -n "$changed_files" ]; then
+  if dzdo "$NGINX_BIN" -p /usr/nginx/ -c /usr/nginx/nginx.conf -e /web_log/error.log -t >/tmp/ll_nginx_t.$$ 2>&1; then
+    dzdo "$NGINX_BIN" -p /usr/nginx/ -c /usr/nginx/nginx.conf -e /web_log/error.log -s reload
+    printf 'RESULT\tOK\t%d dosya + %d zone degisti, nginx -t gecti, reload yapildi\n' "$changed" "$zones_added"
+    rm -f /tmp/ll_nginx_t.$$
+    exit 0
+  else
+    for f in $changed_files; do cp -p "$f.ll-bak.$TS" "$f"; done
+    printf 'RESULT\tROLLBACK\tnginx -t DUSTU, %d dosya yedekten geri alindi: %s\n' "$changed" "$(tr '\n' ' ' < /tmp/ll_nginx_t.$$ | cut -c1-400)"
+    rm -f /tmp/ll_nginx_t.$$
+    exit 3
+  fi
+fi
+printf 'RESULT\t-\t%s\n' "$([ "$MODE" = "apply" ] && echo 'degisiklik yok' || echo 'rapor modu, degisiklik yok')"
+exit 0
