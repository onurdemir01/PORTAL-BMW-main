+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""location_limit_backfill.sh: API conf'larina eksik location_limit satiri + zone tanimi.
+
+Kilitlenen iddialar (betik GERCEKTEN kosturulur, Git Bash):
+  1. rate_limit var / location_limit yok -> rate satirinin HEMEN altina, ayni girintiyle,
+     ayni <base> ile, burst=LL_BURST; baslik (memory_size/rate) `# limit_req_zone_rate:`
+     satirinin hemen altina; zone tanimi limit-zones.conf SONUNA.
+  2. zaten tam olan dosya ve limit_req'siz bloklar (@named) DOKUNULMAZ; basliksiz ama tam
+     dosyaya salt yorum icin de dokunulmaz.
+  3. YORUMLU (#) location_limit'li blok varsayilan ATLANIR + NOTE COMMENTED;
+     LL_INCLUDE_COMMENTED=1 ile eklenir.
+  4. report modu hicbir dosyayi degistirmez; apply yedek birakir; ikinci kosu idempotent.
+  5. nginx -t duserse tum degisen dosyalar (limit-zones.conf dahil) geri alinir, cikis 3.
+  6. playbook betigi files/ altindan kopyalayip calistirir (gomulu shell yok), 36 prod
+     API gateway sunucusu README §1 ile ayni.
+"""
+import io
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+API = os.path.join(os.path.dirname(HERE), "api_generator")
+SCRIPT = os.path.join(API, "operations", "files", "location_limit_backfill.sh")
+PLAYBOOK = os.path.join(API, "location_limit_backfill.yml")
+README = os.path.join(API, "README.md")
+
+problems = []
+tmp = tempfile.mkdtemp(prefix="llbf-")
+apis = os.path.join(tmp, "mblcustomers-prod-apis")
+os.makedirs(apis)
+fake = os.path.join(tmp, "bin")
+os.makedirs(fake)
+zones = os.path.join(tmp, "limit-zones.conf")
+
+BLOCK = """location = {path} {{
+  limit_except GET OPTIONS {{
+    deny all;
+  }}
+
+  limit_req zone={base}_rate_limit burst={burst} nodelay;
+{extra}  limit_req_status 429;
+
+  proxy_pass https://apigw;
+}}
+"""
+
+
+def hdr(base, loc=False):
+    h = "# Service Instance Name: X\n# Base Path: %s\n# limit_req_zone_memory_size: 10m\n# limit_req_zone_rate: 50r/s\n" % base
+    if loc:
+        h += "# limit_req_location_zone_memory_size: 10m\n# limit_req_location_zone_rate: 300r/s\n"
+    return h + "\n"
+
+
+B1, B2, B3 = "/a/one/v0", "/b/two/v0", "/c/three/v0"
+missing = hdr(B1) + BLOCK.format(path=B1 + "/x", base=B1, burst=10, extra="") + "\n" + BLOCK.format(path=B1 + "/y", base=B1, burst=50, extra="")
+full = hdr(B2) + BLOCK.format(path=B2 + "/x", base=B2, burst=10, extra="  limit_req zone=%s_location_limit burst=10 nodelay;\n" % B2) + "\nlocation @custom_403_json {\n  return 403;\n}\n"
+commented = hdr(B3) + BLOCK.format(path=B3 + "/x", base=B3, burst=10, extra="  #limit_req zone=%s_location_limit burst=10 nodelay;\n" % B3)
+io.open(os.path.join(apis, "MISSING.conf"), "w", newline="\n").write(missing)
+io.open(os.path.join(apis, "FULL.conf"), "w", newline="\n").write(full)
+io.open(os.path.join(apis, "COMMENTED.conf"), "w", newline="\n").write(commented)
+io.open(os.path.join(apis, "servicepingssl.conf"), "w", newline="\n").write("location = /servicePing/ssl/ {\n  return 200;\n}\n")
+io.open(zones, "w", newline="\n").write(
+    "limit_req_zone $binary_remote_addr zone=%s_rate_limit:10m rate=50r/s;\n" % B1
+    + "limit_req_zone $binary_remote_addr zone=%s_rate_limit:10m rate=50r/s;\n" % B2
+    + "limit_req_zone $server_name zone=%s_location_limit:10m rate=300r/s;\n" % B2
+    + "limit_req_zone $binary_remote_addr zone=%s_rate_limit:10m rate=50r/s;\n" % B3
+)
+io.open(os.path.join(fake, "dzdo"), "w", newline="\n").write("#!/bin/bash\n[ -f \"$(dirname \"$0\")/fail\" ] && exit 1\nexit 0\n")
+
+
+def run(mode, env_extra=None):
+    env = dict(os.environ)
+    env["PATH"] = fake.replace("\\", "/") + os.pathsep + env.get("PATH", "")
+    env["LL_NGINX"] = os.path.join(fake, "dzdo")
+    # Windows/MSYS: yerel surecten gelen argumanlardaki joker (*) bash'e ulasmadan MSYS
+    # tarafindan genisletilir ($2/$3 kayar). noglob bunu kapatir; Linux'ta etkisiz.
+    env["MSYS"] = "noglob"
+    env.update(env_extra or {})
+    glob_ = os.path.join(tmp, "*-apis", "*.conf").replace("\\", "/")
+    try:
+        r = subprocess.run(["bash", SCRIPT, mode, glob_, zones], capture_output=True, text=True, encoding="utf-8", env=env)
+    except FileNotFoundError:
+        print("ATLANDI: bash yok")
+        sys.exit(0)
+    return r
+
+
+def summary(out):
+    m = re.search(r"^SUMMARY\t(.*)$", out, re.M)
+    return [int(x) for x in m.group(1).split("\t")] if m else None
+
+
+rd = lambda n: io.open(os.path.join(apis, n), encoding="utf-8").read()
+
+# 4) report degistirmez
+before = {n: rd(n) for n in os.listdir(apis)}
+r = run("report")
+if r.returncode != 0:
+    problems.append("report rc=%s: %s" % (r.returncode, r.stderr))
+s = summary(r.stdout)
+if s != [4, 1, 2, 2, 1, 1, 1]:
+    problems.append("4: report SUMMARY beklenen [4,1,2,2,1,1,1] (COMMENTED dosya atlanan sayilir), gelen %r" % s)
+if {n: rd(n) for n in os.listdir(apis)} != before:
+    problems.append("4: report modu dosya degistirdi")
+if "NOTE\tCOMMENTED\t" not in r.stdout or "1 blokta" not in r.stdout:
+    problems.append("3: yorumlu blok NOTE COMMENTED ile raporlanmadi")
+if not re.search(r"^ZONE\tADD\t%s$" % re.escape(B1), r.stdout, re.M) or not re.search(r"^ZONE\tHAS\t%s$" % re.escape(B2), r.stdout, re.M):
+    problems.append("1: zone ADD/HAS ayrimi yanlis:\n" + r.stdout)
+
+# apply
+r = run("apply")
+if r.returncode != 0 or "RESULT\tOK" not in r.stdout:
+    problems.append("apply basarisiz rc=%s\n%s\n%s" % (r.returncode, r.stdout, r.stderr))
+m = rd("MISSING.conf")
+exp_line = "  limit_req zone=%s_location_limit burst=10 nodelay;" % B1
+if m.count(exp_line) != 2:
+    problems.append("1: MISSING.conf'ta iki bloga da location_limit eklenmedi:\n" + m)
+if not re.search(r"limit_req zone=%s_rate_limit burst=50 nodelay;\n%s\n" % (re.escape(B1), re.escape(exp_line)), m):
+    problems.append("1: location satiri rate satirinin HEMEN altinda degil (burst=50 blok)")
+if "# limit_req_zone_rate: 50r/s\n# limit_req_location_zone_memory_size: 10m\n# limit_req_location_zone_rate: 300r/s\n" not in m:
+    problems.append("1: baslik satirlari limit_req_zone_rate altina eklenmedi")
+if rd("FULL.conf") != full:
+    problems.append("2: tam dosyaya dokunuldu")
+if rd("COMMENTED.conf") != commented:
+    problems.append("3: yorumlu blok varsayilanda eklendi (atlanmaliydi)")
+if rd("servicepingssl.conf") != "location = /servicePing/ssl/ {\n  return 200;\n}\n":
+    problems.append("2: limit_req'siz dosyaya dokunuldu")
+z = io.open(zones, encoding="utf-8").read()
+if not z.endswith("limit_req_zone $server_name zone=%s_location_limit:10m rate=300r/s;\n" % B1):
+    problems.append("1: zone tanimi limit-zones.conf sonuna eklenmedi:\n" + z)
+if z.count("_location_limit:") != 2:
+    problems.append("1: zone sayisi yanlis (B2 zaten vardi, B1 eklenmeli, B3 yorumlu-atlanan icin de eklenmemeli? -> %d)" % z.count("_location_limit:"))
+if not [f for f in os.listdir(apis) if ".ll-bak." in f]:
+    problems.append("4: apply yedek birakmadi")
+
+# idempotent
+r = run("apply")
+s = summary(r.stdout)
+if s is None or s[1] != 0 or s[2] != 0 or s[5] != 0 or "degisiklik yok" not in r.stdout:
+    problems.append("4: ikinci kosu idempotent degil: %r" % s)
+
+# include commented
+r = run("apply", {"LL_INCLUDE_COMMENTED": "1"})
+if "limit_req zone=%s_location_limit burst=10 nodelay;" % B3 not in rd("COMMENTED.conf"):
+    problems.append("3: LL_INCLUDE_COMMENTED=1 yorumlu bloga eklemedi")
+z = io.open(zones, encoding="utf-8").read()
+if z.count("_location_limit:") != 3:
+    problems.append("3: yorumlu blok eklenince zone da eklenmeli (%d)" % z.count("_location_limit:"))
+
+# 5) rollback
+io.open(os.path.join(apis, "MISSING2.conf"), "w", newline="\n").write(hdr("/d/four/v0") + BLOCK.format(path="/d/four/v0/x", base="/d/four/v0", burst=10, extra=""))
+zbefore = io.open(zones, encoding="utf-8").read()
+io.open(os.path.join(fake, "fail"), "w").write("1")
+r = run("apply")
+os.remove(os.path.join(fake, "fail"))
+if r.returncode != 3 or "RESULT\tROLLBACK" not in r.stdout:
+    problems.append("5: nginx -t dusunce cikis 3 / ROLLBACK bekleniyordu: rc=%s\n%s" % (r.returncode, r.stdout))
+if "_location_limit" in rd("MISSING2.conf"):
+    problems.append("5: rollback dosyayi geri almadi")
+if io.open(zones, encoding="utf-8").read() != zbefore:
+    problems.append("5: rollback limit-zones.conf'u geri almadi")
+
+# 6) playbook + README
+pb = io.open(PLAYBOOK, encoding="utf-8").read()
+if "src: operations/files/location_limit_backfill.sh" not in pb or "shell: |" in pb:
+    problems.append("6: playbook betigi files/ altindan kopyalamiyor ya da gomulu shell var")
+hosts = re.findall(r"GBNGWA?P\d{2}", pb)
+exp = ["GBNGWP%02d" % i for i in list(range(1, 17)) + list(range(25, 33))] + ["GBNGWAP%02d" % i for i in list(range(1, 9)) + list(range(22, 26))]
+if sorted(set(hosts)) != sorted(exp):
+    problems.append("6: playbook hedef listesi 36 prod API gateway ile ayni degil: eksik %s fazla %s" % (sorted(set(exp) - set(hosts)), sorted(set(hosts) - set(exp))))
+if "LL_INCLUDE_COMMENTED" not in pb:
+    problems.append("6: include_commented anahtari betige gecmiyor")
+if "location_limit_backfill" not in io.open(README, encoding="utf-8").read():
+    problems.append("6: README'de playbook anlatilmamis")
+
+if problems:
+    print("HATALAR:")
+    for p in problems:
+        print(" -", p)
+    sys.exit(1)
+print("OK: location_limit backfill - ekleme yeri/bicimi, zone, yorumlu politika, idempotent, rollback, playbook hedefleri")
