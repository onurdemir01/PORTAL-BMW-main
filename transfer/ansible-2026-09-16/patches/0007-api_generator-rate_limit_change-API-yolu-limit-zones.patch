diff --git a/bmw_nginx/tests/check_rate_limit_resolve.py b/bmw_nginx/tests/check_rate_limit_resolve.py
new file mode 100644
index 000000000..c152ee7d2
--- /dev/null
+++ b/bmw_nginx/tests/check_rate_limit_resolve.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""rate_limit_change: yazilan API yolu -> limit-zones.conf'taki gercek zone govdesi.
+
+Kullanici bildirimi (2026-09-15): sunucudaki zone adlarinin cogu sonda "/" tasimaz;
+"/x/y/v0/" yazilinca "/x/y/v0/_rate_limit" aranip is "TANIMLI DEGIL" ile duruyordu.
+
+Kilitlenen iddialar (betik GERCEKTEN kosturulur, Git Bash):
+  1. "/x/v0/" yazildi, zone "/x/v0_rate_limit" -> RESOLVED=/x/v0, NORMALIZED=yes
+  2. tersi: zone "/y/v0/_rate_limit", "/y/v0" yazildi -> RESOLVED=/y/v0/
+  3. birebir varsa girdi degismez (NORMALIZED=no)
+  4. limit_type=location yalniz _location_limit'e bakar (ip zone'u varken bile bulamaz)
+  5. bulunamayinca SIMILAR yol parcasi uzerinden benzerleri listeler; hic benzer yoksa bos
+  6. playbook betigi files/ altindan `script` ile cagirir, set_fact bos-liste tuzagina
+     dusmez (`| first` YOK), hata mesajina ve Teams'e yonerge (rl_hint_text) girer
+"""
+import io
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+OPS = os.path.join(os.path.dirname(HERE), "api_generator", "operations")
+SCRIPT = os.path.join(OPS, "files", "resolve_zone_base.sh")
+TASKS = os.path.join(OPS, "tasks", "rate_limit_change.yaml")
+
+problems = []
+tmp = tempfile.mkdtemp(prefix="rlz-")
+zones = os.path.join(tmp, "limit-zones.conf")
+io.open(zones, "w", encoding="utf-8", newline="\n").write(
+    "limit_req_zone $binary_remote_addr zone=/das-fireblocks-event-mngmnt/fireblocks-webhook-public/v0_rate_limit:10m rate=50r/s;\n"
+    "limit_req_zone $server_name zone=/das-fireblocks-event-mngmnt/fireblocks-webhook-public/v0_location_limit:10m rate=100r/s;\n"
+    "limit_req_zone $binary_remote_addr zone=/family-banking-mngmnt/family-banking-mng-ch/v0/_rate_limit:10m rate=5r/s;\n"
+    "limit_req_zone $binary_remote_addr zone=/only-ip/api/v1_rate_limit:10m rate=5r/s;\n"
+)
+
+
+def run(api, ltype):
+    try:
+        r = subprocess.run(["bash", SCRIPT, api, ltype, zones], capture_output=True, text=True, encoding="utf-8")
+    except FileNotFoundError:
+        print("ATLANDI: bash yok")
+        sys.exit(0)
+    out = {}
+    for line in r.stdout.splitlines():
+        k, _, v = line.partition("=")
+        out[k] = v
+    if r.returncode != 0:
+        problems.append("betik %s ile cikti (%s %s): %s" % (r.returncode, api, ltype, r.stderr))
+    return out
+
+
+# 1) sondaki "/" atilir
+o = run("/das-fireblocks-event-mngmnt/fireblocks-webhook-public/v0/", "ip")
+if o.get("RESOLVED") != "/das-fireblocks-event-mngmnt/fireblocks-webhook-public/v0":
+    problems.append("1: sondaki / atilarak cozulmedi: %r" % o)
+if o.get("NORMALIZED") != "yes":
+    problems.append("1: NORMALIZED=yes bekleniyordu: %r" % o)
+
+# 2) ters yon: zone "/"li, girdi "/"siz
+o = run("/family-banking-mngmnt/family-banking-mng-ch/v0", "both")
+if o.get("RESOLVED") != "/family-banking-mngmnt/family-banking-mng-ch/v0/":
+    problems.append("2: sona / eklenerek cozulmedi: %r" % o)
+
+# 3) birebir
+o = run("/only-ip/api/v1", "ip")
+if o.get("RESOLVED") != "/only-ip/api/v1" or o.get("NORMALIZED") != "no":
+    problems.append("3: birebir eslesme degistirildi: %r" % o)
+
+# 4) tip ayrimi
+o = run("/only-ip/api/v1", "location")
+if o.get("RESOLVED"):
+    problems.append("4: location tipi icin ip zone'u kabul edildi: %r" % o)
+if "/only-ip/api/v1_rate_limit" not in (o.get("SIMILAR") or ""):
+    problems.append("4: benzer listesinde mevcut ip zone'u yok: %r" % o)
+
+# 5) benzerler
+o = run("/das-fireblocks-event-mngmnt/fireblocks-webhook/v0", "ip")
+if o.get("RESOLVED"):
+    problems.append("5: olmayan yol cozuldu: %r" % o)
+if "fireblocks-webhook-public/v0_rate_limit" not in (o.get("SIMILAR") or ""):
+    problems.append("5: yol parcasi uzerinden benzer bulunamadi: %r" % o)
+o = run("/yok/hic/v9", "ip")
+if o.get("RESOLVED") or o.get("SIMILAR"):
+    problems.append("5b: hic benzemeyen yol icin RESOLVED/SIMILAR bos olmali: %r" % o)
+
+# 6) playbook baglantisi
+src = io.open(TASKS, encoding="utf-8").read()
+if not re.search(r"ansible\.builtin\.script:\s*\n\s*cmd:\s*\"files/resolve_zone_base\.sh ", src):
+    problems.append("6: rate_limit_change.yaml betigi files/ altindan script ile cagirmiyor")
+if re.search(r"rl_resolve[^\n]*\|\s*first\b", src):
+    problems.append("6: rl_resolve uzerinde `| first` var - bos listede Jinja patlar")
+if "+ ['']" not in src:
+    problems.append("6: regex_findall sonucuna [''] eklenmemis - bos listede [0] patlar")
+if src.count("rl_hint_text") < 3:
+    problems.append("6: rl_hint_text tanimlanip hem fail mesajina hem Teams'e girmiyor")
+if "Benzer Zone" not in src:
+    problems.append("6: Teams bildiriminde 'Benzer Zone' alani yok")
+if not re.search(r"shell: \|[\s\S]{0,400}resolve_zone_base", src):
+    pass  # gomulu kabuk yok - istenen bu
+if "resolve_zone_base.sh" in src and re.search(r"shell:\s*\|\s*\n\s*.*resolve_zone_base", src):
+    problems.append("6: betik gomulu shell blogundan cagriliyor; script modulu kullanilmali")
+
+if problems:
+    print("HATALAR:")
+    for p in problems:
+        print(" -", p)
+    sys.exit(1)
+print("OK: rate_limit_change yol->zone cozumlemesi ve yonergeler dogru")
-- 
