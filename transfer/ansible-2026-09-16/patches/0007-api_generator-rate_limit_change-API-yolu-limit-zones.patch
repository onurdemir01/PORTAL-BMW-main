--- /dev/null
+++ b/bmw_nginx/api_generator/operations/files/resolve_zone_base.sh
@@ -0,0 +1,86 @@
+#!/bin/bash
+# resolve_zone_base.sh — kullanicinin yazdigi API yolunu limit-zones.conf'taki GERCEK zone
+# adina eslestirir. Kullanim:  resolve_zone_base.sh <chosen_api> <limit_type> [limit-zones.conf]
+#
+# Neden var (2026-09-15): rate_limit_change'de zone adi kullanicinin yazdigi metinden
+# uretiliyordu ("<chosen_api>_rate_limit"). Sunucudaki zone adlarinin buyuk cogunlugu
+# sonda "/" TASIMAZ; kullanici "/x/y/v0/" yazinca "/x/y/v0/_rate_limit" aranip
+# "TANIMLI DEGIL" ile is duruyordu. Burada sirayla su adaylar denenir:
+#   1) yazildigi gibi          2) sondaki "/" atilmis        3) sonuna "/" eklenmis
+#   4) bastaki "/" atilmis     5) basina "/" eklenmis
+# ve limit-zones.conf'ta istenen tipte (_rate_limit / _location_limit) zone'u OLAN ilk
+# aday secilir. Hicbiri yoksa, benzer zone adlari (yolun govdesini iceren) listelenir ki
+# hata mesaji "ne yazmaliydim" sorusuna cevap versin.
+#
+# Cikti (Ansible bunu satir satir okur):
+#   RESOLVED=<zone govdesi ya da bos>
+#   NORMALIZED=yes|no          (girdi oldugu gibi mi kullanildi)
+#   SIMILAR=<virgulle ayrilmis benzer zone adlari, en fazla 8>
+# Her zaman 0 ile cikar; karar Ansible tarafinda verilir.
+
+set -u
+api="${1:-}"
+ltype="${2:-ip}"
+zones="${3:-/usr/nginx/conf.d/limit-zones.conf}"
+
+api="$(printf '%s' "$api" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
+
+# Tipe gore aranacak sonekler
+case "$ltype" in
+  ip)       suffixes="_rate_limit" ;;
+  location) suffixes="_location_limit" ;;
+  *)        suffixes="_rate_limit _location_limit" ;;
+esac
+
+# Adaylar (sira onemli; tekrarlar atilir)
+no_trail="${api%/}"
+with_trail="${no_trail}/"
+no_lead="${api#/}"
+with_lead="/${no_lead}"
+candidates=""
+for c in "$api" "$no_trail" "$with_trail" "$no_lead" "$with_lead" "${no_lead%/}" "/${no_lead%/}/"; do
+  [ -z "$c" ] && continue
+  case " $candidates " in *" $c "*) continue ;; esac
+  candidates="$candidates $c"
+done
+
+# Tanimli zone adlarinin listesi (bir kez okunur)
+if [ -r "$zones" ]; then
+  defined="$(grep -E '^[[:space:]]*limit_req_zone[[:space:]]+\S+[[:space:]]+zone=' "$zones" \
+    | grep -oE 'zone=[^:[:space:]]+' | sed 's/^zone=//' | sort -u)"
+else
+  defined=""
+fi
+
+has_zone() { # $1 = tam zone adi
+  printf '%s\n' "$defined" | grep -qxF -- "$1"
+}
+
+resolved=""
+for c in $candidates; do
+  for s in $suffixes; do
+    if has_zone "${c}${s}"; then resolved="$c"; break 2; fi
+  done
+done
+
+normalized=no
+if [ -n "$resolved" ] && [ "$resolved" != "$api" ]; then normalized=yes; fi
+
+# Benzerler: yolun govdesi (bas/son "/" atilmis, kucuk harf) zone adinda geciyorsa.
+core="$(printf '%s' "${no_lead%/}" | tr 'A-Z' 'a-z')"
+similar=""
+if [ -n "$core" ] && [ -n "$defined" ]; then
+  similar="$(printf '%s\n' "$defined" | grep -iF -- "$core" | head -8 | paste -sd, -)"
+fi
+# Govde bulunamadiysa son iki path parcasi ile de dene (v0 gibi tek parcalar anlamsiz)
+if [ -z "$similar" ] && [ -n "$defined" ]; then
+  tail2="$(printf '%s' "$core" | awk -F/ '{ n=NF; if (n>=2) print $(n-1); else print $n }')"
+  if [ -n "$tail2" ] && [ "${#tail2}" -ge 4 ]; then
+    similar="$(printf '%s\n' "$defined" | grep -iF -- "$tail2" | head -8 | paste -sd, -)"
+  fi
+fi
+
+printf 'RESOLVED=%s\n' "$resolved"
+printf 'NORMALIZED=%s\n' "$normalized"
+printf 'SIMILAR=%s\n' "$similar"
+exit 0
