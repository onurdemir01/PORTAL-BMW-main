+# ----------------------------------------------------------------------------- format
+INDENT = "    "
+
+
+def squeeze_ws(line):
+    """Tirnak DISINDAKI bosluk kosularini tek bosluga indirir; satir sonu yorumunu korur."""
+    out = []
+    q = None
+    prev_space = False
+    i = 0
+    while i < len(line):
+        ch = line[i]
+        if q:
+            out.append(ch)
+            if ch == q:
+                q = None
+            i += 1
+            continue
+        if ch in ("'", '"'):
+            q = ch
+            out.append(ch)
+            prev_space = False
+            i += 1
+            continue
+        if ch == "#":
+            out.append(line[i:].rstrip())
+            break
+        if ch in (" ", "\t"):
+            if not prev_space:
+                out.append(" ")
+            prev_space = True
+            i += 1
+            continue
+        out.append(ch)
+        prev_space = False
+        i += 1
+    return "".join(out).strip()
+
+
+def format_lines(lines):
+    """"Asker gibi" duzen (kullanici, 2026-09-16): 4 bosluk girinti (parantez derinligine
+    gore), satir ici bosluklar tek boslukta, sondaki bosluk yok, ardisik bos satirlar
+    tek bos satira iner, blok basi/sonunda bos satir yok, ust duzey bloklar (upstream /
+    server / location) arasinda bir bos satir. Satirlarin ICERIGI (direktif, deger,
+    yorum) degismez; yalnizca bosluk/girinti. Kapanmayan `;` (cok satirli direktif,
+    log_format gibi) devam satirlari bir seviye iceri.
+    """
+    out = []
+    depth = 0
+    cont = False          # onceki satir direktifi bitirmedi (; { } yok)
+    for raw in lines:
+        s = squeeze_ws(raw)
+        if s == "":
+            if out and out[-1] != "" and not out[-1].rstrip().endswith("{"):
+                out.append("")
+            continue
+        code = strip_comment(s).strip()
+        closes = code.startswith("}")
+        if closes:
+            depth = max(0, depth - 1)
+            # blok kapanisindan once bos satir olmaz
+            while out and out[-1] == "":
+                out.pop()
+        level = depth + (1 if (cont and not closes and not code.startswith("{")) else 0)
+        # ust duzey blok basliklari arasina bos satir (dosya basinda degil)
+        opens = code.endswith("{")
+        if depth == 0 and opens and out and out[-1] != "":
+            out.append("")
+        out.append(INDENT * level + s)
+        # parantez dengesi (yorum disi)
+        delta = code.count("{") - code.count("}")
+        if closes:
+            delta += 1   # kapanisi zaten dustuk
+        depth = max(0, depth + delta)
+        if code == "" or code.startswith("#"):
+            pass
+        else:
+            cont = not (code.endswith(";") or code.endswith("{") or code.endswith("}"))
+    while out and out[-1] == "":
+        out.pop()
+    return out
+
