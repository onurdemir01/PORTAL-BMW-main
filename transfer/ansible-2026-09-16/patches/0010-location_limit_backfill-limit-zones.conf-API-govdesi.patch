From a159bbfa5a22390413688be5fcaa37febf1eb9fe Mon Sep 17 00:00:00 2001
From: Onur Demir <demir-onur@hotmail.com>
Date: Tue, 15 Sep 2026 23:16:34 +0300
Subject: [PATCH 10/22] location_limit_backfill: limit-zones.conf API govdesine
 gore siralanir (ip ustte, location altta)

- satirlar degismez, yalniz yer degistirir; yorum iceren dosyada siralama atlanir (NOTE SORT)
- ll_sort_zones=false ile kapatilir; sirali dosyada tekrar degisiklik yok (idempotent)
- dump: 499 -> 531 satir, icerik kumesi birebir

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 bmw_nginx/api_generator/README.md             |  6 +++
 .../api_generator/location_limit_backfill.yml |  5 ++-
 .../files/location_limit_backfill.sh          | 41 ++++++++++++++++++-
 .../tests/check_location_limit_backfill.py    | 25 ++++++++++-
 4 files changed, 72 insertions(+), 5 deletions(-)

diff --git a/bmw_nginx/api_generator/README.md b/bmw_nginx/api_generator/README.md
index a8fe3bcfb..20490eb20 100644
--- a/bmw_nginx/api_generator/README.md
+++ b/bmw_nginx/api_generator/README.md
@@ -162,6 +162,12 @@ eklenir (`ll_rate` / `ll_mem` / `ll_burst` ile değiştirilebilir). `limit_req`
 kapatmış olabilir → varsayılan **atlanır**, Teams/özet çıktısında `COMMENTED` olarak
 raporlanır; `-e include_commented=true` ile onlar da eklenir.
 
+**`limit-zones.conf` sıralaması:** apply'da dosya API gövdesine göre alfabetik dizilir; her
+API'nin ip (`_rate_limit`) satırı hemen üstte, location (`_location_limit`) satırı hemen
+altta olur. Satırlar değiştirilmez, yalnız yer değiştirir; dosyada `limit_req_zone` dışında
+bir satır (yorum) varsa sıralama atlanır ve raporlanır. `ll_sort_zones=false` ile kapatılır.
+`create.yaml` yeni API'yi yine dosya sonuna ekler; bir sonraki backfill koşusu yerine oturtur.
+
 Güvenlik: apply'da değişen her dosyanın `.ll-bak.<ts>` yedeği alınır; `nginx -t` düşerse
 tüm dosyalar (limit-zones.conf dahil) geri alınır, reload yapılmaz, host FAIL olur.
 
diff --git a/bmw_nginx/api_generator/location_limit_backfill.yml b/bmw_nginx/api_generator/location_limit_backfill.yml
index b41cb8a6a..67f2a28ed 100644
--- a/bmw_nginx/api_generator/location_limit_backfill.yml
+++ b/bmw_nginx/api_generator/location_limit_backfill.yml
@@ -15,7 +15,8 @@
 # YORUMLU location_limit'li bloklar (BAKARKGW gibi) varsayilan ATLANIR ve raporlanir;
 # -e include_commented=true ile onlar da eklenir.
 # DEGERLER: rate/mem/burst varsayilani mevcut tanimlarla ayni (300r/s, 10m, burst=10);
-# -e "ll_rate=300r/s ll_mem=10m ll_burst=10" ile degistirilebilir.
+# -e "ll_rate=300r/s ll_mem=10m ll_burst=10" ile degistirilebilir. limit-zones.conf API
+# govdesine gore SIRALANIR (ip ustte, location altta); -e ll_sort_zones=false kapatir.
 
 - name: "--- location_limit geriye donuk ekleme (API gateway) ---"
   # Production API gateway: Pendik GBNGWP01-16 + GBNGWP25-32, Ankara GBNGWAP01-08 + GBNGWAP22-25.
@@ -30,6 +31,7 @@
     ll_rate: "300r/s"
     ll_mem: "10m"
     ll_burst: "10"
+    ll_sort_zones: true
   tasks:
     - name: --- [Task] Mod dogrula ---
       ansible.builtin.assert:
@@ -56,6 +58,7 @@
         LL_MEM: "{{ ll_mem }}"
         LL_BURST: "{{ ll_burst }}"
         LL_INCLUDE_COMMENTED: "{{ '1' if (include_commented | bool) else '0' }}"
+        LL_SORT_ZONES: "{{ '1' if (ll_sort_zones | bool) else '0' }}"
       register: ll
       changed_when: (mode | lower) == 'apply' and ('RESULT\tOK' in ll.stdout)
       failed_when: ll.rc not in [0, 3]
diff --git a/bmw_nginx/api_generator/operations/files/location_limit_backfill.sh b/bmw_nginx/api_generator/operations/files/location_limit_backfill.sh
index d368f2178..45fa35d26 100644
--- a/bmw_nginx/api_generator/operations/files/location_limit_backfill.sh
+++ b/bmw_nginx/api_generator/operations/files/location_limit_backfill.sh
@@ -30,11 +30,12 @@
 #   varsayilan conf_glob : /usr/nginx/conf.d/*-apis/*.conf   (kanal bagimsiz)
 #   varsayilan zones_file: /usr/nginx/conf.d/limit-zones.conf
 # ORTAM: LL_RATE (300r/s) LL_MEM (10m) LL_BURST (10) LL_INCLUDE_COMMENTED (0)
-#        LL_NGINX (/usr/nginx/sbin/nginx)
+#        LL_SORT_ZONES (1: limit-zones.conf API govdesine gore siralanir) LL_NGINX (/usr/nginx/sbin/nginx)
 #
 # CIKTI (stdout, TAB ayrilmis):
 #   FILE     <ADD|HAS|COMMENTED|SKIP|ERR>  <dosya>  <eklenen satir sayisi>
 #   ZONE     <ADD|HAS>           <base>
+#   ZONES    SORT                <aciklama>   (limit-zones.conf siralanacak / siralandi)
 #   NOTE     COMMENTED <dosya> <aciklama>   (yorumlu location_limit'li bloklar)
 #   SUMMARY  <toplam dosya> <degisen dosya> <eklenen location satiri> <zaten tam> <limit_req'siz> <eklenen zone> <yorumlu atlanan blok>
 #   RESULT   <OK|ROLLBACK|-> <aciklama>
@@ -174,13 +175,49 @@ if [ "$MODE" = "apply" ] && [ "$zones_added" -gt 0 ]; then
   changed_files="$changed_files $ZONES"
 fi
 
+# limit-zones.conf SIRALAMA (kullanici istegi 2026-09-15: "her API icin sirali dizilsin"):
+# satirlar API govdesine (zone adinin _rate_limit/_location_limit oneki) gore alfabetik,
+# her API'nin ip (rate) satiri hemen ustte, location satiri hemen altta. Satirlar
+# DEGISTIRILMEZ, yalnizca yer degistirir; bos satirlar atilir. Dosyada limit_req_zone
+# disinda bir satir (yorum vb.) varsa siralama yapilmaz, NOTE ile raporlanir (icerik kaybi
+# riski). LL_SORT_ZONES=0 ile kapatilir. Yeni API (create.yaml) satiri yine sona ekler;
+# bir sonraki backfill kosusunda yerine oturur.
+sort_zones() { # $1 = dosya -> stdout: sirali icerik
+  awk '
+    /^[[:space:]]*limit_req_zone[[:space:]]/ {
+      z = $0; sub(/^.*zone=/, "", z); sub(/:.*$/, "", z)
+      ord = 2; base = z
+      if (z ~ /_rate_limit$/)          { ord = 0; sub(/_rate_limit$/, "", base) }
+      else if (z ~ /_location_limit$/) { ord = 1; sub(/_location_limit$/, "", base) }
+      printf "%s\t%d\t%s\n", base, ord, $0
+    }
+  ' "$1" | LC_ALL=C sort -t "$(printf '\t')" -k1,1 -k2,2n | cut -f3-
+}
+zones_sorted=0
+if [ "${LL_SORT_ZONES:-1}" = "1" ]; then
+  if grep -vqE '^[[:space:]]*(limit_req_zone[[:space:]]|$)' "$ZONES"; then
+    printf 'NOTE\tSORT\tlimit-zones.conf icinde limit_req_zone disinda satir var (yorum?), siralama ATLANDI\n'
+  else
+    sorted="$(sort_zones "$ZONES")"
+    if [ "$sorted" != "$(grep -E '^[[:space:]]*limit_req_zone[[:space:]]' "$ZONES")" ]; then
+      zones_sorted=1
+      printf 'ZONES\tSORT\t%s sirali degil -> API govdesine gore siralanacak (ip ustte, location altta)\n' "$ZONES"
+      if [ "$MODE" = "apply" ]; then
+        [ -f "$ZONES.ll-bak.$TS" ] || cp -p "$ZONES" "$ZONES.ll-bak.$TS"
+        printf '%s\n' "$sorted" > "$ZONES"
+        case " $changed_files " in *" $ZONES "*) ;; *) changed_files="$changed_files $ZONES" ;; esac
+      fi
+    fi
+  fi
+fi
+
 printf 'SUMMARY\t%d\t%d\t%d\t%d\t%d\t%d\t%d\n' "$total" "$changed" "$lines_added" "$has" "$skip" "$zones_added" "$commented_blocks"
 [ "$err" -gt 0 ] && printf 'NOTE\tERR\t%d dosyada hata\n' "$err"
 
 if [ "$MODE" = "apply" ] && [ -n "$changed_files" ]; then
   if dzdo "$NGINX_BIN" -p /usr/nginx/ -c /usr/nginx/nginx.conf -e /web_log/error.log -t >/tmp/ll_nginx_t.$$ 2>&1; then
     dzdo "$NGINX_BIN" -p /usr/nginx/ -c /usr/nginx/nginx.conf -e /web_log/error.log -s reload
-    printf 'RESULT\tOK\t%d dosya + %d zone degisti, nginx -t gecti, reload yapildi\n' "$changed" "$zones_added"
+    printf 'RESULT\tOK\t%d dosya + %d zone degisti%s, nginx -t gecti, reload yapildi\n' "$changed" "$zones_added" "$([ "$zones_sorted" = 1 ] && echo ', limit-zones.conf siralandi')"
     rm -f /tmp/ll_nginx_t.$$
     exit 0
   else
diff --git a/bmw_nginx/tests/check_location_limit_backfill.py b/bmw_nginx/tests/check_location_limit_backfill.py
index 9fdf5676c..91d167fe9 100644
--- a/bmw_nginx/tests/check_location_limit_backfill.py
+++ b/bmw_nginx/tests/check_location_limit_backfill.py
@@ -12,6 +12,8 @@ Kilitlenen iddialar (betik GERCEKTEN kosturulur, Git Bash):
      LL_INCLUDE_COMMENTED=1 ile eklenir.
   4. report modu hicbir dosyayi degistirmez; apply yedek birakir; ikinci kosu idempotent.
   5. nginx -t duserse tum degisen dosyalar (limit-zones.conf dahil) geri alinir, cikis 3.
+  7. limit-zones.conf API govdesine gore siralanir (ip ustte, location altta); yorum iceren
+     dosya siralanmaz (NOTE SORT); sirali dosyada tekrar bildirim yok.
   6. playbook betigi files/ altindan kopyalayip calistirir (gomulu shell yok), 36 prod
      API gateway sunucusu README §1 ile ayni.
 """
@@ -131,8 +133,17 @@ if rd("COMMENTED.conf") != commented:
 if rd("servicepingssl.conf") != "location = /servicePing/ssl/ {\n  return 200;\n}\n":
     problems.append("2: limit_req'siz dosyaya dokunuldu")
 z = io.open(zones, encoding="utf-8").read()
-if not z.endswith("limit_req_zone $server_name zone=%s_location_limit:10m rate=300r/s;\n" % B1):
-    problems.append("1: zone tanimi limit-zones.conf sonuna eklenmedi:\n" + z)
+# 7) SIRALAMA: API govdesine gore alfabetik, her API'nin ip satiri ustte location altta;
+#    icerik kumesi ayni, satirlar degismemis (kullanici istegi: "her api icin sirali").
+exp_sorted = (
+    "limit_req_zone $binary_remote_addr zone=%s_rate_limit:10m rate=50r/s;\n" % B1
+    + "limit_req_zone $server_name zone=%s_location_limit:10m rate=300r/s;\n" % B1
+    + "limit_req_zone $binary_remote_addr zone=%s_rate_limit:10m rate=50r/s;\n" % B2
+    + "limit_req_zone $server_name zone=%s_location_limit:10m rate=300r/s;\n" % B2
+    + "limit_req_zone $binary_remote_addr zone=%s_rate_limit:10m rate=50r/s;\n" % B3
+)
+if z != exp_sorted:
+    problems.append("7: limit-zones.conf API govdesine gore siralanmadi (ip ustte, location altta):\n" + z)
 if z.count("_location_limit:") != 2:
     problems.append("1: zone sayisi yanlis (B2 zaten vardi, B1 eklenmeli, B3 yorumlu-atlanan icin de eklenmemeli? -> %d)" % z.count("_location_limit:"))
 if not [f for f in os.listdir(apis) if ".ll-bak." in f]:
@@ -152,6 +163,16 @@ z = io.open(zones, encoding="utf-8").read()
 if z.count("_location_limit:") != 3:
     problems.append("3: yorumlu blok eklenince zone da eklenmeli (%d)" % z.count("_location_limit:"))
 
+# 7b) yorum satiri olan zone dosyasi SIRALANMAZ (icerik kaybi riski), NOTE SORT
+zc = io.open(zones, encoding="utf-8").read()
+io.open(zones, "w", newline="\n").write("# elle eklenen yorum\n" + zc)
+r = run("report")
+if "NOTE\tSORT\t" not in r.stdout:
+    problems.append("7b: yorumlu zone dosyasinda siralama atlanmadi/raporlanmadi")
+io.open(zones, "w", newline="\n").write(zc)
+if "ZONES\tSORT" in run("report").stdout:
+    problems.append("7c: sirali dosya icin gereksiz siralama bildirildi (idempotent degil)")
+
 # 5) rollback
 io.open(os.path.join(apis, "MISSING2.conf"), "w", newline="\n").write(hdr("/d/four/v0") + BLOCK.format(path="/d/four/v0/x", base="/d/four/v0", burst=10, extra=""))
 zbefore = io.open(zones, encoding="utf-8").read()
