From ba774b17e708bfb819e29f2ad64734d1bbec8abc Mon Sep 17 00:00:00 2001
From: Onur Demir <demir-onur@hotmail.com>
Date: Wed, 16 Sep 2026 00:20:23 +0300
Subject: [PATCH 19/22] nginx_legacy_sync: REPLACE/DIFF_LOCATION raporunda
 'cogunluk' yerine gercek referans sunucu adi

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 bmw_nginx/nginx_legacy_sync/files/legacy_sync_plan.py | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/bmw_nginx/nginx_legacy_sync/files/legacy_sync_plan.py b/bmw_nginx/nginx_legacy_sync/files/legacy_sync_plan.py
index 112c3dc56..97787b3b6 100644
--- a/bmw_nginx/nginx_legacy_sync/files/legacy_sync_plan.py
+++ b/bmw_nginx/nginx_legacy_sync/files/legacy_sync_plan.py
@@ -374,6 +374,11 @@ class Host(object):
 REFERENCE_HOST = ""
 
 
+def ref_label():
+    """Raporda 'kimin surumu' yazsin: referans sunucu verildiyse adi, yoksa 'cogunluk'."""
+    return ("referans " + REFERENCE_HOST) if REFERENCE_HOST else "eslenik cogunlugu"
+
+
 def majority(versions):
     """[(host, norm, raw_lines)] -> referans varsa onun surumu; yoksa cogunluktaki
     (norm, raw_lines). Esitlikte alfabetik ilk sunucunun surumu ("ilk sunucu dogru"
@@ -608,9 +613,9 @@ def plan_group(gname, hosts, strict=False, fix_upstreams=False, scope="all", fmt
                                 loc = next(l for l in srv["locations"] if l["key"] == key)
                                 h.files[vname][loc["start"]:loc["end"] + 1] = list(ref_raw)
                                 h.changed.add(vname)
-                                h.act("REPLACE_LOCATION", service, "location %s cogunluk surumuyle degistirildi" % key)
+                                h.act("REPLACE_LOCATION", service, "location %s %s surumuyle degistirildi" % (key, ref_label()))
                             else:
-                                h.act("DIFF_LOCATION", service, "location %s govdesi eslenik cogunlugundan farkli (strict ile degistirilir)" % key)
+                                h.act("DIFF_LOCATION", service, "location %s govdesi %s surumunden farkli (strict ile degistirilir)" % (key, ref_label()))
 
     if fmt:
         for h in hosts:
-- 
