From ae2d0166594c2eddd3c98b314dafb8befd30926a Mon Sep 17 00:00:00 2001
From: Onur Demir <demir-onur@hotmail.com>
Date: Tue, 15 Sep 2026 23:39:02 +0300
Subject: [PATCH 14/22] nginx_legacy_sync: scope=upstreams eslenik gerektirmez
 - target_hosts'taki her sunucu tek basina

- peer_hosts yoksa her sunucu ayri (TEK:<host>) islenir: proxy_pass FQDN->upstream, eksik
  upstream <servis>-prod-upstreams.conf'a; grup/referans sarti yok
- dokum kapsami scope=upstreams'te target_hosts; README/ornekler; test 11

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 bmw_nginx/nginx_legacy_sync/README.md         | 20 +++++++++++++------
 .../files/legacy_sync_plan.py                 | 13 ++++++++++--
 .../nginx_legacy_sync/nginx_legacy_sync.yml   |  8 +++++++-
 bmw_nginx/tests/check_legacy_sync.py          | 18 +++++++++++++++++
 4 files changed, 50 insertions(+), 9 deletions(-)

diff --git a/bmw_nginx/nginx_legacy_sync/README.md b/bmw_nginx/nginx_legacy_sync/README.md
index a7bb62546..6a5d71ddd 100644
--- a/bmw_nginx/nginx_legacy_sync/README.md
+++ b/bmw_nginx/nginx_legacy_sync/README.md
@@ -82,6 +82,12 @@ ikinci koşu hiçbir dosyayı değiştirmez.
 Önerilen sıra: önce `scope=upstreams` (küçük, mekanik değişiklik), raporunu gör, uygula;
 sonra `scope=locations`.
 
+**`scope=upstreams` eşlenik gerektirmez.** `peer_hosts` vermezsen `target_hosts`'taki her
+sunucu **tek başına** işlenir: kendi `proxy_pass`'leri düzeltilir, kendi dosyalarında
+tanımı olmayan upstream `<servis>-prod-upstreams.conf` dosyasına (örn.
+`/usr/nginx/conf.d/glomo-prod-upstreams.conf`; dosya yoksa vhost başına) eklenir.
+Referans/çoğunluk kavramı yoktur; döküm de yalnız o sunuculardan alınır.
+
 ## 2b. Referans hangi sunucu?
 
 Varsayılan **çoğunluk**: bir location/upstream'in gruptaki sürümleri sayılır, en çok
@@ -112,12 +118,14 @@ küme** verilir (örn. önce yalnız Ankara GLOMO); döküm ve uygulama da yaln
 Örnek — önce yalnız Ankara GLOMO, referans GBRVPAP03, önce upstream işi sonra eşitleme:
 
 ```
-# 1. adım: upstream düzeltmesi
--e "mode=report scope=upstreams peer_hosts=GBRVPAP03,GBRVPAP04,GBRVPAP05,GBRVPAP06 reference=GBRVPAP03"
--e "mode=apply  scope=upstreams peer_hosts=GBRVPAP03,GBRVPAP04,GBRVPAP05,GBRVPAP06 reference=GBRVPAP03 target_hosts=GBRVPAP04"
--e "mode=apply  scope=upstreams peer_hosts=GBRVPAP03,GBRVPAP04,GBRVPAP05,GBRVPAP06 reference=GBRVPAP03"
-# 2. adım: location eşitleme
--e "mode=report scope=locations peer_hosts=... reference=GBRVPAP03"   # sonra apply
+# 1. adım: upstream düzeltmesi (eşlenik gerekmez, sunucu başına)
+-e "mode=report scope=upstreams target_hosts=GBRVPAP04"
+-e "mode=apply  scope=upstreams target_hosts=GBRVPAP04"
+-e "mode=apply  scope=upstreams target_hosts=GBRVPAP03,GBRVPAP04,GBRVPAP05,GBRVPAP06"
+# 2. adım: location eşitleme (eşlenik + referans)
+-e "mode=report scope=locations peer_hosts=GBRVPAP03,GBRVPAP04,GBRVPAP05,GBRVPAP06 reference=GBRVPAP03"
+-e "mode=apply  scope=locations peer_hosts=GBRVPAP03,GBRVPAP04,GBRVPAP05,GBRVPAP06 reference=GBRVPAP03 target_hosts=GBRVPAP04"
+-e "mode=apply  scope=locations peer_hosts=GBRVPAP03,GBRVPAP04,GBRVPAP05,GBRVPAP06 reference=GBRVPAP03"
 ```
 
 `apply`: her dosya `backup: yes` ile yazılır, `nginx -t` (plus/OSS ayrımı
diff --git a/bmw_nginx/nginx_legacy_sync/files/legacy_sync_plan.py b/bmw_nginx/nginx_legacy_sync/files/legacy_sync_plan.py
index 1dc634398..d403780f7 100644
--- a/bmw_nginx/nginx_legacy_sync/files/legacy_sync_plan.py
+++ b/bmw_nginx/nginx_legacy_sync/files/legacy_sync_plan.py
@@ -38,7 +38,9 @@ KURALLAR (sira onemli):
      kopyalanir, --strict ile farklilar ona esitlenir). --hosts A,B,C: PEER_GROUPS yerine
      ozel eslenik kumesi (or. once yalniz GBRVPAP03-06).
   7. --scope upstreams|locations|all: yalniz upstream isi (kural 1-2) / yalniz location
-     esitleme (kural 3-4) / hepsi (varsayilan).
+     esitleme (kural 3-4) / hepsi (varsayilan). scope=upstreams'te (--hosts yoksa) her
+     sunucu TEK BASINA islenir: eslenik/referans gerekmez; eksik upstream o sunucunun
+     <servis>-prod-upstreams.conf dosyasina (yoksa vhost basina) yazilir.
 
 CIKTI (report.txt / actions):  ACTION  HOST  SERVIS  DETAY
   REWRITE_PROXY_PASS  ADD_SSL_NAME  ADD_HOST_HEADER  ADD_UPSTREAM  ADD_LOCATION
@@ -484,6 +486,11 @@ def main():
     if a.hosts.strip():
         # Ozel kume: yalniz bu sunucular birbirine esitlenir (or. once GBRVPAP03-06 arasi).
         groups = {"OZEL": [x.strip().upper() for x in a.hosts.split(",") if x.strip()]}
+    if a.scope == "upstreams" and not a.hosts.strip():
+        # UPSTREAM ISI ESLENIK GEREKTIRMEZ (kullanici, 2026-09-15): her taranan sunucu TEK
+        # BASINA islenir - kendi proxy_pass'leri duzeltilir, kendi dosyasinda olmayan
+        # upstream tanimlanir. Referans/cogunluk kavrami yoktur.
+        groups = {("TEK:" + n): [n] for n in sorted(hosts_by_name)}
     if REFERENCE_HOST and not any(REFERENCE_HOST in m for m in groups.values()):
         print("NOTE\treferans sunucu %s hicbir grupta degil - cogunluk kurali uygulanir" % REFERENCE_HOST)
     for g, members in groups.items():
@@ -495,9 +502,11 @@ def main():
             scanned[g] = [h.name for h in hosts]
             continue
         scanned[g] = [h.name for h in hosts]
-        if len(hosts) < 2:
+        if len(hosts) < 2 and a.scope != "upstreams":
             print("NOTE\tgrup %s: %d sunucu tarandi, esitleme icin en az 2 gerekir - atlandi" % (g, len(hosts)))
             continue
+        if not hosts:
+            continue
         plan_group(g, hosts, strict=a.strict, fix_upstreams=a.fix_upstreams, scope=a.scope)
         for h in hosts:
             files = [{"path": "%s/%s" % (CONF_DIR, f), "content": "\n".join(h.files[f]).rstrip("\n") + "\n"} for f in sorted(h.changed)]
diff --git a/bmw_nginx/nginx_legacy_sync/nginx_legacy_sync.yml b/bmw_nginx/nginx_legacy_sync/nginx_legacy_sync.yml
