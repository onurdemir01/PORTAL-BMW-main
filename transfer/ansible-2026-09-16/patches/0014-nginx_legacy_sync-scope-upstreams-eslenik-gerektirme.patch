+#   scope=upstreams: peer_hosts GEREKMEZ - target_hosts'taki her sunucu tek basina islenir
+#   (proxy_pass duzeltme + eksik upstream'i <servis>-prod-upstreams.conf'a ekleme).
 # ONERILEN SIRA: mode=report -> report.txt oku -> mode=apply target_hosts=<tek sunucu> -> tumu.
 
 - name: "--- [Play] Legacy sync - hazirlik ---"
@@ -51,8 +53,12 @@
       ignore_errors: true
 
 - name: "--- [Play] Legacy sync - dokum (salt-okunur) ---"
+  # DOKUM KAPSAMI: peer_hosts verildiyse o kume; scope=upstreams'te eslenik gerekmedigi icin
+  # yalniz target_hosts (verildiyse); aksi halde 12 sunucunun tumu.
   hosts: >-
-    {{ peer_hosts | default('GBRVPP01,GBRVPP02,GBRVPAP01,GBRVPAP02,GBRVPP07,GBRVPP08,GBRVPP09,GBRVPP10,GBRVPAP03,GBRVPAP04,GBRVPAP05,GBRVPAP06') }}
+    {{ peer_hosts | default(
+         (target_hosts | default('')) if ((scope | default('all')) == 'upstreams' and (target_hosts | default('') | length) > 0)
+         else 'GBRVPP01,GBRVPP02,GBRVPAP01,GBRVPAP02,GBRVPP07,GBRVPP08,GBRVPP09,GBRVPP10,GBRVPAP03,GBRVPAP04,GBRVPAP05,GBRVPAP06', true) }}
   gather_facts: no
   ignore_unreachable: true
   vars:
diff --git a/bmw_nginx/tests/check_legacy_sync.py b/bmw_nginx/tests/check_legacy_sync.py
index f4fce6dfb..da6f4478c 100644
--- a/bmw_nginx/tests/check_legacy_sync.py
+++ b/bmw_nginx/tests/check_legacy_sync.py
@@ -213,6 +213,24 @@ if any(a["action"] in ("REWRITE_PROXY_PASS", "ADD_UPSTREAM") for a in l6["action
 if "location /only2/ {" not in l6f.get("WEBFORMS-PROD.conf", ""):
     problems.append("10: scope=locations eksik location'i eklemedi")
 
+# 11) scope=upstreams --hosts OLMADAN: her sunucu tek basina; grup sarti yok; upstream
+#     kendi -upstreams.conf dosyasina; eslenikten hicbir sey gelmez
+raw7 = os.path.join(tmp, "raw7"); plan7 = os.path.join(tmp, "plan7"); os.makedirs(raw7)
+write_raw(raw7, "GBRVPAP04", H1)   # tek sunucu, grup uyesi ama yalniz
+r7 = run_plan(raw7, plan7, "--scope", "upstreams")
+if not os.path.exists(os.path.join(plan7, "GBRVPAP04.json")):
+    problems.append("11: tek sunucu scope=upstreams'te plan uretmedi (grup sarti hala var?)\n" + r7.stdout)
+else:
+    t7 = load(plan7, "GBRVPAP04"); t7f = {os.path.basename(f["path"]): f["content"] for f in t7["files"]}
+    if "proxy_pass      https://fq-app-v0-ns/;" not in t7f.get("WEBFORMS-PROD.conf", ""):
+        problems.append("11: tek sunucuda FQDN proxy_pass duzeltilmedi")
+    if not t7f.get("webforms-prod-upstreams.conf", "").startswith("upstream "):
+        problems.append("11: eksik upstream -upstreams.conf dosyasina eklenmedi")
+    if "location /only2/" in t7f.get("WEBFORMS-PROD.conf", ""):
+        problems.append("11: eslenik olmadan location eklendi")
+    if not t7.get("group", "").startswith("TEK:"):
+        problems.append("11: grup etiketi TEK: olmali (%s)" % t7.get("group"))
+
 # rapor + ozet
 if not os.path.exists(os.path.join(plan, "report.txt")):
     problems.append("report.txt yok")
