+++ b/bmw_nginx/nginx_metadata/files/generate_nginx_metadata.sh
@@ -188,25 +188,44 @@ fi
 ###############################################################################
 # Environment detection
 #
-# At least one *-PROD.conf or *-PRODUCTION.conf:
-#   env=production
+# 2026-09-15 DUZELTME (Portal > Denetim > Nginx Envanteri: prod/non-prod sayilari
+# yanlisti). Onceki kural YALNIZCA "*-PROD.conf vhost var mi" idi; servis vhost'u
+# olmayan prod sunucular (intranet SPA GBNGXP50-53/AP50-51, yeni prod SPA GBNGXP4x/5x,
+# API gateway GBNGWP*) non-production sayiliyordu.
 #
-# Otherwise:
-#   env=non-production
-###############################################################################
-
-ENVIRONMENT="non-production"
-
-if (( CONFIG_COUNT > 0 )); then
-    for conf_file in "${CONF_FILES[@]}"; do
-        conf_name="$(basename "$conf_file")"
+# Simdi ONCE SUNUCU ADI KALIBI (Portal nginx-hosts.cjs ile ayni):
+#   GBRVP*                       -> production   (reverse proxy prod, harf tasimaz)
+#   GBNG[WX](A)?P<rakam>          -> production   (gateway/reverse proxy prod, A=Ankara)
+#   GBNG[WX](A)?[DTQ]<rakam>      -> non-production
+# Kalip tutmuyorsa eski vhost kurali yedek olarak kalir. Istisna: GBNGXT51 adi
+# 'T' der ama EDU ortamidir - Portal bunu bilir; burada non-production kalir.
+###############################################################################
+
+ENVIRONMENT=""
+HOST_UPPER="$(printf '%s' "${HOSTNAME_SHORT}" | tr '[:lower:]' '[:upper:]')"
+
+if [[ "$HOST_UPPER" =~ ^GBRVP ]]; then
+    ENVIRONMENT="production"
+elif [[ "$HOST_UPPER" =~ ^GBNG[WX]A?P[0-9] ]]; then
+    ENVIRONMENT="production"
+elif [[ "$HOST_UPPER" =~ ^GBNG[WX]A?[DTQ][0-9] ]]; then
+    ENVIRONMENT="non-production"
+fi
 
-        if [[ "$conf_name" =~ -PROD\.conf$ ]] ||
-           [[ "$conf_name" =~ -PRODUCTION\.conf$ ]]; then
-            ENVIRONMENT="production"
-            break
-        fi
-    done
+# Yedek: ad kalibi tutmayan sunucularda vhost dosya adina bak (eski kural).
+if [[ -z "$ENVIRONMENT" ]]; then
+    ENVIRONMENT="non-production"
+    if (( CONFIG_COUNT > 0 )); then
+        for conf_file in "${CONF_FILES[@]}"; do
+            conf_name="$(basename "$conf_file")"
+
+            if [[ "$conf_name" =~ -PROD\.conf$ ]] ||
+               [[ "$conf_name" =~ -PRODUCTION\.conf$ ]]; then
+                ENVIRONMENT="production"
+                break
+            fi
+        done
+    fi
 fi
 
 ###############################################################################
diff --git a/bmw_nginx/tests/check_metadata_env.sh b/bmw_nginx/tests/check_metadata_env.sh
new file mode 100644
index 000000000..37d61ecf6
--- /dev/null
+++ b/bmw_nginx/tests/check_metadata_env.sh
@@ -0,0 +1,34 @@
+#!/bin/bash
+# tests/check_metadata_env.sh - generate_nginx_metadata.sh ortam kurali (2026-09-15).
+# Betikteki "Environment detection" blogunu cikarip sahte HOSTNAME_SHORT / CONF_FILES ile
+# GERCEKTEN kosturur. Beklentiler Portal nginx-hosts.cjs ile ayni.
+set -u
+SCRIPT="$(dirname "$0")/../nginx_metadata/files/generate_nginx_metadata.sh"
+BLOCK="$(awk '/^# Environment detection/{f=1} f{print} /^# Yedek: ad kalibi tutmayan/{g=1} g&&/^fi$/{exit}' "$SCRIPT")"
+[ -n "$BLOCK" ] || { echo "BULGU: ortam blogu cikarilamadi"; exit 1; }
+fail=0
+check() { # host  conf_dosyalari(bosluk ayrilmis, bos olabilir)  beklenen
+  local host="$1" confs="$2" want="$3" got
+  got="$(
+    HOSTNAME_SHORT="$host"; CONF_FILES=(); for c in $confs; do CONF_FILES+=("$c"); done; CONFIG_COUNT=${#CONF_FILES[@]}
+    eval "$BLOCK"; printf '%s' "$ENVIRONMENT"
+  )"
+  if [ "$got" != "$want" ]; then echo "BULGU: $host [$confs] -> beklenen $want, bulunan $got"; fail=1; fi
+}
+# prod: ad kalibi (vhost olmasa da)
+check GBNGXP50 ""                          production      # intranet prod SPA, servis vhost'u yok
+check GBNGXAP24 ""                         production      # yeni prod SPA (Ankara)
+check GBNGWP03 "apis.conf"                 production      # API gateway prod
+check GBRVPP07 "GLOMO-PROD.conf"           production
+check gbrvpap01 ""                         production      # kucuk harf
+# non-prod: ad kalibi (PROD adli dosya olsa bile)
+check GBNGXD01 "GLOMO-DEV.conf"            non-production
+check GBNGXT34 "WEBFORMS-PROD.conf"        non-production  # unutulmus prod adli dosya kaliba yenilemez
+check GBNGXQ50 ""                          non-production
+check GBNGXT51 ""                          non-production  # EDU: Portal istisnasi bilir
+# kalip disi: eski vhost kurali yedek
+check GBLABT02 "X-PROD.conf"               production
+check GBLABT02 "X-TEST.conf"               non-production
+check GBOTHER01 ""                         non-production
+[ "$fail" -eq 0 ] && echo "Temiz: ortam kurali sunucu adi kalibi + vhost yedegi (12 durum)."
+exit $fail
