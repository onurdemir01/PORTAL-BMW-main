+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""nginx_ops/intranet_vhost_backfill.sh: mevcut intranet vhost'larini yeni server_name /
+sertifika kuralina cevirir (2026-09-16). Betik GERCEKTEN kosturulur (Git Bash, sahte hostname).
+
+Kilitlenen iddialar:
+  1. non-prod (T50): <app>-<ns>.apps-t.fw... + wildcard.apps-t...localca; prod (P50):
+     <app>-<ns'-prod'suz>.apps.fw... + wildcard.apps...localca
+  2. app/namespace application-confs alias satirindan; flat deployment <app>.<alan>;
+     ad tutmayan dosya SKIP; include'suz servis vhost'u kapsam disi
+  3. sertifika yoksa hicbir dosya yazilmaz (cikis 4); report yazmaz; apply yedek + idempotent
+  4. nginx -t duserse geri alma (cikis 3); intranet olmayan host: kapsam disi (0 dosya)
+"""
+import io, os, subprocess, sys, tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+SCRIPT = os.path.join(os.path.dirname(HERE), "nginx_ops", "operations", "files", "intranet_vhost_backfill.sh")
+problems = []
+tmp = tempfile.mkdtemp(prefix="ivhb-")
+confd = os.path.join(tmp, "conf.d"); appc = os.path.join(confd, "application-confs"); ssl = os.path.join(tmp, "ssl"); fake = os.path.join(tmp, "bin")
+for d in (appc, ssl, fake): os.makedirs(d)
+W = lambda p, t: io.open(p, "w", newline="\n").write(t)
+VH = "server {\nlisten 10.0.0.1:443 ssl;\nserver_name %s.irp-test.garantibbva.com.tr;\nssl_certificate /usr/nginx/ssl/wildcard.mrp-test.garantibbva.com.tr.crt;\nssl_certificate_key /usr/nginx/ssl/wildcard.mrp-test.garantibbva.com.tr.key;\ninclude /usr/nginx/conf.d/application-confs/%s.conf;\n}\n"
+W(os.path.join(confd, "odeme-app-v1-digital-ch-prod.conf"), VH % ("odeme-app-v1-digital-ch-prod", "odeme-app-v1-digital-ch-prod"))
+W(os.path.join(appc, "odeme-app-v1-digital-ch-prod.conf"), "location /x {\n  alias /usr/nginx/applications/digital-ch-prod/odeme-app-v1/;\n}\n")
+W(os.path.join(confd, "eski-app.conf"), VH % ("eski-app", "eski-app"))
+W(os.path.join(appc, "eski-app.conf"), "location /x {\n  alias /usr/nginx/applications/eski-app/;\n}\n")
+W(os.path.join(confd, "tutmaz.conf"), VH % ("tutmaz", "tutmaz"))
+W(os.path.join(appc, "tutmaz.conf"), "location /x {\n  alias /usr/nginx/applications/baska-ns/baska-app/;\n}\n")
+W(os.path.join(confd, "GLOMO-TEST.conf"), "server {\nserver_name glomo.garanti.com.tr;\nlocation / { proxy_pass https://x/; }\n}\n")
+W(os.path.join(fake, "dzdo"), "#!/bin/bash\n[ -f \"$(dirname \"$0\")/fail\" ] && exit 1\nexit 0\n")
+
+
+def run(mode, host, with_cert=True):
+    for n in ("wildcard.apps.garanti.com.tr.localca", "wildcard.apps-t.garanti.com.tr.localca"):
+        for e in ("crt", "key"):
+            p = os.path.join(ssl, "%s.%s" % (n, e))
+            if with_cert: W(p, "x")
+            elif os.path.exists(p): os.remove(p)
+    env = dict(os.environ, PATH=fake.replace("\\", "/") + os.pathsep + os.environ.get("PATH", ""), IVH_SSL_DIR=ssl.replace("\\", "/"), IVH_NGINX=os.path.join(fake, "dzdo").replace("\\", "/"), MSYS="noglob")
+    sh = "hostname(){ echo %s; }\nsource '%s' %s '%s'" % (host, SCRIPT.replace("\\", "/"), mode, confd.replace("\\", "/"))
+    try:
+        return subprocess.run(["bash", "-c", sh], capture_output=True, text=True, encoding="utf-8", env=env)
+    except FileNotFoundError:
+        print("ATLANDI: bash yok"); sys.exit(0)
+
+
+rd = lambda n: io.open(os.path.join(confd, n), encoding="utf-8").read()
+# 3) sertifika yok -> cikis 4, dosya degismez
+r = run("apply", "GBNGXP50", with_cert=False)
+if r.returncode != 4 or "irp-test" not in rd("odeme-app-v1-digital-ch-prod.conf"):
+    problems.append("3: sertifika yokken dosya degisti ya da cikis 4 degil (rc=%s)\n%s" % (r.returncode, r.stdout))
+# report
+before = {n: rd(n) for n in os.listdir(confd) if n.endswith(".conf")}
+r = run("report", "GBNGXP50")
+if r.returncode != 0 or "SUMMARY\t3\t2\t0\t1" not in r.stdout:
+    problems.append("1/2: report ozeti beklenen SUMMARY 3 2 0 1 degil:\n" + r.stdout)
+if {n: rd(n) for n in before} != before:
+    problems.append("3: report dosya degistirdi")
+if "FILE\tSKIP\t" not in r.stdout or "tutmaz.conf" not in r.stdout:
+    problems.append("2: ad tutmayan dosya SKIP olmadi")
+if "GLOMO-TEST.conf" in r.stdout:
+    problems.append("2: include'suz servis vhost'u kapsama girdi")
+# apply prod
+r = run("apply", "gbngxp50")
+if r.returncode != 0 or "RESULT\tOK" not in r.stdout:
+    problems.append("apply basarisiz rc=%s\n%s" % (r.returncode, r.stdout))
+v = rd("odeme-app-v1-digital-ch-prod.conf")
+if "server_name odeme-app-v1-digital-ch.apps.fw.garanti.com.tr;" not in v:
+    problems.append("1: prod server_name yanlis (-prod atilmali):\n" + v)
+if "ssl_certificate %s/wildcard.apps.garanti.com.tr.localca.crt;" % ssl.replace("\\", "/") not in v:
+    problems.append("1: prod sertifika yanlis")
+f = rd("eski-app.conf")
+if "server_name eski-app.apps.fw.garanti.com.tr;" not in f:
+    problems.append("2: flat deployment server_name yanlis:\n" + f)
+if "irp-test" not in rd("tutmaz.conf"):
+    problems.append("2: SKIP dosyaya dokunuldu")
+if not [n for n in os.listdir(confd) if ".ivh-bak." in n]:
+    problems.append("3: yedek yok")
+# idempotent
+r = run("apply", "GBNGXP50")
+if "SUMMARY\t3\t0\t2\t1" not in r.stdout or "degisiklik yok" not in r.stdout:
+    problems.append("3: ikinci kosu idempotent degil:\n" + r.stdout)
+# non-prod host: apps-t, -prod atilmaz
+W(os.path.join(confd, "odeme-app-v1-digital-ch-test.conf"), VH % ("odeme-app-v1-digital-ch-test", "odeme-app-v1-digital-ch-test"))
+W(os.path.join(appc, "odeme-app-v1-digital-ch-test.conf"), "location /x {\n  alias /usr/nginx/applications/digital-ch-test/odeme-app-v1/;\n}\n")
+r = run("apply", "GBNGXT50")
+t = rd("odeme-app-v1-digital-ch-test.conf")
+if "server_name odeme-app-v1-digital-ch-test.apps-t.fw.garanti.com.tr;" not in t or "wildcard.apps-t.garanti.com.tr.localca.crt;" not in t:
+    problems.append("1: non-prod server_name/sertifika yanlis:\n" + t)
+# 4) rollback
+W(os.path.join(confd, "yeni-app-v0-ns-x.conf"), VH % ("yeni-app-v0-ns-x", "yeni-app-v0-ns-x"))
+W(os.path.join(appc, "yeni-app-v0-ns-x.conf"), "location /x {\n  alias /usr/nginx/applications/ns-x/yeni-app-v0/;\n}\n")
+W(os.path.join(fake, "fail"), "1")
+r = run("apply", "GBNGXT50")
+os.remove(os.path.join(fake, "fail"))
+if r.returncode != 3 or "irp-test" not in rd("yeni-app-v0-ns-x.conf"):
+    problems.append("4: nginx -t dusunce geri alma / cikis 3 yok (rc=%s)" % r.returncode)
+# intranet disi host
+r = run("apply", "GBNGXT33")
+if "SUMMARY\t0\t0\t0\t0" not in r.stdout or "kapsam disi" not in r.stdout:
+    problems.append("4: intranet olmayan host kapsam disi olmali:\n" + r.stdout)
+
+if problems:
+    print("HATALAR:"); [print(" -", p) for p in problems]; sys.exit(1)
+print("OK: intranet vhost backfill - prod/non-prod kurali, alias'tan app/ns, flat, SKIP, sertifika onkosulu, idempotent, rollback")
