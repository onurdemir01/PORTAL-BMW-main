@@ -0,0 +1,55 @@
+---
+# nginx_intranet_vhost_backfill.yml — INTRANET (50'li seri) SPA sunucularindaki MEVCUT vhost
+# dosyalarini yeni server_name / sertifika kuralina gore gunceller (2026-09-16).
+# Yeni deployment'lar icin ayni kural nginx_deployment_spa/files/3-nginx_configuration.sh'ta.
+#   non-prod : <app>-<ns>.apps-t.fw.garanti.com.tr  + wildcard.apps-t.garanti.com.tr.localca
+#   prod     : <app>-<ns-prod'suz>.apps.fw.garanti.com.tr + wildcard.apps.garanti.com.tr.localca
+# Kural/kenar durumlar: operations/files/intranet_vhost_backfill.sh basligi, README §4d.
+# MOD: mode=report (VARSAYILAN, yazmaz) | apply (yedek + nginx -t + reload; duserse geri alma).
+# HEDEF: target_hosts (varsayilan 10 intranet sunucusu). Once non-prod'da: -e "mode=apply target_hosts=GBNGXD50".
+
+- name: "--- Intranet vhost server_name/sertifika guncelleme ---"
+  hosts: "{{ target_hosts | default('GBNGXD50,GBNGXT50,GBNGXT51,GBNGXQ50,GBNGXP50,GBNGXP51,GBNGXP52,GBNGXP53,GBNGXAP50,GBNGXAP51') }}"
+  gather_facts: no
+  ignore_unreachable: true
+  vars:
+    mode: report
+  tasks:
+    - name: --- [Task] Mod dogrula ---
+      ansible.builtin.assert:
+        that: (mode | lower) in ['report', 'apply']
+        fail_msg: "mode report|apply olmali (verilen: '{{ mode }}')"
+
+    - name: --- [Task] Betigi kopyala ---
+      ansible.builtin.copy:
+        src: operations/files/intranet_vhost_backfill.sh
+        dest: /tmp/intranet_vhost_backfill.sh
+        mode: '0755'
+
+    - name: "--- [Task] {{ 'UYGULA' if (mode | lower) == 'apply' else 'RAPOR' }}: vhost dosyalari ---"
+      become: true
+      become_method: dzdo
+      become_user: www
+      ansible.builtin.command: /bin/bash /tmp/intranet_vhost_backfill.sh {{ mode | lower }}
+      register: ivh
+      changed_when: (mode | lower) == 'apply' and ('RESULT\tOK' in ivh.stdout)
+      failed_when: ivh.rc not in [0, 3, 4]
+
+    - name: --- [Task] Betigi temizle ---
+      ansible.builtin.file:
+        path: /tmp/intranet_vhost_backfill.sh
+        state: absent
+      changed_when: false
+
+    - name: --- [Task] Ozet ---
+      ansible.builtin.debug:
+        msg:
+          - "{{ inventory_hostname }} · mod={{ mode }}"
+          - "{{ (ivh.stdout_lines | select('match', '^SUMMARY') | list | first | default('SUMMARY 0 0 0 0')) | regex_replace('^SUMMARY\\t(\\d+)\\t(\\d+)\\t(\\d+)\\t(\\d+)$', 'toplam \\1 vhost · degisecek/degisen \\2 · zaten uygun \\3 · atlanan \\4') }}"
+          - "{{ (ivh.stdout_lines | select('match', '^RESULT') | list | first | default('RESULT\t-\t')) | regex_replace('^RESULT\\t', '') | regex_replace('\\t', ' - ') }}"
+          - "{{ ivh.stdout_lines | select('match', '^(NOTE|FILE\\tSKIP)') | map('regex_replace', '\\t', ' ') | list }}"
+
+    - name: --- [Task] Sertifika eksik ya da nginx -t dustu -> host FAIL ---
+      ansible.builtin.fail:
+        msg: "{{ inventory_hostname }}: {{ (ivh.stdout_lines | select('match', '^(RESULT|NOTE)') | list | join(' | ')) }}"
+      when: ivh.rc in [3, 4]
diff --git a/bmw_nginx/nginx_ops/operations/files/intranet_vhost_backfill.sh b/bmw_nginx/nginx_ops/operations/files/intranet_vhost_backfill.sh
new file mode 100644
index 000000000..fd987df95
--- /dev/null
+++ b/bmw_nginx/nginx_ops/operations/files/intranet_vhost_backfill.sh
@@ -0,0 +1,97 @@
+#!/bin/bash
+# intranet_vhost_backfill.sh - INTRANET (50'li seri) SPA sunucularindaki MEVCUT vhost
+# dosyalarinin server_name / ssl_certificate satirlarini yeni kurala gore yeniden yazar
+# (2026-09-16; yeni deployment'lar icin ayni kural nginx_deployment_spa/3-nginx_configuration.sh).
+#
+# KURAL (ortam = sunucu adindan: D50 dev, T50/T51 test, Q50 qa, P50-53/AP50-51 prod):
+#   non-prod : server_name <app>-<ns>.apps-t.fw.garanti.com.tr
+#              ssl_certificate(_key) /usr/nginx/ssl/wildcard.apps-t.garanti.com.tr.localca.{crt,key}
+#   prod     : server_name <app>-<ns'>.apps.fw.garanti.com.tr   (ns' = namespace'in sonundaki "-prod" atilmis)
+#              ssl_certificate(_key) /usr/nginx/ssl/wildcard.apps.garanti.com.tr.localca.{crt,key}
+#   flat (namespace'siz eski deployment): <app>.<alan>
+#
+# UYGULAMA/NAMESPACE NEREDEN: vhost'un include ettigi application-confs/<ad>.conf icindeki
+#   alias /usr/nginx/applications/<ns>/<app>/...   -> namespaced (ad == <app>-<ns> ise)
+#   alias /usr/nginx/applications/<app>/...         -> flat      (ad == <app> ise)
+# Ad tutmuyorsa dosya ATLANIR ve raporlanir (tahmin yok).
+#
+# ONKOSUL: sertifika dosyalari sunucuda olmali; yoksa HICBIR dosya degistirilmez (aksi halde
+# nginx -t duser). apply: yedek (.ivh-bak.<ts>) + nginx -t + reload; -t duserse hepsi geri, cikis 3.
+# KULLANIM: intranet_vhost_backfill.sh <report|apply> [conf_dir]
+# CIKTI: FILE <ADD|HAS|SKIP|ERR> <dosya> <aciklama> · SUMMARY <toplam> <degisen> <zaten> <atlanan> · RESULT ...
+set -u
+MODE="${1:-report}"
+CONF_DIR="${2:-/usr/nginx/conf.d}"
+SSL_DIR="${IVH_SSL_DIR:-/usr/nginx/ssl}"
+NGINX_BIN="${IVH_NGINX:-/usr/nginx/sbin/nginx}"
+HOST_UP="$(hostname | tr '[:lower:]' '[:upper:]')"
+TS="$(date +%Y%m%d%H%M%S)"
+case "$MODE" in report|apply) ;; *) echo "kullanim: $0 <report|apply> [conf_dir]" >&2; exit 2 ;; esac
+
+case "$HOST_UP" in
+  GBNGXD50|GBNGXT50|GBNGXT51|GBNGXQ50) env_kind="nonprod" ;;
+  GBNGXP50|GBNGXP51|GBNGXP52|GBNGXP53|GBNGXAP50|GBNGXAP51) env_kind="prod" ;;
+  *) printf 'SUMMARY\t0\t0\t0\t0\n'; printf 'NOTE\t%s intranet (50 serisi) sunucusu degil, dokunulmadi\n' "$HOST_UP"; printf 'RESULT\t-\tkapsam disi\n'; exit 0 ;;
+esac
+if [ "$env_kind" = "prod" ]; then
+  domain="apps.fw.garanti.com.tr"; cert="$SSL_DIR/wildcard.apps.garanti.com.tr.localca"
+else
+  domain="apps-t.fw.garanti.com.tr"; cert="$SSL_DIR/wildcard.apps-t.garanti.com.tr.localca"
+fi
+if [ ! -s "$cert.crt" ] || [ ! -s "$cert.key" ]; then
+  printf 'SUMMARY\t0\t0\t0\t0\n'; printf 'NOTE\tsertifika yok: %s.{crt,key} - hicbir dosya degistirilmedi\n' "$cert"; printf 'RESULT\tFAIL\tsertifika eksik\n'; exit 4
+fi
+
+total=0; changed=0; has=0; skip=0; err=0; changed_files=""
+for f in "$CONF_DIR"/*.conf; do
+  [ -f "$f" ] || continue
+  grep -qE '^[[:space:]]*server_name[[:space:]]' "$f" || continue
+  name="$(sed -nE 's#.*application-confs/([^/[:space:]]+)\.conf.*#\1#p' "$f" | head -1)"
+  [ -n "$name" ] || continue                       # servis vhost'u / include'suz: kapsam disi
+  total=$((total + 1))
+  appconf="$CONF_DIR/application-confs/$name.conf"
+  if [ ! -f "$appconf" ]; then skip=$((skip + 1)); printf 'FILE\tSKIP\t%s\tapplication-confs/%s.conf yok\n' "$f" "$name"; continue; fi
+  # alias /usr/nginx/applications/<1>/<2>/... : namespaced ise <1>=ns <2>=app ve ad == app-ns;
+  # flat ise <1>=app (ad == <1>), <2> uygulama ici bir dizin (locales vb.) olabilir.
+  first="$(sed -nE 's#^[[:space:]]*alias[[:space:]]+/usr/nginx/applications/([^/[:space:];]+).*#\1#p' "$appconf" | head -1)"
+  second="$(sed -nE 's#^[[:space:]]*alias[[:space:]]+/usr/nginx/applications/[^/[:space:];]+/([^/[:space:];]+).*#\1#p' "$appconf" | head -1)"
+  if [ -n "$first" ] && [ -n "$second" ] && [ "$second-$first" = "$name" ]; then
+    kind="namespaced"; ns="$first"; app="$second"
+  elif [ -n "$first" ] && [ "$first" = "$name" ]; then
+    kind="flat"; app="$name"; ns=""
+  else
+    skip=$((skip + 1)); printf 'FILE\tSKIP\t%s\tuygulama/namespace alias satirindan cozulemedi (alias: %s)\n' "$f" "${first:-yok}${second:+/$second}"; continue
+  fi
+  if [ "$kind" = "namespaced" ]; then
+    ns_out="$ns"; [ "$env_kind" = "prod" ] && ns_out="${ns%-prod}"
+    sname="${app}-${ns_out}.${domain}"
+  else
+    sname="${app}.${domain}"
+  fi
+  tmp="$(mktemp)"
+  sed -E \
+    -e "s|^([[:space:]]*)server_name[[:space:]]+.*;|\1server_name ${sname};|" \
+    -e "s|^([[:space:]]*)ssl_certificate[[:space:]]+.*;|\1ssl_certificate ${cert}.crt;|" \
+    -e "s|^([[:space:]]*)ssl_certificate_key[[:space:]]+.*;|\1ssl_certificate_key ${cert}.key;|" \
+    "$f" > "$tmp"
+  if cmp -s "$tmp" "$f"; then has=$((has + 1)); printf 'FILE\tHAS\t%s\t%s\n' "$f" "$sname"; rm -f "$tmp"; continue; fi
+  changed=$((changed + 1)); printf 'FILE\tADD\t%s\t%s (%s)\n' "$f" "$sname" "$kind"
+  if [ "$MODE" = "apply" ]; then
+    cp -p "$f" "$f.ivh-bak.$TS" && cat "$tmp" > "$f" && changed_files="$changed_files $f" || { err=$((err + 1)); printf 'FILE\tERR\t%s\tyazilamadi\n' "$f"; }
+  fi
+  rm -f "$tmp"
+done
+printf 'SUMMARY\t%d\t%d\t%d\t%d\n' "$total" "$changed" "$has" "$skip"
+[ "$err" -gt 0 ] && printf 'NOTE\t%d dosyada hata\n' "$err"
+
+if [ "$MODE" = "apply" ] && [ -n "$changed_files" ]; then
+  if dzdo "$NGINX_BIN" -p /usr/nginx/ -c /usr/nginx/nginx.conf -e /web_log/error.log -t >/tmp/ivh_nginx_t.$$ 2>&1; then
+    dzdo "$NGINX_BIN" -p /usr/nginx/ -c /usr/nginx/nginx.conf -e /web_log/error.log -s reload
+    printf 'RESULT\tOK\t%d vhost degisti, nginx -t gecti, reload yapildi\n' "$changed"; rm -f /tmp/ivh_nginx_t.$$; exit 0
+  else
+    for f in $changed_files; do cp -p "$f.ivh-bak.$TS" "$f"; done
+    printf 'RESULT\tROLLBACK\tnginx -t DUSTU, %d dosya geri alindi: %s\n' "$changed" "$(tr '\n' ' ' < /tmp/ivh_nginx_t.$$ | cut -c1-400)"; rm -f /tmp/ivh_nginx_t.$$; exit 3
+  fi
+fi
+printf 'RESULT\t-\t%s\n' "$([ "$MODE" = "apply" ] && echo 'degisiklik yok' || echo 'rapor modu, degisiklik yok')"
+exit 0
