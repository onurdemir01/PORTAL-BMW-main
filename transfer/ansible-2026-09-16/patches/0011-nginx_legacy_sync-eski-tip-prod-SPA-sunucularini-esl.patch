diff --git a/bmw_nginx/nginx_legacy_sync/files/legacy_sync_dump.sh b/bmw_nginx/nginx_legacy_sync/files/legacy_sync_dump.sh
new file mode 100644
index 000000000..3e4bdd22c
--- /dev/null
+++ b/bmw_nginx/nginx_legacy_sync/files/legacy_sync_dump.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+# legacy_sync_dump.sh - /usr/nginx/conf.d/*.conf dosyalarini TEK akista basar (salt-okunur).
+# legacy_sync_plan.py bunu okur. Bicim (nginx_ratelimit_inventory ile ayni desen):
+#   ###FILE_BEGIN:<dosya adi>
+#   <icerik>
+#   ###FILE_END
+# Yedek / -bak / .deleted- / -check dosyalari ATLANIR: onlar nginx tarafindan da okunmaz
+# (nginx.conf yalniz *.conf include eder) ve plana girmemeli.
+set -u
+CONF_DIR="${1:-/usr/nginx/conf.d}"
+[ -d "$CONF_DIR" ] || { echo "###NOTE:dizin yok: $CONF_DIR"; exit 0; }
+shopt -s nullglob
+for f in "$CONF_DIR"/*.conf; do
+  [ -f "$f" ] || continue
+  case "$(basename "$f")" in *-check.conf) continue ;; esac
+  printf '###FILE_BEGIN:%s\n' "$(basename "$f")"
+  cat "$f"
+  # dosya sonu newline ile bitmiyorsa isaret satiri yapismasin
+  [ -n "$(tail -c1 "$f")" ] && printf '\n'
+  printf '###FILE_END\n'
+done
+exit 0
diff --git a/bmw_nginx/nginx_legacy_sync/files/legacy_sync_plan.py b/bmw_nginx/nginx_legacy_sync/files/legacy_sync_plan.py
new file mode 100644
index 000000000..441bce7c4
--- /dev/null
+++ b/bmw_nginx/nginx_legacy_sync/files/legacy_sync_plan.py
@@ -0,0 +1,488 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""legacy_sync_plan.py — ESKI TIP (proxy_pass + upstream) prod sunucularini ESLENIK grup
+icinde esitleyen PLANI uretir (2026-09-15, kullanici istegi). Sunuculara dokunmaz; her
+sunucu icin "su dosyalarin yeni icerigi su" listesi ve okunur rapor yazar. Uygulamayi
+playbook yapar (mode=apply).
+
+GIRDI : <raw_dir>/<HOST>.txt   (files/legacy_sync_dump.sh ciktisi: conf.d/*.conf icerikleri)
+CIKTI : <plan_dir>/<HOST>.json ({"files": [{"path", "content"}], "actions": [...]})
+        <plan_dir>/report.txt   (insan icin), stdout son satir: SYNC_JSON {...}
+
+ESLENIK GRUPLAR (nginx_legacy_audit ile AYNI; kullanici, 2026-09-11/15):
+  A: GBRVPP01, GBRVPP02, GBRVPAP01, GBRVPAP02      (GLOMO disi servisler)
+  B: GBRVPP07-10, GBRVPAP03-06                     (GLOMO)
+
+KURALLAR (sira onemli):
+  1. FQDN -> UPSTREAM: `proxy_pass https://<ad>.apps.fw.garanti.com.tr[/...]` gibi dogrudan
+     DNS adina giden location, `proxy_pass https://<ad>[/...]` yapilir (<ad> = FQDN'in ilk
+     etiketi; nginx_ops prod_create'in upstream_host turetimiyle AYNI). Blokta
+     `proxy_ssl_name <fqdn>` / `proxy_set_header Host <fqdn>` yoksa proxy_pass altina eklenir
+     (upstream'e gecince SNI/Host bunlardan gelir). IP adresleri dokunulmaz.
+  2. UPSTREAM TANIMI: kullanilan her upstream adi icin grupta bir tanim yoksa
+     `upstream <ad> { server <fqdn>:443 resolve; keepalive 10; zone upstream_dynamic 4m; }`
+     uretilir (nginx_scheduled_ops upstream-append-template.j2 ile AYNI). FQDN, proxy_pass
+     (kural 1) ya da bloktaki proxy_ssl_name/Host basligindan gelir; hicbiri yoksa
+     UNDEFINED_TARGET olarak raporlanir (nginx zaten baslamaz - elle bakilmali).
+     Ayni adda ama BASKA hedefe giden upstream varsa CONFLICT raporlanir, dokunulmaz.
+  3. ESITLEME: grup icinde ayni vhost dosyasinin (<SERVICE>-PROD.conf) location kumesi
+     BIRLESIMdir; bir sunucuda eksik olan location, referans (cogunluk) surumuyle
+     `error_page` satirinin ONUNE (nginx_ops create ile ayni capa) eklenir. Upstream'ler de
+     grup birlesimidir; eksik olan sunucuya eklenir (o servisin -upstreams.conf dosyasi
+     varsa ORAYA, yoksa vhost dosyasinin BASINA - create ile ayni yer). HICBIR SEY SILINMEZ.
+  4. FARK: her sunucuda var ama govdesi farkli location -> DIFF_LOCATION (dokunulmaz);
+     --strict ile cogunluk surumu yazilir. Upstream govde farki -> DIFF_UPSTREAM (bilgi).
+  5. --fix-upstreams: mevcut upstream'lerde eksik `resolve` / `keepalive` / `zone`
+     tamamlanir (varsayilan KAPALI; nginx_audit'te 199 upstream'de eksikti, ayrica karar).
+
+CIKTI (report.txt / actions):  ACTION  HOST  SERVIS  DETAY
+  REWRITE_PROXY_PASS  ADD_SSL_NAME  ADD_HOST_HEADER  ADD_UPSTREAM  ADD_LOCATION
+  REPLACE_LOCATION(strict)  FIX_UPSTREAM  DIFF_LOCATION  DIFF_UPSTREAM  CONFLICT
+  UNDEFINED_TARGET  NO_ANCHOR
+"""
+import io
+import json
+import os
+import re
+import sys
+from collections import Counter, defaultdict
+
+PEER_GROUPS = {
+    "A": ["GBRVPP01", "GBRVPP02", "GBRVPAP01", "GBRVPAP02"],
+    "B": ["GBRVPP07", "GBRVPP08", "GBRVPP09", "GBRVPP10", "GBRVPAP03", "GBRVPAP04", "GBRVPAP05", "GBRVPAP06"],
+}
+CONF_DIR = "/usr/nginx/conf.d"
+UPSTREAM_TEMPLATE = "upstream {name} {{\n  server {fqdn}:443 resolve;\n  keepalive 10;\n  zone upstream_dynamic 4m;\n}}\n"
+FQDN_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]*(\.[A-Za-z0-9][A-Za-z0-9-]*)+$")
+IP_RE = re.compile(r"^\d{1,3}(\.\d{1,3}){3}$")
+PROXY_PASS_RE = re.compile(r"^(\s*)proxy_pass(\s+)(https?)://([^/;\s]+)(/[^;\s]*)?\s*;(.*)$")
+SSL_NAME_RE = re.compile(r"^\s*proxy_ssl_name\s+([^;\s]+)\s*;")
+HOST_HDR_RE = re.compile(r"^\s*proxy_set_header\s+Host\s+([^;\s]+)\s*;")
+UPSTREAM_HDR_RE = re.compile(r"^\s*upstream\s+([^\s{]+)\s*\{")
+LOCATION_HDR_RE = re.compile(r"^\s*location\s+([^{]+?)\s*\{")
+SERVER_HDR_RE = re.compile(r"^\s*server\s*\{")
+ERROR_PAGE_RE = re.compile(r"^\s*error_page\b")
+
+
+# ----------------------------------------------------------------------------- parse
+def strip_comment(line):
+    """# ile baslayan kuyrugu atar (tirnak icindeki # korunur)."""
+    out = []
+    q = None
+    for ch in line:
+        if q:
+            out.append(ch)
+            if ch == q:
+                q = None
+            continue
+        if ch in ("'", '"'):
+            q = ch
+            out.append(ch)
+            continue
+        if ch == "#":
+            break
+        out.append(ch)
+    return "".join(out)
+
+
+def brace_delta(line):
+    s = strip_comment(line)
+    return s.count("{") - s.count("}")
+
+
+def find_blocks(lines, start, end, header_re):
+    """[start,end) araligindaki, header_re ile baslayan UST duzey bloklari
+    [(baslangic, bitis DAHIL, baslik eslemesi)] dondurur. Ic bloklar parantez sayaciyla
+    atlanir; tek satirlik `location /x { return 200; }` de blok sayilir."""
+    blocks = []
+    i = start
+    while i < end:
+        m = header_re.match(strip_comment(lines[i]))
+        if not m:
+            i += 1
+            continue
+        depth = 0
+        j = i
+        while j < end:
+            depth += brace_delta(lines[j])
+            if depth <= 0 and "}" in strip_comment(lines[j]):
+                break
+            j += 1
+        blocks.append((i, min(j, end - 1), m))
+        i = j + 1
+    return blocks
+
+
+def norm_ws(s):
+    return re.sub(r"\s+", " ", s).strip()
+
+
+def norm_block(lines):
+    out = []
+    for l in lines:
+        s = norm_ws(strip_comment(l))
+        if s:
+            out.append(s)
+    return "\n".join(out)
+
+
+def parse_vhost(lines):
+    """server bloklari ve icindeki ust duzey location'lar."""
+    servers = []
+    for (s, e, _) in find_blocks(lines, 0, len(lines), SERVER_HDR_RE):
+        locs = []
+        for (ls, le, m) in find_blocks(lines, s + 1, e, LOCATION_HDR_RE):
+            key = norm_ws(m.group(1))
+            locs.append({"start": ls, "end": le, "key": key})
+        anchor = None
+        for k in range(s + 1, e):
+            if ERROR_PAGE_RE.match(strip_comment(lines[k])):
+                anchor = k
+                break
+        servers.append({"start": s, "end": e, "locations": locs, "anchor": anchor})
+    return servers
+
+
+def parse_upstreams(lines):
+    ups = []
+    for (s, e, m) in find_blocks(lines, 0, len(lines), UPSTREAM_HDR_RE):
+        body = lines[s:e + 1]
+        server = ""
+        for l in body:
+            sm = re.match(r"^\s*server\s+([^;\s]+)", strip_comment(l))
+            if sm:
+                server = sm.group(1)
+                break
+        ups.append({"start": s, "end": e, "name": m.group(1), "server": server,
+                    "server_host": server.split(":")[0] if server else "",
+                    "has_resolve": any(re.search(r"^\s*server\s.*\bresolve\b", strip_comment(l)) for l in body),
+                    "has_keepalive": any(re.match(r"^\s*keepalive\s", strip_comment(l)) for l in body),
+                    "has_zone": any(re.match(r"^\s*zone\s", strip_comment(l)) for l in body),
+                    "text": body})
+    return ups
+
+
+def block_info(lines, ls, le):
+    """location govdesinden proxy_pass / ssl_name / host header bilgisi."""
+    info = {"proxy_idx": None, "scheme": None, "host": None, "suffix": "", "ssl_name": None, "host_hdr": None, "indent": None}
+    for k in range(ls + 1, le):
+        s = strip_comment(lines[k])
+        m = PROXY_PASS_RE.match(s)
+        if m and info["proxy_idx"] is None:
+            info.update(proxy_idx=k, indent=m.group(1), scheme=m.group(3), host=m.group(4), suffix=m.group(5) or "")
+            continue
+        m = SSL_NAME_RE.match(s)
+        if m:
+            info["ssl_name"] = m.group(1)
+        m = HOST_HDR_RE.match(s)
+        if m:
+            info["host_hdr"] = m.group(1)
+    return info
+
+
+# ----------------------------------------------------------------------------- raw io
+def read_raw(path):
+    """dump ciktisi: ###FILE_BEGIN:<conf.d icindeki ad>\\n...\\n###FILE_END"""
+    text = io.open(path, encoding="utf-8", errors="replace").read()
+    files = {}
+    for m in re.finditer(r"###FILE_BEGIN:(\S+)\n(.*?)\n###FILE_END", text, re.S):
+        files[m.group(1)] = m.group(2).split("\n")
+    return files
+
+
+def is_vhost(lines):
+    return any(SERVER_HDR_RE.match(strip_comment(l)) for l in lines)
+
+
+def service_of(conf_name):
+    """GLOMO-PROD.conf -> glomo ; glomo-prod-upstreams.conf -> glomo ; WEBFORMS-PROD.conf -> webforms"""
+    base = conf_name[:-5] if conf_name.endswith(".conf") else conf_name
+    base = base.lower()
+    for suf in ("-prod-upstreams", "-upstreams", "-prod"):
+        if base.endswith(suf):
+            base = base[: -len(suf)]
+            break
+    return base
+
+
+# ----------------------------------------------------------------------------- host state
+class Host(object):
+    def __init__(self, name, files):
+        self.name = name
+        self.files = {k: list(v) for k, v in files.items()}   # ad -> satirlar (degistirilebilir)
+        self.actions = []
+        self.changed = set()
+
+    def act(self, action, service, detail):
+        self.actions.append((action, self.name, service, detail))
+
+    def upstream_index(self):
+        idx = {}
+        for fname, lines in self.files.items():
+            for u in parse_upstreams(lines):
+                idx.setdefault(u["name"], {"file": fname, **u})
+        return idx
+
+    def upstream_file_for(self, service):
+        cand = "%s-prod-upstreams.conf" % service
+        if cand in self.files:
+            return cand
+        # servis dosyasinda upstream var mi? yoksa da vhost dosyasi (create ile ayni yer)
+        return "%s-PROD.conf" % service.upper() if ("%s-PROD.conf" % service.upper()) in self.files else None
+
+    def add_upstream(self, service, name, text_lines, why):
+        fname = self.upstream_file_for(service)
+        if fname is None:
+            self.act("NO_ANCHOR", service, "upstream %s icin dosya yok (%s-PROD.conf?)" % (name, service.upper()))
+            return False
+        lines = self.files[fname]
+        block = [l.rstrip("\n") for l in text_lines]
+        if block and block[-1] != "":
+            block = block + [""]
+        self.files[fname] = block + lines
+        self.changed.add(fname)
+        self.act("ADD_UPSTREAM", service, "%s -> %s (%s)" % (name, fname, why))
+        return True
+
+
+# ----------------------------------------------------------------------------- planning
+def majority(versions):
+    """[(host, norm, raw_lines)] -> cogunluktaki (norm, raw_lines). Esitlikte, alfabetik
+    ilk sunucunun surumu ("ilk sunucu dogru" DEGIL: yalnizca esitligi bozmak icin)."""
+    c = Counter(v[1] for v in versions)
+    top = max(c.values())
+    for h, n, raw in sorted(versions, key=lambda x: x[0]):
+        if c[n] == top:
+            return n, raw
+    return versions[0][1], versions[0][2]
+
+
+def plan_group(gname, hosts, strict=False, fix_upstreams=False):
+    """hosts: [Host]. Dosyalari yerinde degistirir, aksiyonlari toplar."""
+    # --- 1) FQDN -> upstream + eksik ssl_name/Host + upstream ihtiyaclari (sunucu bazinda)
+    needed = defaultdict(dict)   # service -> name -> fqdn (grup genelinde ihtiyac)
+    for h in hosts:
+        for fname in sorted(h.files):
+            lines = h.files[fname]
+            if not is_vhost(lines):
+                continue
+            service = service_of(fname)
+            ups_idx = h.upstream_index()
+            # location'lari SONDAN basa isle: satir ekleyince alt indeksler kaymasin
+            for srv in reversed(parse_vhost(lines)):
+                for loc in reversed(srv["locations"]):
+                    info = block_info(lines, loc["start"], loc["end"])
+                    if info["proxy_idx"] is None:
+                        continue
+                    host = info["host"]
+                    port_less = host.split(":")[0]
+                    # IP ya da degisken ($upstream) hedefe dokunulmaz
+                    if IP_RE.match(port_less) or "$" in port_less:
+                        continue
+                    fqdn = None
+                    name = None
+                    if FQDN_RE.match(port_less):
+                        fqdn = port_less
+                        name = port_less.split(".")[0]
+                        existing = ups_idx.get(name)
+                        if existing and existing["server_host"] and existing["server_host"].lower() != fqdn.lower():
+                            h.act("CONFLICT", service, "location %s: upstream %s zaten %s hedefine gidiyor, FQDN %s -> dokunulmadi"
+                                  % (loc["key"], name, existing["server_host"], fqdn))
+                            continue
+                        k = info["proxy_idx"]
+                        m = PROXY_PASS_RE.match(strip_comment(lines[k]))
+                        # bosluk duzeni korunur (proxy_pass      https://... gibi hizalanmis dosyalar)
+                        lines[k] = "%sproxy_pass%s%s://%s%s;%s" % (m.group(1), m.group(2), m.group(3), name, m.group(5) or "", m.group(6) or "")
+                        h.changed.add(fname)
+                        h.act("REWRITE_PROXY_PASS", service, "location %s: %s -> upstream %s" % (loc["key"], fqdn, name))
+                        ind = m.group(1)
+                        ins = []
+                        if not info["host_hdr"]:
+                            ins.append("%sproxy_set_header Host %s;" % (ind, fqdn))
+                            h.act("ADD_HOST_HEADER", service, "location %s: Host %s" % (loc["key"], fqdn))
+                        if not info["ssl_name"]:
+                            ins.insert(0, "%sproxy_ssl_name %s;" % (ind, fqdn))
+                            h.act("ADD_SSL_NAME", service, "location %s: proxy_ssl_name %s" % (loc["key"], fqdn))
+                        if ins:
+                            lines[k + 1:k + 1] = ins
+                    else:
+                        name = port_less
+                        # cipla ad: upstream tanimli mi (bu sunucuda)? degilse FQDN basliklardan
+                        if name in ups_idx:
+                            fqdn = ups_idx[name]["server_host"]
+                        else:
+                            fqdn = info["ssl_name"] or info["host_hdr"]
+                            if not fqdn:
+                                h.act("UNDEFINED_TARGET", service, "location %s: upstream %s tanimsiz, blokta FQDN de yok - ELLE bakilmali" % (loc["key"], name))
+                                continue
+                    if name and fqdn:
+                        needed[service].setdefault(name, fqdn)
+
+    # --- 2) upstream birlesimi (grup) + ihtiyac duyulanlar
+    union = defaultdict(dict)    # service -> name -> [(host, norm, raw)]
+    for h in hosts:
+        for fname, lines in h.files.items():
+            for u in parse_upstreams(lines):
+                svc = service_of(fname)
+                union[svc][u["name"]] = union[svc].get(u["name"], []) + [(h.name, norm_block(u["text"]), u["text"], u)]
+    # servis eslemesi: vhost dosyasi glomo -> upstream dosyasi glomo-prod-upstreams
+    for h in hosts:
+        idx = h.upstream_index()
+        services = sorted({service_of(f) for f, l in h.files.items() if is_vhost(l)})
+        for service in services:
+            # grup birlesimindeki upstream'ler (bu servise ait) bu sunucuda var mi
+            for name, versions in sorted(union.get(service, {}).items()):
+                if name in idx:
+                    continue
+                n, raw = majority([(v[0], v[1], v[2]) for v in versions])
+                h.add_upstream(service, name, raw, "eslenikten (%s)" % ",".join(sorted({v[0] for v in versions})))
+                idx = h.upstream_index()
+            # ihtiyac duyulan ama hicbir yerde tanimli olmayanlar: sablonla uret
+            for name, fqdn in sorted(needed.get(service, {}).items()):
+                if name in idx:
+                    continue
+                text = UPSTREAM_TEMPLATE.format(name=name, fqdn=fqdn).split("\n")
+                h.add_upstream(service, name, text, "yeni tanim, hedef %s" % fqdn)
+                idx = h.upstream_index()
+                union[service][name] = union[service].get(name, []) + [(h.name, norm_block(text), text, None)]
+        # upstream govde farki (bilgi) / --fix-upstreams. Duzeltmeler dosya icinde SONDAN
+        # basa uygulanir: satir eklemek ustteki bloklarin indekslerini kaydirmasin.
+        for name, u in sorted(idx.items(), key=lambda kv: (kv[1]["file"], -kv[1]["start"])):
+            versions = union.get(service_of(u["file"]), {}).get(name, [])
+            norms = {v[1] for v in versions}
+            if len(norms) > 1 and norm_block(u["text"]) != majority([(v[0], v[1], v[2]) for v in versions])[0]:
+                h.act("DIFF_UPSTREAM", service_of(u["file"]), "%s govdesi eslenik cogunlugundan farkli" % name)
+            if fix_upstreams and not (u["has_resolve"] and u["has_keepalive"] and u["has_zone"]):
+                lines = h.files[u["file"]]
+                s, e = u["start"], u["end"]
+                ind = "  "
+                fixes = []
+                if not u["has_resolve"]:
+                    for k in range(s + 1, e):
+                        if re.match(r"^\s*server\s", strip_comment(lines[k])):
+                            lines[k] = re.sub(r"\s*;", " resolve;", lines[k], count=1)
+                            fixes.append("resolve")
+                            break
+                add = []
+                if not u["has_keepalive"]:
+                    add.append("%skeepalive 10;" % ind)
+                    fixes.append("keepalive")
+                if not u["has_zone"]:
+                    add.append("%szone upstream_dynamic 4m;" % ind)
+                    fixes.append("zone")
+                if add:
+                    lines[e:e] = add
+                h.changed.add(u["file"])
+                h.act("FIX_UPSTREAM", service_of(u["file"]), "%s: %s eklendi" % (name, "+".join(fixes)))
+
+    # --- 3) location esitleme (vhost dosyasi bazinda birlesim)
+    vhost_names = sorted({f for h in hosts for f, l in h.files.items() if is_vhost(l)})
+    for vname in vhost_names:
+        service = service_of(vname)
+        have = [h for h in hosts if vname in h.files]
+        missing_file = [h.name for h in hosts if vname not in h.files]
+        if missing_file:
+            for h in hosts:
+                if vname not in h.files:
+                    h.act("MISSING_VHOST", service, "%s bu sunucuda yok (eslenikte var: %s) - dosya kopyalanmaz, ELLE bakilmali"
+                          % (vname, ",".join(x.name for x in have)))
+        # server blogu sirasina gore (0., 1., ...) location kumeleri
+        max_srv = max(len(parse_vhost(h.files[vname])) for h in have)
+        for si in range(max_srv):
+            versions = defaultdict(list)   # key -> [(host, norm, raw)]
+            for h in have:
+                srvs = parse_vhost(h.files[vname])
+                if si >= len(srvs):
+                    continue
+                for loc in srvs[si]["locations"]:
+                    raw = h.files[vname][loc["start"]:loc["end"] + 1]
+                    versions[loc["key"]].append((h.name, norm_block(raw), raw))
+            for key in sorted(versions):
+                vs = versions[key]
+                ref_norm, ref_raw = majority(vs)
+                present = {v[0] for v in vs}
+                for h in have:
+                    srvs = parse_vhost(h.files[vname])
+                    if si >= len(srvs):
+                        continue
+                    srv = srvs[si]
+                    if h.name not in present:
+                        # EKSIK -> error_page capasinin onune; yoksa server kapanisinin onune
+                        at = srv["anchor"] if srv["anchor"] is not None else srv["end"]
+                        block = list(ref_raw)
+                        if block and block[-1].strip() != "":
+                            block = block + [""]
+                        h.files[vname][at:at] = block
+                        h.changed.add(vname)
+                        h.act("ADD_LOCATION", service, "location %s (server #%d) eslenikten eklendi (%s)%s"
+                              % (key, si + 1, ",".join(sorted(present)), "" if srv["anchor"] is not None else " [error_page capasi yok, server sonuna]"))
+                        if srv["anchor"] is None:
+                            h.act("NO_ANCHOR", service, "%s server #%d: error_page satiri yok" % (vname, si + 1))
+                    else:
+                        mine = next(v for v in vs if v[0] == h.name)
+                        if mine[1] != ref_norm:
+                            if strict:
+                                loc = next(l for l in srv["locations"] if l["key"] == key)
+                                h.files[vname][loc["start"]:loc["end"] + 1] = list(ref_raw)
+                                h.changed.add(vname)
+                                h.act("REPLACE_LOCATION", service, "location %s cogunluk surumuyle degistirildi" % key)
+                            else:
+                                h.act("DIFF_LOCATION", service, "location %s govdesi eslenik cogunlugundan farkli (strict ile degistirilir)" % key)
+
+
+# ----------------------------------------------------------------------------- main
+def main():
+    import argparse
+    ap = argparse.ArgumentParser()
+    ap.add_argument("raw_dir")
+    ap.add_argument("plan_dir")
+    ap.add_argument("--strict", action="store_true")
+    ap.add_argument("--fix-upstreams", action="store_true")
+    ap.add_argument("--group", default="", help="yalniz bu grup (A|B)")
+    a = ap.parse_args()
+
+    hosts_by_name = {}
+    for fn in sorted(os.listdir(a.raw_dir)):
+        if not fn.endswith(".txt"):
+            continue
+        name = fn[:-4].upper()
+        hosts_by_name[name] = Host(name, read_raw(os.path.join(a.raw_dir, fn)))
+
+    os.makedirs(a.plan_dir, exist_ok=True)
+    all_actions = []
+    scanned = {}
+    for g, members in PEER_GROUPS.items():
+        if a.group and a.group.upper() != g:
+            continue
+        hosts = [hosts_by_name[m] for m in members if m in hosts_by_name]
+        scanned[g] = [h.name for h in hosts]
+        if len(hosts) < 2:
+            print("NOTE\tgrup %s: %d sunucu tarandi, esitleme icin en az 2 gerekir - atlandi" % (g, len(hosts)))
+            continue
+        plan_group(g, hosts, strict=a.strict, fix_upstreams=a.fix_upstreams)
+        for h in hosts:
+            files = [{"path": "%s/%s" % (CONF_DIR, f), "content": "\n".join(h.files[f]).rstrip("\n") + "\n"} for f in sorted(h.changed)]
+            io.open(os.path.join(a.plan_dir, h.name + ".json"), "w", encoding="utf-8").write(
+                json.dumps({"host": h.name, "group": g, "files": files,
+                            "actions": [{"action": x[0], "service": x[2], "detail": x[3]} for x in h.actions]},
+                           ensure_ascii=False, indent=1))
+            all_actions.extend(h.actions)
+
+    by_type = Counter(x[0] for x in all_actions)
+    with io.open(os.path.join(a.plan_dir, "report.txt"), "w", encoding="utf-8") as rep:
+        rep.write("Nginx legacy sync plani\n")
+        for g, names in scanned.items():
+            rep.write("grup %s: %s\n" % (g, ", ".join(names) or "(sunucu yok)"))
+        rep.write("\n")
+        for t, n in sorted(by_type.items()):
+            rep.write("%-20s %d\n" % (t, n))
+        rep.write("\n")
+        for x in all_actions:
+            rep.write("%s\t%s\t%s\t%s\n" % x)
+    print("SYNC_JSON " + json.dumps({"groups": scanned, "by_type": dict(by_type), "total": len(all_actions),
+                                     "hosts_changed": sorted({x[1] for x in all_actions if x[0] in
+                                                              ("REWRITE_PROXY_PASS", "ADD_SSL_NAME", "ADD_HOST_HEADER", "ADD_UPSTREAM", "ADD_LOCATION", "REPLACE_LOCATION", "FIX_UPSTREAM")})}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/bmw_nginx/nginx_legacy_sync/files/nginx_test_or_reload.sh b/bmw_nginx/nginx_legacy_sync/files/nginx_test_or_reload.sh
new file mode 100644
index 000000000..1dc97a66d
--- /dev/null
+++ b/bmw_nginx/nginx_legacy_sync/files/nginx_test_or_reload.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# nginx_test_or_reload.sh <test|reload> - nginx (plus ya da OSS) icin -t / -s reload.
+# Diger playbook'lardaki (nginx_ops, api_generator) gomulu blogun files/ altina alinmis hali.
+set -u
+MODE="${1:-test}"
+BIN=/usr/nginx/sbin/nginx
+ver="$(dzdo "$BIN" -v 2>&1 | awk -F "/" '{print $2}')"
+if [ "$MODE" = "reload" ]; then
+  if [[ "$ver" == *plus* ]]; then
+    dzdo "$BIN" -p /usr/nginx/ -c /usr/nginx/nginx.conf -e /web_log/error.log -s reload
+  else
+    dzdo "$BIN" -s reload
+  fi
+else
+  if [[ "$ver" == *plus* ]]; then
+    dzdo "$BIN" -p /usr/nginx/ -c /usr/nginx/nginx.conf -e /web_log/error.log -t
+  else
+    dzdo "$BIN" -t
+  fi
+fi
diff --git a/bmw_nginx/nginx_legacy_sync/nginx_legacy_sync.yml b/bmw_nginx/nginx_legacy_sync/nginx_legacy_sync.yml
new file mode 100644
index 000000000..c9038228b
--- /dev/null
+++ b/bmw_nginx/nginx_legacy_sync/nginx_legacy_sync.yml
@@ -0,0 +1,217 @@
+---
+# nginx_legacy_sync.yml — ESKI TIP (proxy_pass + upstream) SPA production sunucularini
+# eslenik grup icinde ESITLER (2026-09-15, kullanici istegi):
+#   1) sunucular birbirine esitlenir (eksik location / upstream eslenikten gelir),
+#   2) FQDN'e giden proxy_pass'ler upstream'e cevrilir,
+#   3) tanimi olmayan upstream'ler tanimlanir.
+# Kurallar ve sinirlar: files/legacy_sync_plan.py basligi, README.md.
+#
+# ESLENIK GRUPLAR (nginx_legacy_audit ile AYNI):
+#   A: GBRVPP01, GBRVPP02, GBRVPAP01, GBRVPAP02      (GLOMO disi)
+#   B: GBRVPP07-10, GBRVPAP03-06                     (GLOMO)
+#
+# MOD (extra var `mode`): report (VARSAYILAN: tarar, plani ve raporu GBLABT02'ye yazar,
+#   sunuculara DOKUNMAZ) | apply (plani uygular: yedek + nginx -t + reload; -t duserse o
+#   sunucudaki tum dosyalar geri alinir, host FAIL).
+# SECENEKLER: group=A|B (yalniz o grup), strict=true (govdesi farkli location'lari cogunluk
+#   surumuyle degistir), fix_upstreams=true (eksik resolve/keepalive/zone tamamla),
+#   target_hosts=... (apply'i su sunucularla sinirla; plan yine tum grupla hesaplanir).
+# ONERILEN SIRA: mode=report -> report.txt oku -> mode=apply target_hosts=<tek sunucu> -> tumu.
+
+- name: "--- [Play] Legacy sync - hazirlik ---"
+  hosts: GBLABT02
+  gather_facts: no
+  vars:
+    sync_dir: /sw/WAS_IMAGES/Nginx/legacy_sync
+  tasks:
+    - name: --- [Task] Mod dogrula ---
+      ansible.builtin.assert:
+        that: (mode | default('report') | lower) in ['report', 'apply']
+        fail_msg: "mode report|apply olmali (verilen: '{{ mode | default('report') }}')"
+
+    - name: --- [Task] Dizinler ---
+      ansible.builtin.file:
+        path: "{{ item }}"
+        state: directory
+        mode: '0777'
+      loop:
+        - "{{ sync_dir }}"
+        - "{{ sync_dir }}/raw"
+        - "{{ sync_dir }}/plan"
+
+    # Onceki turun dokumu kalirsa ulasilamayan sunucunun ESKI hali plana girer.
+    - name: --- [Task] Onceki tur dokumlerini ve planini temizle ---
+      ansible.builtin.shell: rm -f {{ sync_dir }}/raw/*.txt {{ sync_dir }}/plan/*.json {{ sync_dir }}/plan/report.txt
+      changed_when: false
+      ignore_errors: true
+
+- name: "--- [Play] Legacy sync - dokum (salt-okunur) ---"
+  hosts: >-
+    GBRVPP01,GBRVPP02,GBRVPAP01,GBRVPAP02,
+    GBRVPP07,GBRVPP08,GBRVPP09,GBRVPP10,GBRVPAP03,GBRVPAP04,GBRVPAP05,GBRVPAP06
+  gather_facts: no
+  ignore_unreachable: true
+  vars:
+    sync_dir: /sw/WAS_IMAGES/Nginx/legacy_sync
+  tasks:
+    - name: --- [Task] Dump betigini kopyala ---
+      ansible.builtin.copy:
+        src: files/legacy_sync_dump.sh
+        dest: /tmp/legacy_sync_dump.sh
+        mode: '0755'
+
+    - name: --- [Task] conf.d/*.conf dokumu ---
+      become: true
+      become_method: dzdo
+      become_user: www
+      ansible.builtin.command: /bin/bash /tmp/legacy_sync_dump.sh
+      register: dump_out
+      changed_when: false
+
+    - name: --- [Task] Dokumu GBLABT02'ye yaz ---
+      ansible.builtin.copy:
+        content: "{{ dump_out.stdout }}\n"
+        dest: "{{ sync_dir }}/raw/{{ inventory_hostname }}.txt"
+        mode: '0666'
+      delegate_to: GBLABT02
+      when: (dump_out.stdout | default('') | trim | length) > 0
+
+    - name: --- [Task] Betigi temizle ---
+      ansible.builtin.file:
+        path: /tmp/legacy_sync_dump.sh
+        state: absent
+      changed_when: false
+
+- name: "--- [Play] Legacy sync - plan ---"
+  hosts: GBLABT02
+  gather_facts: no
+  vars:
+    sync_dir: /sw/WAS_IMAGES/Nginx/legacy_sync
+  tasks:
+    - name: --- [Task] Planlayiciyi kopyala ---
+      ansible.builtin.copy:
+        src: files/legacy_sync_plan.py
+        dest: "{{ sync_dir }}/legacy_sync_plan.py"
+        mode: '0755'
+
+    - name: --- [Task] Plani uret ---
+      ansible.builtin.command: >-
+        python3 {{ sync_dir }}/legacy_sync_plan.py {{ sync_dir }}/raw {{ sync_dir }}/plan
+        {{ '--strict' if (strict | default(false) | bool) else '' }}
+        {{ '--fix-upstreams' if (fix_upstreams | default(false) | bool) else '' }}
+        {{ ('--group ' ~ group) if (group | default('') | length) > 0 else '' }}
+      register: plan_out
+      changed_when: false
+
+    - name: --- [Task] Ozeti ayristir ---
+      ansible.builtin.set_fact:
+        sync_summary: >-
+          {{ (plan_out.stdout_lines | select('match', '^SYNC_JSON ') | list | first | default('SYNC_JSON {}'))
+             | regex_replace('^SYNC_JSON ', '') | from_json }}
+
+    - name: --- [Task] Rapor ---
+      ansible.builtin.slurp:
+        src: "{{ sync_dir }}/plan/report.txt"
+      register: report_raw
+
+    - name: --- [Task] Plan ozeti ---
+      ansible.builtin.debug:
+        msg:
+          - "mod={{ mode | default('report') }} · gruplar={{ sync_summary.groups | default({}) }}"
+          - "aksiyonlar={{ sync_summary.by_type | default({}) }}"
+          - "degisecek sunucular={{ sync_summary.hosts_changed | default([]) }}"
+          - "rapor: {{ sync_dir }}/plan/report.txt"
+          - "{{ (report_raw.content | b64decode).split('\n')[:80] }}"
+
+- name: "--- [Play] Legacy sync - uygula ---"
+  hosts: >-
+    {{ target_hosts | default('GBRVPP01,GBRVPP02,GBRVPAP01,GBRVPAP02,GBRVPP07,GBRVPP08,GBRVPP09,GBRVPP10,GBRVPAP03,GBRVPAP04,GBRVPAP05,GBRVPAP06') }}
+  gather_facts: no
+  ignore_unreachable: true
+  vars:
+    sync_dir: /sw/WAS_IMAGES/Nginx/legacy_sync
+  tasks:
+    - name: --- [Task] Rapor modunda uygulama yok ---
+      ansible.builtin.meta: end_host
+      when: (mode | default('report') | lower) != 'apply'
+
+    - name: --- [Task] Bu sunucunun planini oku ---
+      ansible.builtin.slurp:
+        src: "{{ sync_dir }}/plan/{{ inventory_hostname }}.json"
+      register: plan_raw
+      delegate_to: GBLABT02
+      failed_when: false
+
+    - name: --- [Task] Plan yoksa bu sunucu atlanir ---
+      ansible.builtin.meta: end_host
+      when: plan_raw.content is not defined
+
+    - name: --- [Task] Plani coz ---
+      ansible.builtin.set_fact:
+        host_plan: "{{ plan_raw.content | b64decode | from_json }}"
+
+    - name: --- [Task] Degisecek dosya yoksa bitir ---
+      ansible.builtin.debug:
+        msg: "{{ inventory_hostname }}: plan degisiklik icermiyor"
+      when: (host_plan.files | default([]) | length) == 0
+
+    - name: --- [Task] Degisecek dosya yoksa bu sunucu atlanir ---
+      ansible.builtin.meta: end_host
+      when: (host_plan.files | default([]) | length) == 0
+
+    # YEDEK: copy backup:yes yedek yolunu doner; nginx -t duserse bu yollardan geri alinir.
+    - name: --- [Task] Dosyalari yaz (yedekli) ---
+      become: true
+      become_method: dzdo
+      become_user: www
+      ansible.builtin.copy:
+        content: "{{ item.content }}"
+        dest: "{{ item.path }}"
+        backup: yes
+        mode: '0644'
+      loop: "{{ host_plan.files }}"
+      loop_control:
+        label: "{{ item.path }}"
+      register: written
+
+    - name: --- [Task] nginx -t ---
+      become: true
+      become_method: dzdo
+      become_user: www
+      ansible.builtin.script:
+        cmd: files/nginx_test_or_reload.sh test
+      register: ngx_test
+      failed_when: false
+      changed_when: false
+
+    - name: --- [Task] nginx -t DUSTU -> geri al (rollback) ---
+      become: true
+      become_method: dzdo
+      become_user: www
+      ansible.builtin.copy:
+        src: "{{ item.backup_file }}"
+        dest: "{{ item.dest }}"
+        remote_src: yes
+        mode: '0644'
+      loop: "{{ written.results | selectattr('backup_file', 'defined') | list }}"
+      loop_control:
+        label: "{{ item.dest }}"
+      when: ngx_test.rc != 0
+
+    - name: --- [Task] Geri alindi, host FAIL ---
+      ansible.builtin.fail:
+        msg: "{{ inventory_hostname }}: nginx -t dustu, {{ written.results | length }} dosya yedekten geri alindi: {{ ((ngx_test.stdout_lines | default([])) + (ngx_test.stderr_lines | default([]))) | join(' / ') | truncate(600) }}"
+      when: ngx_test.rc != 0
+
+    - name: --- [Task] nginx reload ---
+      become: true
+      become_method: dzdo
+      become_user: www
+      ansible.builtin.script:
+        cmd: files/nginx_test_or_reload.sh reload
+      register: ngx_reload
+      changed_when: true
+
+    - name: --- [Task] Sonuc ---
+      ansible.builtin.debug:
+        msg: "{{ inventory_hostname }}: {{ host_plan.files | length }} dosya yazildi, nginx -t gecti, reload yapildi · {{ host_plan.actions | length }} aksiyon ({{ host_plan.actions | map(attribute='action') | unique | join(', ') }})"
diff --git a/bmw_nginx/tests/check_legacy_sync.py b/bmw_nginx/tests/check_legacy_sync.py
new file mode 100644
index 000000000..bf648b4e0
--- /dev/null
+++ b/bmw_nginx/tests/check_legacy_sync.py
@@ -0,0 +1,220 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""nginx_legacy_sync: eski tip prod sunuculari eslenik grup icinde esitleme PLANI.
+
+Kilitlenen iddialar (planlayici GERCEKTEN kosturulur; dump betigi Git Bash ile):
+  1. FQDN proxy_pass -> upstream adi (ilk etiket); eksik proxy_ssl_name / Host eklenir;
+     mevcut olanlar tekrar eklenmez; IP ve $degisken hedefe dokunulmaz
+  2. kullanilan ama tanimsiz upstream: sablonla (resolve/keepalive/zone) -upstreams.conf
+     BASINA; -upstreams.conf yoksa vhost dosyasinin basina; ayni ad baska hedefe -> CONFLICT
+  3. eslenikte olup bu sunucuda olmayan location: cogunluk surumu error_page ONUNE;
+     eksik upstream eslenikten kopyalanir; hicbir sey silinmez
+  4. govdesi farkli location: DIFF (dokunulmaz); --strict ile cogunluk surumu
+  5. cipla ad + tanimsiz + basliksiz -> UNDEFINED_TARGET (degisiklik yok)
+  6. --fix-upstreams: eksik resolve/keepalive/zone tamamlanir; kapaliyken dokunulmaz
+  7. plan JSON'da yalniz DEGISEN dosyalar, tam yol; ikinci planlama (plan cikti girdi
+     olunca) sifir degisiklik (idempotent)
+  8. playbook: gruplar planlayici ile AYNI, dump betigi files/ altindan, apply yedek +
+     nginx -t + geri alma
+"""
+import io
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+D = os.path.join(os.path.dirname(HERE), "nginx_legacy_sync")
+PLAN = os.path.join(D, "files", "legacy_sync_plan.py")
+DUMP = os.path.join(D, "files", "legacy_sync_dump.sh")
+PB = os.path.join(D, "nginx_legacy_sync.yml")
+problems = []
+
+LOC = """    location %(path)s {
+        proxy_pass      %(pp)s;
+        include /usr/nginx/conf/proxy_settings.conf;
+        rewrite ^%(path)s(.*)$ /$1 break;
+%(extra)s    }
+"""
+SSL = "        proxy_ssl_name %s;\n        proxy_set_header Host %s;\n"
+
+
+def vhost(locs, extra_top=""):
+    return (extra_top + "server {\n    listen 443 ssl;\n    server_name webforms.garanti.com.tr;\n\n"
+            + "".join(locs) + "\n    error_page 404 /404.html;\n    location = /404.html { root html; }\n}\n")
+
+
+UPS_OK = "upstream ok-app-v0-ok-ns {\n  server ok-app-v0-ok-ns.apps.fw.garanti.com.tr:443 resolve;\n  keepalive 10;\n  zone upstream_dynamic 4m;\n}\n"
+UPS_OLD = "upstream old-app-v0-ns {\n  server old-app-v0-ns.apps.fw.garanti.com.tr:443;\n}\n"
+UPS_ONLY2 = "upstream only2-app-v0-ns {\n  server only2-app-v0-ns.apps.fw.garanti.com.tr:443 resolve;\n  keepalive 10;\n  zone upstream_dynamic 4m;\n}\n"
+UPS_CONFLICT = "upstream conf-app-v0-ns {\n  server conf-app-v0-ns.apps.fw.garanti.com.tr:443 resolve;\n}\n"
+
+# Host 1: FQDN'li location (ssl_name yok), cipla-tanimsiz (basliktan cozulur), IP, upstream OK,
+#         old-app resolve'suz, cipla-tanimsiz-basliksiz, CONFLICT adayi, ortak location
+h1_locs = [
+    LOC % dict(path="/fq/", pp="https://fq-app-v0-ns.apps.fw.garanti.com.tr/", extra=""),
+    LOC % dict(path="/bare/", pp="https://bare-app-v0-ns/", extra=SSL % ("bare-app-v0-ns.apps.fw.garanti.com.tr", "bare-app-v0-ns.apps.fw.garanti.com.tr")),
+    LOC % dict(path="/ip/", pp="https://10.1.2.3:8443/", extra=""),
+    LOC % dict(path="/ok/", pp="https://ok-app-v0-ok-ns/", extra=SSL % ("ok-app-v0-ok-ns.apps.fw.garanti.com.tr", "ok-app-v0-ok-ns.apps.fw.garanti.com.tr")),
+    LOC % dict(path="/old/", pp="https://old-app-v0-ns/", extra=""),
+    LOC % dict(path="/undef/", pp="https://undef-app-v0-ns/", extra=""),
+    LOC % dict(path="/conf/", pp="https://conf-app-v0-ns.apps-t.fw.garanti.com.tr/", extra=""),
+    LOC % dict(path="/common/", pp="https://ok-app-v0-ok-ns/", extra="        proxy_read_timeout 60s;\n"),
+]
+# Host 2: /fq/ ZATEN upstream + ssl basliklari var, /only2/ yalniz burada, /common/ farkli govde,
+#         /bare/ /ip/ /ok/ /old/ /undef/ /conf/ yok (eslenikten gelecek)
+h2_locs = [
+    LOC % dict(path="/fq/", pp="https://fq-app-v0-ns/", extra=SSL % ("fq-app-v0-ns.apps.fw.garanti.com.tr", "fq-app-v0-ns.apps.fw.garanti.com.tr")),
+    LOC % dict(path="/only2/", pp="https://only2-app-v0-ns/", extra=SSL % ("only2-app-v0-ns.apps.fw.garanti.com.tr", "only2-app-v0-ns.apps.fw.garanti.com.tr")),
+    LOC % dict(path="/common/", pp="https://ok-app-v0-ok-ns/", extra="        proxy_read_timeout 20s;\n"),
+]
+H1 = {"WEBFORMS-PROD.conf": vhost(h1_locs), "webforms-prod-upstreams.conf": UPS_OK + UPS_OLD + UPS_CONFLICT}
+H2 = {"WEBFORMS-PROD.conf": vhost(h2_locs), "webforms-prod-upstreams.conf": UPS_OK + UPS_ONLY2 + UPS_OLD}
+
+
+def write_raw(raw, host, files):
+    with io.open(os.path.join(raw, host + ".txt"), "w", newline="\n", encoding="utf-8") as f:
+        for n, body in files.items():
+            f.write("###FILE_BEGIN:%s\n%s%s###FILE_END\n" % (n, body, "" if body.endswith("\n") else "\n"))
+
+
+def run_plan(raw, plan, *args):
+    r = subprocess.run([sys.executable, PLAN, raw, plan] + list(args), capture_output=True, text=True, encoding="utf-8")
+    if r.returncode != 0:
+        problems.append("planlayici dustu (%s): %s" % (args, r.stderr[-800:]))
+    return r
+
+
+def load(plan, host):
+    return json.load(io.open(os.path.join(plan, host + ".json"), encoding="utf-8"))
+
+
+tmp = tempfile.mkdtemp(prefix="lsync-")
+raw = os.path.join(tmp, "raw"); plan = os.path.join(tmp, "plan"); os.makedirs(raw)
+write_raw(raw, "GBRVPP01", H1); write_raw(raw, "GBRVPP02", H2)
+r = run_plan(raw, plan)
+p1 = load(plan, "GBRVPP01"); p2 = load(plan, "GBRVPP02")
+acts1 = {(a["action"], a["detail"]) for a in p1["actions"]}
+acts2 = {(a["action"], a["detail"]) for a in p2["actions"]}
+f1 = {os.path.basename(f["path"]): f["content"] for f in p1["files"]}
+f2 = {os.path.basename(f["path"]): f["content"] for f in p2["files"]}
+v1 = f1.get("WEBFORMS-PROD.conf", ""); u1 = f1.get("webforms-prod-upstreams.conf", "")
+v2 = f2.get("WEBFORMS-PROD.conf", ""); u2 = f2.get("webforms-prod-upstreams.conf", "")
+
+# 1
+if "proxy_pass      https://fq-app-v0-ns/;" not in v1:
+    problems.append("1: FQDN proxy_pass upstream adina cevrilmedi")
+if not re.search(r"proxy_pass      https://fq-app-v0-ns/;\n\s+proxy_ssl_name fq-app-v0-ns\.apps\.fw\.garanti\.com\.tr;\n\s+proxy_set_header Host fq-app-v0-ns\.apps\.fw\.garanti\.com\.tr;", v1):
+    problems.append("1: eksik proxy_ssl_name/Host proxy_pass altina eklenmedi")
+if v1.count("proxy_ssl_name bare-app-v0-ns.apps.fw.garanti.com.tr;") != 1:
+    problems.append("1: mevcut ssl_name tekrar eklendi")
+if "https://10.1.2.3:8443/" not in v1:
+    problems.append("1: IP hedefe dokunuldu")
+if not any(a[0] == "REWRITE_PROXY_PASS" for a in acts1):
+    problems.append("1: REWRITE_PROXY_PASS aksiyonu yok")
+# 2
+if not u1.startswith("upstream "):
+    problems.append("2: upstream dosyasi basina eklenmedi:\n" + u1[:200])
+for name in ("fq-app-v0-ns", "bare-app-v0-ns"):
+    if not re.search(r"upstream %s \{\n  server %s\.apps\.fw\.garanti\.com\.tr:443 resolve;\n  keepalive 10;\n  zone upstream_dynamic 4m;\n\}" % (name, name), u1):
+        problems.append("2: %s icin sablonla upstream uretilmedi" % name)
+if u1.count("upstream ok-app-v0-ok-ns {") != 1:
+    problems.append("2: var olan upstream tekrar eklendi")
+if not any(a[0] == "CONFLICT" and "conf-app-v0-ns" in a[1] for a in acts1):
+    problems.append("2: farkli hedefe giden ayni adli upstream CONFLICT vermedi")
+if "https://conf-app-v0-ns.apps-t.fw.garanti.com.tr/" not in v1:
+    problems.append("2: CONFLICT'e ragmen proxy_pass degistirildi")
+# 3
+for path in ("/bare/", "/ip/", "/ok/", "/old/", "/undef/", "/conf/"):
+    if ("location %s {" % path) not in v2:
+        problems.append("3: eslenikteki %s GBRVPP02'ye eklenmedi" % path)
+if "location /only2/ {" not in v1:
+    problems.append("3: /only2/ GBRVPP01'e eklenmedi")
+if v2 and v2.index("location /bare/ {") > v2.index("error_page"):
+    problems.append("3: eklenen location error_page capasindan SONRA")
+if "upstream only2-app-v0-ns {" not in u1:
+    problems.append("3: eksik upstream eslenikten kopyalanmadi")
+if "upstream conf-app-v0-ns {" not in u2:
+    problems.append("3: eslenikteki upstream (conflict adli olsa da tanimli) GBRVPP02'ye kopyalanmadi")
+# eklenen /fq/ GBRVPP02'de zaten var: tekrar eklenmemeli; GBRVPP02'de /bare/ ssl basliklari korunmus
+if v2.count("location /fq/ {") != 1:
+    problems.append("3: /fq/ GBRVPP02'de coklandi")
+if len(re.findall(r"location /", v2)) != len(re.findall(r"location /", v1)):
+    problems.append("3: iki sunucunun location sayisi esit degil (%d vs %d)" % (len(re.findall(r"location /", v1)), len(re.findall(r"location /", v2))))
+# 4
+if not any(a[0] == "DIFF_LOCATION" and "/common/" in a[1] for a in acts1 | acts2):
+    problems.append("4: govdesi farkli /common/ DIFF_LOCATION vermedi")
+if "proxy_read_timeout 60s;" not in v1 or "proxy_read_timeout 20s;" not in v2:
+    problems.append("4: strict olmadan farkli govde degistirildi")
+# 5
+if not any(a[0] == "UNDEFINED_TARGET" and "/undef/" in a[1] for a in acts1):
+    problems.append("5: tanimsiz+basliksiz hedef UNDEFINED_TARGET vermedi")
+if "upstream undef-app-v0-ns" in u1:
+    problems.append("5: FQDN bilinmeyen hedef icin upstream uydurulmus")
+# 6 (kapali): old-app resolve eklenmemis
+if "old-app-v0-ns.apps.fw.garanti.com.tr:443 resolve" in u1:
+    problems.append("6: --fix-upstreams kapaliyken resolve eklendi")
+# 7
+if any(not f["path"].startswith("/usr/nginx/conf.d/") for f in p1["files"] + p2["files"]):
+    problems.append("7: plan dosya yollari tam degil")
+raw2 = os.path.join(tmp, "raw2"); plan2 = os.path.join(tmp, "plan2"); os.makedirs(raw2)
+write_raw(raw2, "GBRVPP01", {**H1, **f1}); write_raw(raw2, "GBRVPP02", {**H2, **f2})
+r2 = run_plan(raw2, plan2)
+q1 = load(plan2, "GBRVPP01"); q2 = load(plan2, "GBRVPP02")
+if q1["files"] or q2["files"]:
+    problems.append("7: ikinci planlama yine dosya degistiriyor (idempotent degil): %s / %s"
+                    % ([a["detail"] for a in q1["actions"] if a["action"] not in ("DIFF_LOCATION", "DIFF_UPSTREAM", "UNDEFINED_TARGET", "CONFLICT")],
+                       [a["detail"] for a in q2["actions"] if a["action"] not in ("DIFF_LOCATION", "DIFF_UPSTREAM", "UNDEFINED_TARGET", "CONFLICT")]))
+# 4 strict / 6 fix
+plan3 = os.path.join(tmp, "plan3")
+run_plan(raw, plan3, "--strict", "--fix-upstreams")
+s1 = load(plan3, "GBRVPP01"); s2 = load(plan3, "GBRVPP02")
+sv1 = {os.path.basename(f["path"]): f["content"] for f in s1["files"]}
+sv2 = {os.path.basename(f["path"]): f["content"] for f in s2["files"]}
+# /common/: iki surum 1-1, esitlikte alfabetik ilk sunucu (GBRVPP01) kazanir -> GBRVPP02 degisir
