+---
+# nginx_webc_locales_backfill.yml — MEVCUT per-uygulama SPA conf'larina (application-confs/)
+# "webc_locales.json" location blogunu geriye donuk ekler (2026-09-15, tum uygulamalar
+# icin istendi). Yeni tanimlar icin ayni blok nginx_ops SPA sablonunda (configuration-
+# append-template-spa.j2); bu playbook yalnizca ESKI dosyalar icindir.
+#
+# NASIL: her dosyadaki mevcut `location = <onek>locales/locales.json {...}` blogu
+# klonlanir, yalnizca dosya adi webc_locales.json yapilir (files/webc_locales_backfill.sh).
+# Boylece CORS degisken adlari, path oneki ve Allow-Credentials satirinin varligi o
+# dosyada ne ise korunur. Idempotent: zaten olan dosyaya dokunulmaz.
+#
+# MOD (extra var `mode`): report (VARSAYILAN, hicbir sey yazmaz) | apply (yaz + nginx -t
+# + reload; -t duserse o hosttaki tum degisen dosyalar yedekten geri alinir, host fail).
+# HEDEF (extra var `target_hosts`): varsayilan tum SPA sunuculari (asagida). Once bir
+# non-prod hostta apply ile deneyin: -e "mode=apply target_hosts=GBNGXD01".
+#
+# Ayrinti: README.md "webc_locales.json" bolumu.
+
+- name: "--- webc_locales.json geriye donuk ekleme ---"
+  # SPA per-uygulama conf'u olan sunucular: internet non-prod, intranet (50'li), yeni prod SPA.
+  # Eski GBRVP* prod sunucularinda SPA dosyasi YOK (proxy_pass), kapsam disi.
+  hosts: >-
+    {{ target_hosts | default('GBNGXD01,GBNGXD02,GBNGXT33,GBNGXT34,GBNGXQ01,GBNGXQ02,GBNGXD50,GBNGXT50,GBNGXT51,GBNGXQ50,GBNGXP50,GBNGXP51,GBNGXP52,GBNGXP53,GBNGXAP50,GBNGXAP51,GBNGXP40,GBNGXP41,GBNGXP48,GBNGXP49,GBNGXAP24,GBNGXAP25,GBNGXP44,GBNGXP45,GBNGXP58,GBNGXP59,GBNGXAP28,GBNGXAP29') }}
+  gather_facts: no
+  ignore_unreachable: true
+  vars:
+    mode: report
+  tasks:
+    - name: --- [Task] Mod dogrula ---
+      ansible.builtin.assert:
+        that: (mode | lower) in ['report', 'apply']
+        fail_msg: "mode report|apply olmali (verilen: '{{ mode }}')"
+
+    - name: --- [Task] Betigi kopyala ---
+      ansible.builtin.copy:
+        src: operations/files/webc_locales_backfill.sh
+        dest: /tmp/webc_locales_backfill.sh
+        mode: '0755'
+
+    - name: "--- [Task] {{ 'UYGULA' if (mode | lower) == 'apply' else 'RAPOR' }}: application-confs tarama ---"
+      become: true
+      become_method: dzdo
+      become_user: www
+      ansible.builtin.command: /bin/bash /tmp/webc_locales_backfill.sh {{ mode | lower }}
+      register: webc
+      changed_when: (mode | lower) == 'apply' and ('RESULT\tOK' in webc.stdout)
+      failed_when: webc.rc not in [0, 3]
+
+    - name: --- [Task] Betigi temizle ---
+      ansible.builtin.file:
+        path: /tmp/webc_locales_backfill.sh
+        state: absent
+      changed_when: false
+
+    - name: --- [Task] Ozet ---
+      ansible.builtin.debug:
+        msg:
+          - "{{ inventory_hostname }} · mod={{ mode }}"
+          - "{{ (webc.stdout_lines | select('match', '^SUMMARY') | list | first | default('SUMMARY 0 0 0 0')) | regex_replace('^SUMMARY\\t(\\d+)\\t(\\d+)\\t(\\d+)\\t(\\d+)$', 'toplam \\1 dosya · eklenecek/eklenen \\2 · zaten var \\3 · locales.json blogu yok \\4') }}"
+          - "{{ (webc.stdout_lines | select('match', '^RESULT') | list | first | default('RESULT\t-\trapor modu, degisiklik yok')) | regex_replace('^RESULT\\t', '') | regex_replace('\\t', ' - ') }}"
+
+    - name: --- [Task] nginx -t dustu, geri alindi -> host FAIL ---
+      ansible.builtin.fail:
+        msg: "{{ inventory_hostname }}: {{ (webc.stdout_lines | select('match', '^RESULT') | list | first | default('')) }}"
+      when: webc.rc == 3
