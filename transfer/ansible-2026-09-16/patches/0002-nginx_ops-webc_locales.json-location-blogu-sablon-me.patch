--- /dev/null
+++ b/bmw_nginx/nginx_ops/operations/files/webc_locales_backfill.sh
@@ -0,0 +1,109 @@
+#!/bin/bash
+# webc_locales_backfill.sh - MEVCUT per-uygulama conf'larina "webc_locales.json" location
+# blogunu geriye donuk ekler (2026-09-15, tum uygulamalar icin istendi).
+#
+# YAKLASIM: sablonla yeniden uretmek YERINE dosyadaki mevcut
+#     location = <onek>locales/locales.json { ... }
+# blogu KLONLANIR ve iki yerde "locales/locales.json" -> "locales/webc_locales.json"
+# yapilir (location satiri + alias satiri). Boylece o dosyada CORS degisken adi ne ise
+# (flat/namespaced eki), Allow-Credentials satiri var mi yok mu, path oneki ne - hepsi
+# AYNEN korunur; nginx_ops sablonunun uretecegi blokla birebir ayni sonuc cikar.
+#
+# KURALLAR
+#   - Dosyada zaten "webc_locales.json" gecen bir location varsa DOKUNULMAZ (idempotent).
+#   - locales.json blogu yoksa (SPA disi / eski desen) dosya ATLANIR ve raporlanir.
+#   - Klon, orijinal blogun HEMEN ARDINA yazilir.
+#   - apply: her degisen dosyanin .webc-bak.<ts> yedegi alinir; nginx -t duserse TUM
+#     degisen dosyalar yedekten geri alinir, reload yapilmaz, cikis 3.
+#
+# KULLANIM: webc_locales_backfill.sh <report|apply> [conf_dir]
+#   report : yalnizca sayar ve listeler, hicbir sey yazmaz (varsayilan)
+#   apply  : yazar + nginx -t + reload
+#
+# CIKTI (stdout, TAB ayrilmis): SUMMARY  <toplam> <eklenecek/eklenen> <zaten var> <blok yok>
+#                                FILE     <durum>  <dosya>      (durum: ADD|HAS|NOBLOCK|ERR)
+set -u
+MODE="${1:-report}"
+CONF_DIR="${2:-/usr/nginx/conf.d/application-confs}"
+NGINX_BIN="/usr/nginx/sbin/nginx"
+TS="$(date +%Y%m%d%H%M%S)"
+
+case "$MODE" in report|apply) ;; *) echo "kullanim: $0 <report|apply> [conf_dir]" >&2; exit 2 ;; esac
+[ -d "$CONF_DIR" ] || { echo "SUMMARY	0	0	0	0"; echo "NOTE	dizin yok: $CONF_DIR"; exit 0; }
+
+# Bir dosyadan klonlanmis blogu (yalniz ekleme yapilacaksa) uretir; dosyayi DEGISTIRMEZ.
+# Cikis: 0 = klon uretildi (stdout: yeni dosya icerigi), 10 = zaten var, 11 = blok yok.
+clone_into() {
+  local f="$1"
+  grep -qE 'location[[:space:]]*=[[:space:]]*[^[:space:]{]*locales/webc_locales\.json[[:space:]]*\{' "$f" && return 10
+  grep -qE 'location[[:space:]]*=[[:space:]]*[^[:space:]{]*locales/locales\.json[[:space:]]*\{' "$f" || return 11
+  awk '
+    # Blok yakalama: location = ...locales/locales.json { ile baslar, parantez sayaci
+    # sifira dusunce biter. Blok satirlari toplanir; kapanista klon basilir.
+    function emit_clone(   i, line) {
+      for (i = 1; i <= n; i++) {
+        line = blk[i]
+        gsub(/locales\/locales\.json/, "locales/webc_locales.json", line)
+        print line
+      }
+    }
+    {
+      if (!inblk && $0 ~ /^[[:space:]]*location[[:space:]]*=[[:space:]]*[^[:space:]{]*locales\/locales\.json[[:space:]]*\{/) {
+        inblk = 1; n = 0; depth = 0
+      }
+      print $0
+      if (inblk) {
+        blk[++n] = $0
+        o = gsub(/\{/, "{"); c = gsub(/\}/, "}")
+        depth += o - c
+        if (depth <= 0 && n > 0 && (o > 0 || c > 0)) {
+          inblk = 0
+          print ""
+          emit_clone()
+        }
+      }
+    }
+  ' "$f"
+}
+
+total=0; add=0; has=0; noblock=0; failed=0
+changed_files=""
+for f in "$CONF_DIR"/*.conf; do
+  [ -f "$f" ] || continue
+  total=$((total + 1))
+  out="$(clone_into "$f")"; rc=$?
+  case "$rc" in
+    10) has=$((has + 1)); printf 'FILE\tHAS\t%s\n' "$f"; continue ;;
+    11) noblock=$((noblock + 1)); printf 'FILE\tNOBLOCK\t%s\n' "$f"; continue ;;
+    0)  ;;
+    *)  failed=$((failed + 1)); printf 'FILE\tERR\t%s\n' "$f"; continue ;;
+  esac
+  # Guvenlik: klon gercekten uretildi mi (satir sayisi artmali ve webc gecmeli)
+  if ! printf '%s\n' "$out" | grep -q 'webc_locales.json'; then
+    failed=$((failed + 1)); printf 'FILE\tERR\t%s\n' "$f"; continue
+  fi
+  add=$((add + 1)); printf 'FILE\tADD\t%s\n' "$f"
+  if [ "$MODE" = "apply" ]; then
+    cp -p "$f" "$f.webc-bak.$TS" || { failed=$((failed + 1)); continue; }
+    printf '%s\n' "$out" > "$f"
+    changed_files="$changed_files $f"
+  fi
+done
+printf 'SUMMARY\t%d\t%d\t%d\t%d\n' "$total" "$add" "$has" "$noblock"
+[ "$failed" -gt 0 ] && printf 'NOTE\t%d dosyada hata\n' "$failed"
+
+if [ "$MODE" = "apply" ] && [ -n "$changed_files" ]; then
+  if dzdo "$NGINX_BIN" -p /usr/nginx/ -c /usr/nginx/nginx.conf -e /web_log/error.log -t >/tmp/webc_nginx_t.$$ 2>&1; then
+    dzdo "$NGINX_BIN" -p /usr/nginx/ -c /usr/nginx/nginx.conf -e /web_log/error.log -s reload
+    printf 'RESULT\tOK\t%d dosya degisti, nginx -t gecti, reload yapildi\n' "$add"
+    rm -f /tmp/webc_nginx_t.$$
+    exit 0
+  else
+    # GERI AL: degisen her dosya yedekten
+    for f in $changed_files; do cp -p "$f.webc-bak.$TS" "$f"; done
+    printf 'RESULT\tROLLBACK\tnginx -t DUSTU, %d dosya yedekten geri alindi: %s\n' "$add" "$(tr '\n' ' ' < /tmp/webc_nginx_t.$$ | cut -c1-400)"
+    rm -f /tmp/webc_nginx_t.$$
+    exit 3
+  fi
+fi
+exit 0
