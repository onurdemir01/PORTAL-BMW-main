+
+def block_of(text, fname):
+    # {{ path }} (sablon) ya da /odeme/ (gercek dosya) oneki: satir sonuna kadar her sey
+    m = re.search(r"location = [^\n]*?%s \{.*?\n\}\n" % re.escape(fname), text, re.S)
