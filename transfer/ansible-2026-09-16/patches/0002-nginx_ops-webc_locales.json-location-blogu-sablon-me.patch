+t2 = io.open(os.path.join(conf, "rootrel.conf"), encoding="utf-8").read()
+if "location = /locales/webc_locales.json {" not in t2:
+    problems.append("rootrel: /locales/webc_locales.json yok")
+# [3] credentials'siz
+t3 = io.open(os.path.join(conf, "nocred.conf"), encoding="utf-8").read()
+c3 = block_of(t3, "locales/webc_locales.json")
+if not c3 or "Allow-Credentials" in c3:
