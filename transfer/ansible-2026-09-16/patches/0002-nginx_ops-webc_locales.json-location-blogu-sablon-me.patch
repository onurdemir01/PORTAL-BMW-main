@@ -0,0 +1,154 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""webc_locales_backfill.sh: mevcut per-uygulama conf'larina webc_locales.json blogu.
+
+Kilitlenen iddialar (betik GERCEKTEN kosturulur, Git Bash):
+  1. nginx_ops SPA sablonu ciktisi (namespaced, credentials'li) -> klon locales.json
+     blogunun hemen ardinda, ayni CORS degisken adi, alias yalniz dosya adi degisir.
+  2. Deployment sablonu bicimi (kok-goreli /locales/locales.json) -> /locales/webc_locales.json.
+  3. Credentials SATIRI OLMAYAN dosyada klon da credentials'siz (dosyaya sadik).
+  4. Zaten webc iceren dosya HAS, locales.json blogu olmayan dosya NOBLOCK; dokunulmaz.
+  5. report modu hicbir dosyayi degistirmez; apply degistirir, yedek birakir, idempotent.
+  6. nginx_ops sablonu (configuration-append-template-spa.j2) webc blogunu icerir ve
+     klonla AYNI satirlari uretir (iki yol tek sonuc).
+"""
+import io
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+OPS = os.path.join(os.path.dirname(HERE), "nginx_ops", "operations")
+SCRIPT = os.path.join(OPS, "files", "webc_locales_backfill.sh")
+TPL = os.path.join(OPS, "templates", "configuration-append-template-spa.j2")
+
+problems = []
+tmp = tempfile.mkdtemp(prefix="webc-")
+conf = os.path.join(tmp, "application-confs")
+os.makedirs(conf)
+
+NS_APP = """location = /odeme/locales/locales.json {
+
+  add_header Access-Control-Allow-Origin $allowed_origin_odeme_app_v1_digital_ch_test always;
+  add_header Access-Control-Max-Age $max_age_odeme_app_v1_digital_ch_test;
+  add_header Access-Control-Allow-Credentials $allowed_credentials_odeme_app_v1_digital_ch_test always;
+  add_header Access-Control-Allow-Headers $allowed_headers_odeme_app_v1_digital_ch_test always;
+  add_header Access-Control-Allow-Methods $allowed_methods_odeme_app_v1_digital_ch_test always;
+  add_header Cache-Control 'no-cache';
+  alias /usr/nginx/applications/digital-ch-test/odeme-app-v1/locales/locales.json;
+
+  if ($request_method ~* ^(OPTIONS|POST)$) {
+    return 200;
+  }
+}
+
+location /odeme/live {
+  access_log off;
+  return 200 'healthy\\n';
+}
+"""
+ROOT_REL = NS_APP.replace("/odeme/locales/locales.json", "/locales/locales.json").replace("/odeme/live", "/live")
+NO_CRED = "\n".join(l for l in NS_APP.splitlines() if "Allow-Credentials" not in l) + "\n"
+HAS = NS_APP + NS_APP.replace("locales/locales.json", "locales/webc_locales.json")
+NOBLOCK = "location /api/ {\n  proxy_pass https://x/;\n}\n"
+files = {"ns-app.conf": NS_APP, "rootrel.conf": ROOT_REL, "nocred.conf": NO_CRED, "has.conf": HAS, "proxy.conf": NOBLOCK}
+for name, body in files.items():
+    io.open(os.path.join(conf, name), "w", encoding="utf-8", newline="\n").write(body)
+
+
+def run(mode):
+    try:
+        r = subprocess.run(["bash", SCRIPT, mode, conf], capture_output=True, text=True, encoding="utf-8")
+    except FileNotFoundError:
+        print("ATLANDI: bash yok")
+        sys.exit(0)
+    rows = [l.split("\t") for l in r.stdout.splitlines() if l.strip()]
+    return r, rows
+
+
+# [5] report: dosya degismez
+before = {n: io.open(os.path.join(conf, n), encoding="utf-8").read() for n in files}
+r, rows = run("report")
+summ = [x for x in rows if x[0] == "SUMMARY"][0]
+if summ[1:] != ["5", "3", "1", "1"]:
+    problems.append("report SUMMARY: beklenen 5/3/1/1, bulunan %r" % summ[1:])
+st = {os.path.basename(x[2]): x[1] for x in rows if x[0] == "FILE"}
+if st.get("has.conf") != "HAS" or st.get("proxy.conf") != "NOBLOCK" or st.get("ns-app.conf") != "ADD":
+    problems.append("durumlar: %r" % st)
+after = {n: io.open(os.path.join(conf, n), encoding="utf-8").read() for n in files}
+if before != after:
+    problems.append("report modu dosya DEGISTIRDI")
+
+# apply (nginx yok -> -t adimi dzdo bulunamadigi icin ROLLBACK yapar; burada yalniz klonu olcmek
+# icin nginx -t oncesi hali yedekten degil, betigin urettigi icerikten kontrol ederiz)
+# Bunun icin betigi bir sahte dzdo/nginx ile kosturuyoruz.
+fake = os.path.join(tmp, "bin")
+os.makedirs(fake)
+io.open(os.path.join(fake, "dzdo"), "w", newline="\n").write("#!/bin/bash\nexit 0\n")
+os.chmod(os.path.join(fake, "dzdo"), 0o755)
+env = dict(os.environ, PATH=fake + os.pathsep + os.environ.get("PATH", ""))
+r = subprocess.run(["bash", SCRIPT, "apply", conf], capture_output=True, text=True, encoding="utf-8", env=env)
