+# [4] dokunulmayanlar
+if io.open(os.path.join(conf, "has.conf"), encoding="utf-8").read() != HAS:
+    problems.append("has.conf degistirildi")
+if io.open(os.path.join(conf, "proxy.conf"), encoding="utf-8").read() != NOBLOCK:
+    problems.append("proxy.conf degistirildi")
+# yedekler
+baks = [n for n in os.listdir(conf) if ".webc-bak." in n]
+if len(baks) != 3:
+    problems.append("yedek sayisi: beklenen 3, bulunan %d" % len(baks))
+# idempotent
+r2 = subprocess.run(["bash", SCRIPT, "apply", conf], capture_output=True, text=True, encoding="utf-8", env=env)
+s2 = [l.split("\t") for l in r2.stdout.splitlines() if l.startswith("SUMMARY")][0]
+if s2[2] != "0":
+    problems.append("ikinci apply yeniden ekledi (idempotent degil): %r" % s2)
+
+# [6] nginx_ops sablonu: webc blogu var ve locales.json bloguyla yalniz dosya adi farki
+tpl = io.open(TPL, encoding="utf-8").read()
+tb = block_of(tpl, "locales/locales.json"); wb = block_of(tpl, "locales/webc_locales.json")
