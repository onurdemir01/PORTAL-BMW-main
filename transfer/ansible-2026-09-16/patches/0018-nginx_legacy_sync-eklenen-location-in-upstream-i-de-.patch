+                svc = service_of(fname)
+                union[svc][u["name"]] = union[svc].get(u["name"], []) + [(h.name, norm_block(u["text"]), u["text"], u)]
     if do_ups:
-        for h in hosts:
-            for fname, lines in h.files.items():
-                for u in parse_upstreams(lines):
-                    svc = service_of(fname)
-                    union[svc][u["name"]] = union[svc].get(u["name"], []) + [(h.name, norm_block(u["text"]), u["text"], u)]
         # servis eslemesi: vhost dosyasi glomo -> upstream dosyasi glomo-prod-upstreams
         for h in hosts:
             idx = h.upstream_index()
@@ -558,6 +584,12 @@ def plan_group(gname, hosts, strict=False, fix_upstreams=False, scope="all", fmt
                         continue
                     srv = srvs[si]
                     if h.name not in present:
+                        # job_3320890 dersi: eklenen blogun proxy_pass'i bu sunucuda TANIMSIZ bir
+                        # upstream'e gidiyorsa nginx -t "host not found in upstream" ile duser.
+                        # Once upstream getirilir (eslenikten; yoksa bloktaki FQDN'den sablonla);
