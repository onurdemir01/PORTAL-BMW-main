+# 15) job_3320890: scope=locations ile eklenen blogun upstream'i eslenikten gelir; hicbir
+#     yerde yoksa ve blokta FQDN yoksa location EKLENMEZ (nginx -t dusmesin)
+plan8 = os.path.join(tmp, "plan8")
+run_plan(raw, plan8, "--scope", "locations", "--hosts", "GBRVPP01,GBRVPP02")
+l8 = load(plan8, "GBRVPP01"); l8f = {os.path.basename(f["path"]): f["content"] for f in l8["files"]}
+if "location /only2/ {" in l8f.get("WEBFORMS-PROD.conf", "") and "upstream only2-app-v0-ns {" not in l8f.get("webforms-prod-upstreams.conf", ""):
+    problems.append("15: scope=locations /only2/ eklendi ama upstream'i eslenikten getirilmedi (nginx -t duser)")
+l8b = load(plan8, "GBRVPP02"); l8bf = {os.path.basename(f["path"]): f["content"] for f in l8b["files"]}
+# /undef/ (upstream hicbir yerde yok, FQDN yok) GBRVPP02'ye EKLENMEMELI
+if "location /undef/ {" in l8bf.get("WEBFORMS-PROD.conf", ""):
+    problems.append("15: upstream'i getirilemeyen /undef/ location'i yine de eklendi")
+if not any(a["action"] == "SKIP_LOCATION_NO_UPSTREAM" for a in l8b["actions"]):
+    problems.append("15: SKIP_LOCATION_NO_UPSTREAM raporlanmadi")
+# /bare/ (upstream yok ama blokta ssl_name var) -> sablonla upstream + location
+if "location /bare/ {" not in l8bf.get("WEBFORMS-PROD.conf", "") or "upstream bare-app-v0-ns {" not in l8bf.get("webforms-prod-upstreams.conf", ""):
+    problems.append("15: FQDN'i bloktan bilinen /bare/ icin upstream sablonla uretilip location eklenmeliydi")
