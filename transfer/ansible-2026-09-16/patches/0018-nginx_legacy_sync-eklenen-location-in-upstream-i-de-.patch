 import io
 import json
@@ -389,6 +390,31 @@ def majority(versions):
     return versions[0][1], versions[0][2]
 
 
+def ensure_upstream_for_block(h, service, block_lines, union, key):
+    """Eklenecek location blogunun proxy_pass hedefi cipla bir ad ise, o upstream bu
+    sunucuda tanimli olmali. Yoksa: eslenik birlesiminden (cogunluk/referans) kopyala;
+    o da yoksa bloktaki proxy_ssl_name / Host basligindan sablonla uret; hicbiri yoksa
+    False (location eklenmez, SKIP_LOCATION_NO_UPSTREAM)."""
+    info = block_info(block_lines, 0, len(block_lines))
+    if info["proxy_idx"] is None:
+        return True
+    target = info["host"].split(":")[0]
+    if IP_RE.match(target) or "$" in target or FQDN_RE.match(target):
+        return True   # dogrudan adres: upstream gerekmez
+    if target in h.upstream_index():
+        return True
+    versions = union.get(service, {}).get(target, [])
+    if versions:
+        n, raw = majority([(v[0], v[1], v[2]) for v in versions])
+        return h.add_upstream(service, target, raw, "eslenikten, location %s icin (%s)" % (key, ",".join(sorted({v[0] for v in versions}))))
+    fqdn = info["ssl_name"] or info["host_hdr"]
+    if fqdn:
+        text = UPSTREAM_TEMPLATE.format(name=target, fqdn=fqdn).split("\n")
+        return h.add_upstream(service, target, text, "yeni tanim, location %s icin, hedef %s" % (key, fqdn))
+    h.act("SKIP_LOCATION_NO_UPSTREAM", service, "location %s EKLENMEDI: upstream %s hicbir sunucuda tanimli degil, blokta FQDN de yok" % (key, target))
+    return False
+
+
 def plan_group(gname, hosts, strict=False, fix_upstreams=False, scope="all", fmt=False):
     """hosts: [Host]. Dosyalari yerinde degistirir, aksiyonlari toplar."""
     # KAPSAM (--scope): upstreams = yalniz asama 1-2 (FQDN->upstream, eksik upstream tanimi);
@@ -465,12 +491,12 @@ def plan_group(gname, hosts, strict=False, fix_upstreams=False, scope="all", fmt
 
     # --- 2) upstream birlesimi (grup) + ihtiyac duyulanlar
     union = defaultdict(dict)    # service -> name -> [(host, norm, raw)]
+    for h in hosts:
+        for fname, lines in h.files.items():
